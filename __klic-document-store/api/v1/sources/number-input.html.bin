<!-- KLIC 사이트의 HTML 데모: Number Input -->
<!-- 전체 데모는 브라우저의 native API와 app.js를 사용합니다. -->
<div data-klic-component="number-input" class="kn-number-input">
<label for="klic-example-quantity" data-part="label">참여 인원</label>
<div data-part="number-input">
<button type="button" data-cmp-action="decrement" aria-label="인원 줄이기" data-part="btn" class="kv-neutral kv-sm">−</button>
<input id="klic-example-quantity" type="number" min="1" max="20" value="4" data-number data-part="input">
<button type="button" data-cmp-action="increment" aria-label="인원 늘리기" data-part="btn" class="kv-neutral kv-sm">+</button>
</div>
<p data-part="hint">최소 1명 · 최대 20명</p>
</div>

<style>
/* 기준 프로필 A의 높이: 2rem (root 16px일 때 32px) */
:root {
  --klic-component-button-size-default-height: 2rem;
  --klic-component-input-size-default-height: 2rem;
  --klic-semantic-color-accent: #245fc2;
}
:is(.kn-btn,[data-part~="btn"]) {
  min-height: var(--klic-component-button-size-default-height);
  padding: .35rem .7rem;
  border-radius: .3125rem;
  border: 1px solid transparent;
  background: var(--klic-semantic-color-accent);
  color: white;
  font: inherit;
}
</style>

<!-- 완전한 스타일: ./styles.css + ./brand.css
     확장 컴포넌트: ./component-expansion.mjs + ./component-expansion.css
     확장 동작: ./component-interactions.mjs의 initComponentInteractions()
     아이콘: ./lucide.min.js (ISC)
     상호작용: ./app.js
     이 코드는 별도 npm 패키지가 아닌 이 사이트의 예제입니다. -->
