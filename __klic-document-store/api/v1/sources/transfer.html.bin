<!-- KLIC 사이트의 HTML 데모: Transfer -->
<!-- 전체 데모는 브라우저의 native API와 app.js를 사용합니다. -->
<div data-klic-component="transfer" class="kn-transfer">
<div data-part="transfer">
<fieldset data-transfer-list="left">
<legend>전체 팀</legend>
<label>
<input type="checkbox" value="디자인" data-part="checkbox"> 디자인</label>
<label>
<input type="checkbox" value="개발" data-part="checkbox"> 개발</label>
<label>
<input type="checkbox" value="운영" data-part="checkbox"> 운영</label>
</fieldset>
<div>
<button type="button" data-cmp-action="transfer" data-direction="right" aria-label="선택 팀 추가" data-part="btn" class="kv-neutral kv-sm">→</button>
<button type="button" data-cmp-action="transfer" data-direction="left" aria-label="선택 팀 제외" data-part="btn" class="kv-neutral kv-sm">←</button>
</div>
<fieldset data-transfer-list="right">
<legend>참여 팀</legend>
<label>
<input type="checkbox" value="기획" data-part="checkbox"> 기획</label>
</fieldset>
</div>
<p data-cmp-status role="status" aria-live="polite" data-part="status">
</p>
</div>

<style>
/* 기준 프로필 A의 높이: 2rem (root 16px일 때 32px) */
:root {
  --klic-component-button-size-default-height: 2rem;
  --klic-component-input-size-default-height: 2rem;
  --klic-semantic-color-accent: #245fc2;
}
:is(.kn-btn,[data-part~="btn"]) {
  min-height: var(--klic-component-button-size-default-height);
  padding: .35rem .7rem;
  border-radius: .3125rem;
  border: 1px solid transparent;
  background: var(--klic-semantic-color-accent);
  color: white;
  font: inherit;
}
</style>

<!-- 완전한 스타일: ./styles.css + ./brand.css
     확장 컴포넌트: ./component-expansion.mjs + ./component-expansion.css
     확장 동작: ./component-interactions.mjs의 initComponentInteractions()
     아이콘: ./lucide.min.js (ISC)
     상호작용: ./app.js
     이 코드는 별도 npm 패키지가 아닌 이 사이트의 예제입니다. -->
