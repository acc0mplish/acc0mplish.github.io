<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="avatar-group" class="kn-avatar-group"><div role="group" aria-label="프로젝트 참여자" data-part="avatar-group"><span role="img" aria-label="김하늘 · 생성한 가상 인물 프로필" title="김하늘" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:60% 40%" data-part="person-avatar root-person has-photo">하늘</span><span role="img" aria-label="이지원 · 생성한 가상 인물 프로필" title="이지원" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:100% 40%" data-part="person-avatar root-person has-photo">지원</span><span role="img" aria-label="박선준 · 생성한 가상 인물 프로필" title="박선준" style="background-image:url('./block-runtime/portraits/team-atlas-b.png');background-size:600% 600%;background-position:40% 0%" data-part="person-avatar root-person has-photo">선준</span><span role="img" aria-label="한소윤 · 생성한 가상 인물 프로필" title="한소윤" style="background-image:url('./block-runtime/portraits/team-atlas-a.png');background-size:600% 600%;background-position:60% 0%" data-part="person-avatar root-person has-photo">소윤</span><span>+8</span></div><p data-part="hint">디자인 시스템 팀 · 12명 참여</p></div>
