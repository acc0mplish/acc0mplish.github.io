<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/avatar-group-count-icon.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="avatar-group" data-kv-variant="invite" data-klic-component="avatar-group" class="kn-avatar-group"><div data-part="avatar-stack"><span aria-label="김" data-part="avatar">김</span><span aria-label="이" data-part="avatar">이</span><span aria-label="박" data-part="avatar">박</span></div><form data-kv-form><label data-part="field"><span>초대 이메일</span><input type="email" value="" required placeholder="name@company.com" data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">멤버 초대 준비</button><output aria-live="polite" data-part="output"></output></form></div>
