<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/code-block-tabs.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="code-block" data-kv-variant="language-tabs" data-klic-component="code-block" class="kn-code-block"><div data-part="tabs"><div role="tablist" aria-label="보기" ><button type="button" role="tab" id="kv-export-code-block-code-block-language-tabs-tab-0" aria-controls="kv-export-code-block-code-block-language-tabs-panel-0" aria-selected="true" tabindex="0" data-kv-action="tab" data-part="btn">HTML</button><button type="button" role="tab" id="kv-export-code-block-code-block-language-tabs-tab-1" aria-controls="kv-export-code-block-code-block-language-tabs-panel-1" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">CSS</button></div><section role="tabpanel" id="kv-export-code-block-code-block-language-tabs-panel-0" aria-labelledby="kv-export-code-block-code-block-language-tabs-tab-0" ><pre data-part="code"><code>&lt;button class="kn-btn kv-primary"&gt;저장&lt;/button&gt;</code></pre></section><section role="tabpanel" id="kv-export-code-block-code-block-language-tabs-panel-1" aria-labelledby="kv-export-code-block-code-block-language-tabs-tab-1" hidden><pre data-part="code"><code>:is(.kn-btn,[data-part~="btn"]) {
  color: white;
  background: var(--klic-semantic-color-accent);
}</code></pre></section></div></div>
