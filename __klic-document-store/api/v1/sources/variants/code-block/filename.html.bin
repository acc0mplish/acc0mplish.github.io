<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/code-block-floating-actions.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="code-block" data-kv-variant="filename" data-klic-component="code-block" class="kn-code-block"><div class="ku-row" data-part="row"><span><strong>button.html</strong></span><span><button type="button" data-klic-surface="control" data-kv-action="copy-code"  data-part="btn">코드 복사</button></span></div><pre data-part="code"><code>&lt;button type="button" class="kn-btn kv-primary"&gt;
  변경 사항 저장
&lt;/button&gt;</code></pre></div>
