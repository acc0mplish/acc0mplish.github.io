<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/context-menu-checkboxes.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="context-menu" data-kv-variant="view" data-klic-component="context-menu" class="kn-context-menu"><div data-kv-context tabindex="0" aria-label="목록 보기 컨텍스트 영역" data-kv-menu-id="kv-export-context-menu-context-menu-view-context" data-part="context-zone"><i data-part="icon" data-lucide="mouse-pointer-2" aria-hidden="true"></i><header data-part="heading"><strong>목록 보기</strong><p data-part="muted">마우스 오른쪽 버튼 · Shift + F10 · 아래 버튼</p></header><button type="button" data-klic-surface="control" data-kv-action="context-open" aria-haspopup="menu" aria-controls="kv-export-context-menu-context-menu-view-context" data-part="btn">작업 메뉴 열기</button><div data-klic-surface="overlay" id="kv-export-context-menu-context-menu-view-context" role="menu" aria-label="목록 보기 작업" data-kv-context-menu popover="manual" hidden data-part="context-menu" data-state="closed"><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">담당자 표시</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">수정일 표시</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">상태 표시</button></div></div><output aria-live="polite" data-part="output"></output></div>
