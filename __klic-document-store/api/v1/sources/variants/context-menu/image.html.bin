<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/context-menu-shortcuts.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="context-menu" data-kv-variant="image" data-klic-component="context-menu" class="kn-context-menu"><div role="img" aria-label="공유할 아이디어" data-part="art"><span>KLIC</span><strong>공유할 아이디어</strong><span data-part="art-orbit"></span></div><div data-kv-context tabindex="0" aria-label="프로젝트 커버 컨텍스트 영역" data-kv-menu-id="kv-export-context-menu-context-menu-image-context" data-part="context-zone"><i data-part="icon" data-lucide="mouse-pointer-2" aria-hidden="true"></i><header data-part="heading"><strong>프로젝트 커버</strong><p data-part="muted">마우스 오른쪽 버튼 · Shift + F10 · 아래 버튼</p></header><button type="button" data-klic-surface="control" data-kv-action="context-open" aria-haspopup="menu" aria-controls="kv-export-context-menu-context-menu-image-context" data-part="btn">작업 메뉴 열기</button><div data-klic-surface="overlay" id="kv-export-context-menu-context-menu-image-context" role="menu" aria-label="프로젝트 커버 작업" data-kv-context-menu popover="manual" hidden data-part="context-menu" data-state="closed"><button type="button" role="menuitem" data-kv-action="copy-text" data-kv-value="KLIC 프로젝트 커버: 공유할 아이디어" data-part="btn">이미지 설명 복사</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">커버 교체 준비</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">자료에 보관</button></div></div><output aria-live="polite" data-part="output"></output></div>
