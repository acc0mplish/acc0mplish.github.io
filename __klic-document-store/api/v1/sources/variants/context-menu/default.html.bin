<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="context-menu" class="kn-context-menu"><div data-context-target="export-context-menu-default-popup" data-part="context-target"><i data-part="icon" data-lucide="file-text" aria-hidden="true"></i> 프로젝트 제안서.pdf</div><button type="button" popovertarget="export-context-menu-default-popup" data-part="btn" class="kv-neutral kv-sm">파일 메뉴 <i data-part="icon" data-lucide="chevron-down" aria-hidden="true"></i></button><div popover="auto" id="export-context-menu-default-popup" data-part="popover" data-state="closed"><button type="button" data-cmp-action="menu-choice" data-name="이름 변경" data-part="btn" class="kv-neutral kv-sm">이름 변경</button><button type="button" data-cmp-action="menu-choice" data-name="복제하기" data-part="btn" class="kv-neutral kv-sm">복제하기</button><button type="button" data-cmp-action="menu-choice" data-name="링크 확인" data-part="btn" class="kv-neutral kv-sm">링크 확인</button></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
