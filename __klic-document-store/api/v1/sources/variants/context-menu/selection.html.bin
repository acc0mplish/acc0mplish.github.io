<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/context-menu-submenu.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="context-menu" data-kv-variant="selection" data-klic-component="context-menu" class="kn-context-menu"><div data-kv-context tabindex="0" aria-label="작업 3개 선택됨 컨텍스트 영역" data-kv-menu-id="kv-export-context-menu-context-menu-selection-context" data-part="context-zone"><i data-part="icon" data-lucide="mouse-pointer-2" aria-hidden="true"></i><header data-part="heading"><strong>작업 3개 선택됨</strong><p data-part="muted">마우스 오른쪽 버튼 · Shift + F10 · 아래 버튼</p></header><button type="button" data-klic-surface="control" data-kv-action="context-open" aria-haspopup="menu" aria-controls="kv-export-context-menu-context-menu-selection-context" data-part="btn">작업 메뉴 열기</button><div data-klic-surface="overlay" id="kv-export-context-menu-context-menu-selection-context" role="menu" aria-label="작업 3개 선택됨 작업" data-kv-context-menu popover="manual" hidden data-part="context-menu" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">선택 항목 담당자 지정</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">선택 항목 완료</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">선택 항목 보관</button></div></div><output aria-live="polite" data-part="output"></output></div>
