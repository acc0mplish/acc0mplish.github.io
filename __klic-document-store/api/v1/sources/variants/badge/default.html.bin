<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="badge" class="kn-badge"><span data-part="badge"><i data-part="icon" data-lucide="circle-check"></i> 완료</span><span class="kv-warning" data-part="badge">진행 중</span><span class="kv-neutral" data-part="badge">대기</span><span class="kv-primary" data-part="badge"><i data-part="icon" data-lucide="sparkles"></i> 새로운 기능</span><span class="kv-danger" data-part="badge">검토 필요</span><span class="kv-outline" data-part="badge">디자인 시스템</span></div>
