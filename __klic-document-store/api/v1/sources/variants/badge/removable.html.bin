<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/combobox-multiple.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="badge" data-kv-variant="removable" data-klic-component="badge" class="kn-badge"><header data-part="heading"><strong>적용된 필터</strong></header><div data-part="tags"><span data-part="chip">디자인 팀<button type="button" data-klic-surface="control" data-kv-action="remove" aria-label="디자인 팀 필터 해제" data-part="btn">×</button></span><span data-part="chip">이번 주<button type="button" data-klic-surface="control" data-kv-action="remove" aria-label="이번 주 필터 해제" data-part="btn">×</button></span><span data-part="chip">진행 중<button type="button" data-klic-surface="control" data-kv-action="remove" aria-label="진행 중 필터 해제" data-part="btn">×</button></span></div><p data-part="muted">각 태그의 닫기 버튼으로 조건을 제거하세요.</p></div>
