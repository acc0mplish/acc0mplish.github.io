<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-basic.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="alert" data-kv-variant="success-summary" data-klic-component="alert" class="kn-alert"><section data-part="message"><i data-part="icon" data-lucide="circle-check" aria-hidden="true"></i><div><header data-part="heading"><strong>변경 사항을 저장했습니다</strong><p data-part="muted">프로필과 알림 설정이 업데이트되었습니다.</p></header><div class="ku-row" data-part="row"><span>저장 시각</span><span>방금 전</span></div><button type="button" data-klic-surface="control" data-kv-action="dismiss"  data-part="btn">확인</button></div></section></div>
