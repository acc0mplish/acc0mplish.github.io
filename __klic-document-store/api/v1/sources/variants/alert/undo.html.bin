<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-action.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="alert" data-kv-variant="undo" data-klic-component="alert" class="kn-alert"><section data-kv-undo data-part="message"><i data-part="icon" data-lucide="archive" aria-hidden="true"></i><div><header data-part="heading"><strong>문서를 보관했습니다</strong><p data-part="muted">브랜드 가이드 · 로컬 예제</p></header><button type="button" data-klic-surface="control" data-kv-action="undo"  data-part="btn">실행 취소</button><output aria-live="polite" data-part="output"></output></div></section></div>
