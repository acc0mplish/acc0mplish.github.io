<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-basic.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="alert" data-kv-variant="warning" data-klic-component="alert" class="kn-alert"><section class="kv-warning" data-part="message"><i data-part="icon" data-lucide="triangle-alert" aria-hidden="true"></i><div><header data-part="heading"><strong>연결 상태를 확인하세요</strong><p data-part="muted">이메일 주소가 아직 확인되지 않았습니다.</p></header><button type="button" data-klic-surface="control" data-kv-action="notice" data-kv-message="데모: 확인 메일을 요청했습니다." data-part="btn">확인 메일 요청</button></div></section></div>
