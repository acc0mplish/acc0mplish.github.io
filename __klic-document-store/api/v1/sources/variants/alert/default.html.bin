<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="alert" class="kn-alert"><div role="note" data-part="alert"><i data-part="icon" data-lucide="info" aria-hidden="true"></i><div><strong>검토할 변경사항이 있어요.</strong><p>새로운 토큰 값을 적용하기 전에 팀과 확인하세요.</p></div></div></div>
