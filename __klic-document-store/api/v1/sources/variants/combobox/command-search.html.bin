<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/autocomplete/demos/inline/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="combobox" data-kv-variant="command-search" data-klic-component="combobox" class="kn-combobox"><header data-part="heading"><strong>프로젝트 선택</strong></header><input type="search" data-kv-filter aria-label="프로젝트 검색" placeholder="프로젝트 이름 검색" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">디자인 시스템</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">웹 리뉴얼</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">모바일 앱</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">운영 대시보드</button></div><output aria-live="polite" data-part="output">프로젝트를 선택하세요.</output></div>
