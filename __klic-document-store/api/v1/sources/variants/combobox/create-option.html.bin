<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/combobox/demos/create-items/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="combobox" data-kv-variant="create-option" data-klic-component="combobox" class="kn-combobox"><form data-kv-form><label data-part="field"><span>분류</span><input list="kv-export-combobox-combobox-create-option-suggest" required placeholder="입력하거나 후보를 선택하세요" data-part="input"></label><datalist id="kv-export-combobox-combobox-create-option-suggest"><option value="디자인"></option><option value="개발"></option><option value="운영"></option></datalist><p data-part="muted">목록에 없는 새 분류도 입력할 수 있습니다.</p><button type="submit" class="kv-primary" data-part="btn">분류 적용</button><output aria-live="polite" data-part="output"></output></form></div>
