<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="card" data-kv-variant="profile" data-klic-component="card" class="kn-card"><article data-klic-surface="card" class="ku-center" data-part="card card-body center"><span aria-label="김" data-part="avatar">김</span><header data-part="heading"><strong>김하늘</strong><p data-part="muted">프로덕트 디자이너</p></header><div data-part="tags"><span data-part="badge">디자인 시스템</span><span data-part="badge">접근성</span></div><p data-part="muted">일관된 경험을 만드는 제품 디자인을 합니다.</p><button type="button" data-klic-surface="control" data-kv-action="copy-text" data-kv-value="https://example.com/haneul" data-part="btn">프로필 주소 복사</button></article></div>
