<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="card" data-kv-variant="project" data-klic-component="card" class="kn-card"><article data-klic-surface="card" data-part="card card-body"><div class="ku-row" data-part="row"><span><span data-part="badge">진행 중</span></span><span><details  data-part="details"><summary>작업</summary><div><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">상세 확인</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">리뷰 요청</button></div></div></details></span></div><header data-part="heading"><strong>KLIC 라이브러리</strong><p data-part="muted">100개 컴포넌트의 사용 경험 개선</p></header><label data-part="progress-label">완료<span>72%</span><progress max="100" value="72">72%</progress></label><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span> 김하늘</span><span>10.30 마감</span></div></article></div>
