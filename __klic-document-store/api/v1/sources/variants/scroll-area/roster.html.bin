<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/scroll-area/demos/scroll-fade/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="scroll-area" data-kv-variant="roster" data-klic-component="scroll-area" class="kn-scroll-area"><input type="search" data-kv-filter aria-label="멤버 검색" placeholder="멤버 검색" data-part="input"><div tabindex="0" role="region" aria-label="멤버 목록" class="ku-scroll" data-part="scroll"><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="김" data-part="avatar">김</span><strong>김하늘</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="이" data-part="avatar">이</span><strong>이도윤</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="박" data-part="avatar">박</span><strong>박서연</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="최" data-part="avatar">최</span><strong>최지우</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="정" data-part="avatar">정</span><strong>정유진</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="윤" data-part="avatar">윤</span><strong>윤서준</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="한" data-part="avatar">한</span><strong>한지민</strong><span>팀 멤버</span></div><div data-kv-filter-item class="ku-row" data-part="row"><span aria-label="오" data-part="avatar">오</span><strong>오민준</strong><span>팀 멤버</span></div></div></div>
