<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="hover-card" data-kv-variant="profile" data-klic-component="hover-card" class="kn-hover-card"><header data-part="heading"><strong>프로젝트 담당자</strong></header><div data-part="hover-wrap"><button type="button" data-klic-surface="control" data-kv-hover aria-expanded="false" aria-controls="kv-export-hover-card-hover-card-profile-hover" data-part="btn"><span aria-label="김" data-part="avatar">김</span> 김하늘</button><section data-klic-surface="overlay" popover="manual" id="kv-export-hover-card-hover-card-profile-hover" data-part="hover-content" data-state="closed"><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span></span><span><header data-part="heading"><strong>김하늘</strong><p data-part="muted">프로덕트 디자이너</p></header></span></div><p data-part="muted">디자인 시스템과 접근성을 담당합니다.</p><div class="ku-row" data-part="row"><span>이메일</span><span>haneul@example.com</span></div></section></div></div>
