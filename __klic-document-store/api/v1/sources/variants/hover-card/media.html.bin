<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="hover-card" data-kv-variant="media" data-klic-component="hover-card" class="kn-hover-card"><header data-part="heading"><strong>팀 문서</strong></header><div data-part="hover-wrap"><button type="button" data-klic-surface="control" data-kv-hover aria-expanded="false" aria-controls="kv-export-hover-card-hover-card-media-hover" data-part="btn">새로운 디자인 가이드</button><section data-klic-surface="overlay" popover="manual" id="kv-export-hover-card-hover-card-media-hover" data-part="hover-content" data-state="closed"><div role="img" aria-label="함께 만드는 언어" data-part="art"><span>KLIC</span><strong>함께 만드는 언어</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>디자인 가이드</strong><p data-part="muted">컴포넌트와 토큰을 연결하는 실무 문서</p></header></section></div></div>
