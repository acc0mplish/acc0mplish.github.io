<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-with-addons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="number-input" data-kv-variant="threshold" data-klic-component="number-input" class="kn-number-input"><header data-part="heading"><strong>사용량 알림</strong><p data-part="muted">설정한 비율을 넘기면 알림을 받습니다.</p></header><label data-part="progress-label">현재 사용량<span>62%</span><progress max="100" value="62">62%</progress></label><form data-kv-form><label data-part="field"><span>알림 기준 (%)</span><input type="number" value="80" min="1" max="100" data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">기준 저장</button><output aria-live="polite" data-part="output"></output></form></div>
