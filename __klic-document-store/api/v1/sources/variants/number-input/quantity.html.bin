<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="number-input" data-kv-variant="quantity" data-klic-component="number-input" class="kn-number-input"><header data-part="heading"><strong>라이선스 수량</strong><p data-part="muted">팀원이 사용할 좌석 수를 선택하세요.</p></header><div data-klic-surface="field" data-part="input-group"><button type="button" data-klic-surface="control" data-kv-action="number-down" aria-label="수량 줄이기" data-part="btn">−</button><input type="number" aria-label="좌석 수" min="1" max="99" value="5" data-part="input"><button type="button" data-klic-surface="control" data-kv-action="number-up" aria-label="수량 늘리기" data-part="btn">+</button><span>좌석</span></div></div>
