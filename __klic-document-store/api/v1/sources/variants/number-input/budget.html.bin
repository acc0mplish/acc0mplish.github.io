<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="number-input" data-kv-variant="budget" data-klic-component="number-input" class="kn-number-input"><form data-kv-form><label data-part="field"><span>월간 예산 (원)</span><input type="number" value="50000" min="0" max="1000000" step="1000" data-part="input"></label><p data-part="muted">1,000원 단위로 조정할 수 있습니다.</p><button type="submit" class="kv-primary" data-part="btn">예산 적용</button><output aria-live="polite" data-part="output"></output></form></div>
