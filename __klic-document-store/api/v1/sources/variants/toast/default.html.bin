<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<button data-action="toast-demo" data-klic-component="toast" class="kn-toast"><span data-part="toast-check"><i data-part="icon" data-lucide="check"></i></span><span><strong>변경사항을 저장했어요.</strong><small>이제 팀원과 함께 확인할 수 있습니다.</small></span><i data-part="icon" data-lucide="chevron-right"></i></button>
