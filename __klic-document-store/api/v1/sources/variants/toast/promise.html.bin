<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="toast" data-kv-variant="promise" data-klic-component="toast" class="kn-toast"><button type="button" data-klic-surface="control" data-kv-action="toast-show"  data-part="btn">알림 다시 표시</button><section data-kv-toast role="status" data-part="toast-box"><div><header data-part="heading"><strong>보고서 생성 준비</strong><p data-part="muted">버튼을 누르면 로컬 처리 과정을 보여줍니다.</p></header><button type="button" data-klic-surface="control" data-kv-action="toast-async"  data-part="btn">보고서 생성</button><output aria-live="polite" data-part="output"></output></div><button type="button" data-klic-surface="control" data-kv-action="toast-close" aria-label="알림 닫기" data-part="btn">×</button></section></div>
