<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="toast" data-kv-variant="invite" data-klic-component="toast" class="kn-toast"><button type="button" data-klic-surface="control" data-kv-action="toast-show"  data-part="btn">알림 다시 표시</button><section data-kv-toast role="status" data-part="toast-box"><div><div class="ku-row" data-part="row"><span><span aria-label="박" data-part="avatar">박</span></span><span><strong>박서연</strong> · 방금 전</span></div><header data-part="heading"><strong>디자인 리뷰 초대</strong><p data-part="muted">팀의 새로운 가이드를 함께 검토해 주세요.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="invitation" data-kv-answer="참여 의사를 표시했습니다." data-part="btn">참여</button><button type="button" data-klic-surface="control" data-kv-action="invitation" data-kv-answer="초대를 나중에 확인합니다." data-part="btn">나중에</button></div><output aria-live="polite" data-part="output"></output></div><button type="button" data-klic-surface="control" data-kv-action="toast-close" aria-label="알림 닫기" data-part="btn">×</button></section></div>
