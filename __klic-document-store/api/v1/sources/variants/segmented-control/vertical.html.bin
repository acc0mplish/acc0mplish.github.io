<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/toggle-group-vertical.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="segmented-control" data-kv-variant="vertical" data-klic-component="segmented-control" class="kn-segmented-control"><header data-part="heading"><strong>문서함</strong></header><div data-part="segment segment-vertical"><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-segmented-control-segmented-control-vertical" value="전체 문서 · 38" checked data-part="radio"><span><strong>전체 문서 · 38</strong></span></label><label><input type="radio" name="kv-export-segmented-control-segmented-control-vertical" value="내 문서 · 12"  data-part="radio"><span><strong>내 문서 · 12</strong></span></label><label><input type="radio" name="kv-export-segmented-control-segmented-control-vertical" value="공유 문서 · 26"  data-part="radio"><span><strong>공유 문서 · 26</strong></span></label></fieldset></div><output data-kv-selection aria-live="polite" data-part="output">전체 문서 선택됨</output></div>
