<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/tabs-line.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="segmented-control" data-kv-variant="period" data-klic-component="segmented-control" class="kn-segmented-control"><header data-part="heading"><strong>방문 분석</strong></header><div data-part="segment"><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-segmented-control-segmented-control-period" value="일간" checked data-part="radio"><span><strong>일간</strong></span></label><label><input type="radio" name="kv-export-segmented-control-segmented-control-period" value="주간"  data-part="radio"><span><strong>주간</strong></span></label><label><input type="radio" name="kv-export-segmented-control-segmented-control-period" value="월간"  data-part="radio"><span><strong>월간</strong></span></label></fieldset></div><output data-kv-selection aria-live="polite" data-part="output">일간 선택됨</output><svg viewBox="0 0 180 56" role="img" aria-label="기간별 추세: 40, 33, 38, 21, 29, 12, 17, 8" data-part="spark"><polyline points="0,40 25,33 50,38 75,21 100,29 125,12 150,17 175,8" fill="none" stroke="currentColor" stroke-width="3"/></svg></div>
