<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-select.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="segmented-control" data-kv-variant="billing" data-klic-component="segmented-control" class="kn-segmented-control"><header data-part="heading"><strong>청구 주기</strong></header><div data-part="segment segment-cards"><fieldset data-part="choices choice-cards"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-segmented-control-segmented-control-billing" value="월간" checked data-part="radio"><span><strong>월간</strong><small>매월 유연하게 결제</small></span></label><label><input type="radio" name="kv-export-segmented-control-segmented-control-billing" value="연간"  data-part="radio"><span><strong>연간</strong><small>1년 단위로 관리</small></span></label></fieldset></div><div class="ku-row" data-part="row"><span>Team 플랜</span><span>멤버당 ₩12,000부터</span></div><output data-kv-selection aria-live="polite" data-part="output">월간 선택됨</output></div>
