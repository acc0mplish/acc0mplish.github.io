<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/empty-card.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="empty-state" data-kv-variant="permission" data-klic-component="empty-state" class="kn-empty-state"><section data-part="empty"><i data-part="icon" data-lucide="lock-keyhole" aria-hidden="true"></i><header data-part="heading"><strong>접근 권한이 필요합니다</strong><p data-part="muted">팀 관리자의 초대를 받은 뒤 이 문서를 확인할 수 있습니다.</p></header><button type="button" data-klic-surface="control" data-kv-action="notice" data-kv-message="데모: 접근 요청을 준비했습니다." data-part="btn">접근 요청 준비</button><p data-part="muted">관리자 · 김하늘</p></section></div>
