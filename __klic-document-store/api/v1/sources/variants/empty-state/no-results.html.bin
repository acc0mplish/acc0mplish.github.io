<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/empty-input-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="empty-state" data-kv-variant="no-results" data-klic-component="empty-state" class="kn-empty-state"><section data-part="empty"><i data-part="icon" data-lucide="search" aria-hidden="true"></i><input type="search" value="일치하지 않는 검색어" aria-label="검색어" data-part="input"><header data-part="heading"><strong>검색 결과가 없습니다</strong><p data-part="muted">다른 키워드를 사용하거나 조건을 초기화하세요.</p></header><button type="button" data-klic-surface="control" data-kv-action="clear-search"  data-part="btn">검색 초기화</button></section></div>
