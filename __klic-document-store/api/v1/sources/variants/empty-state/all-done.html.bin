<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/empty-avatar-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="empty-state" data-kv-variant="all-done" data-klic-component="empty-state" class="kn-empty-state"><section data-part="empty"><i data-part="icon" data-lucide="circle-check" aria-hidden="true"></i><header data-part="heading"><strong>모든 검토를 마쳤습니다</strong><p data-part="muted">오늘 요청된 8건을 모두 확인했습니다.</p></header><details  data-part="details"><summary>완료 내역</summary><div><ul data-part="list"><li>문서 검토 5건</li><li>컴포넌트 검토 3건</li></ul></div></details></section></div>
