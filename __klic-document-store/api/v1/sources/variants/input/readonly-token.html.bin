<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-with-buttons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="input" data-kv-variant="readonly-token" data-klic-component="input" class="kn-input"><header data-part="heading"><strong>프로젝트 식별자</strong><p data-part="muted">공개 식별자이며 비밀 API 키가 아닙니다.</p></header><div data-klic-surface="field" data-part="input-group"><input aria-label="프로젝트 식별자" readonly value="klic_project_2026" data-part="input"><button type="button" data-klic-surface="control" data-kv-action="copy-value"  data-part="btn">복사</button></div></div>
