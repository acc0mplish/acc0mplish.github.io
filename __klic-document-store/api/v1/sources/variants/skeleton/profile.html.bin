<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/skeleton-avatar.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="skeleton" data-kv-variant="profile" data-klic-component="skeleton" class="kn-skeleton"><div role="status" aria-label="프로필 불러오는 중"><div class="ku-row" data-part="row"><span data-part="skeleton skeleton-circle"></span><div class="ku-grow" data-part="grow"><span data-part="skeleton sk-line"></span><span data-part="skeleton sk-line sk-short"></span></div></div><p data-part="muted">프로필을 불러오는 중입니다.</p></div></div>
