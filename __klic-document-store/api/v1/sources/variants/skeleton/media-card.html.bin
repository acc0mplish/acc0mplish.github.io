<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/skeleton-card.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="skeleton" data-kv-variant="media-card" data-klic-component="skeleton" class="kn-skeleton"><div data-klic-surface="card" role="status" aria-label="콘텐츠 불러오는 중" data-part="card"><div data-part="skeleton sk-image"></div><div data-part="card-body"><span data-part="skeleton sk-line"></span><span data-part="skeleton sk-line sk-short"></span><p data-part="muted">콘텐츠를 준비하고 있습니다.</p></div></div></div>
