<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tree" data-kv-variant="category-select" data-klic-component="tree" class="kn-tree"><header data-part="heading"><strong>문서 분류 선택</strong></header><details open data-part="details"><summary>제품</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-tree-category-select" value="기획 문서" checked data-part="radio"><span><strong>기획 문서</strong></span></label><label><input type="radio" name="kv-export-tree-tree-category-select" value="디자인 문서"  data-part="radio"><span><strong>디자인 문서</strong></span></label><label><input type="radio" name="kv-export-tree-tree-category-select" value="개발 문서"  data-part="radio"><span><strong>개발 문서</strong></span></label></fieldset></div></details><details  data-part="details"><summary>운영</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-tree-category-select" value="운영 매뉴얼" data-part="radio"><span><strong>운영 매뉴얼</strong></span></label><label><input type="radio" name="kv-export-tree-tree-category-select" value="고객 가이드"  data-part="radio"><span><strong>고객 가이드</strong></span></label></fieldset></div></details><output data-kv-selection aria-live="polite" data-part="output">기획 문서 선택됨</output></div>
