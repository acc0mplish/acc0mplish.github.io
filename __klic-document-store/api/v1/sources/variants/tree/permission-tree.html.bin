<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tree" data-kv-variant="permission-tree" data-klic-component="tree" class="kn-tree"><header data-part="heading"><strong>공유할 폴더</strong></header><details open data-part="details"><summary>프로젝트 자료</summary><div><fieldset data-part="choices choice-cards"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-tree-tree-permission-tree" value="디자인 시안" checked data-part="checkbox"><span><strong>디자인 시안</strong></span></label><label><input type="checkbox" name="kv-export-tree-tree-permission-tree" value="요구 사항"  data-part="checkbox"><span><strong>요구 사항</strong></span></label><label><input type="checkbox" name="kv-export-tree-tree-permission-tree" value="회의 기록"  data-part="checkbox"><span><strong>회의 기록</strong></span></label></fieldset></div></details><details  data-part="details"><summary>팀 가이드</summary><div><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-tree-tree-permission-tree-guide" value="브랜드 규칙" checked data-part="checkbox"><span><strong>브랜드 규칙</strong></span></label><label><input type="checkbox" name="kv-export-tree-tree-permission-tree-guide" value="개발 규칙"  data-part="checkbox"><span><strong>개발 규칙</strong></span></label></fieldset></div></details><output data-kv-selection aria-live="polite" data-part="output"></output></div>
