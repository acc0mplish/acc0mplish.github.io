<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-dropdown.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="list" data-kv-variant="settings" data-klic-component="list" class="kn-list"><header data-part="heading"><strong>프로젝트 알림</strong></header><fieldset data-part="choices choice-cards"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-list-list-settings" value="새 댓글" checked data-part="checkbox"><span><strong>새 댓글</strong><small>참여한 문서의 새로운 댓글</small></span></label><label><input type="checkbox" name="kv-export-list-list-settings" value="상태 변경"  data-part="checkbox"><span><strong>상태 변경</strong><small>담당 작업의 상태가 바뀔 때</small></span></label><label><input type="checkbox" name="kv-export-list-list-settings" value="주간 요약"  data-part="checkbox"><span><strong>주간 요약</strong><small>일주일의 활동을 모아서</small></span></label></fieldset></div>
