<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="list" class="kn-list"><ul data-part="list"><li><span><i data-part="icon" data-lucide="layers" aria-hidden="true"></i>디자인 시스템</span><button type="button" data-cmp-action="list-open" data-name="디자인 시스템" data-part="btn" class="kv-neutral kv-sm">열기</button></li><li><span><i data-part="icon" data-lucide="pen-tool" aria-hidden="true"></i>브랜드 리뉴얼</span><button type="button" data-cmp-action="list-open" data-name="브랜드 리뉴얼" data-part="btn" class="kv-neutral kv-sm">열기</button></li><li><span><i data-part="icon" data-lucide="smartphone" aria-hidden="true"></i>모바일 앱</span><button type="button" data-cmp-action="list-open" data-name="모바일 앱" data-part="btn" class="kv-neutral kv-sm">열기</button></li></ul><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
