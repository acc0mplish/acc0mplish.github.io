<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-avatar.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="list" data-kv-variant="activity" data-klic-component="list" class="kn-list"><header data-part="heading"><strong>팀 활동</strong></header><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span><span><strong>김하늘</strong><p data-part="muted">가이드를 업데이트했습니다</p></span></span><span>5분 전</span></div><div class="ku-row" data-part="row"><span><span aria-label="이" data-part="avatar">이</span><span><strong>이도윤</strong><p data-part="muted">리뷰를 요청했습니다</p></span></span><span>30분 전</span></div><div class="ku-row" data-part="row"><span><span aria-label="박" data-part="avatar">박</span><span><strong>박서연</strong><p data-part="muted">댓글을 남겼습니다</p></span></span><span>1시간 전</span></div></div>
