<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div style="width:100%;overflow:auto" data-klic-component="table" class="kn-table"><table data-part="table-preview"><caption class="ku-visually-hidden" data-part="visually-hidden">프로젝트 팀원 예시</caption><thead><tr><th scope="col">이름</th><th scope="col">상태</th><th scope="col" data-part="optional-col">역할</th></tr></thead><tbody><tr><td><span data-part="person"><span role="img" aria-label="김하늘 · 생성한 가상 인물 프로필" title="김하늘" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:60% 40%" data-part="person-avatar root-person has-photo">하늘</span>김하늘</span></td><td><span data-part="badge">진행 중</span></td><td data-part="optional-col mono">디자인</td></tr><tr><td><span data-part="person"><span role="img" aria-label="이지원 · 생성한 가상 인물 프로필" title="이지원" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:100% 40%" data-part="person-avatar root-person has-photo">지원</span>이지원</span></td><td><span class="kv-warning" data-part="badge">검토 중</span></td><td data-part="optional-col mono">개발</td></tr><tr><td><span data-part="person"><span role="img" aria-label="박선준 · 생성한 가상 인물 프로필" title="박선준" style="background-image:url('./block-runtime/portraits/team-atlas-b.png');background-size:600% 600%;background-position:40% 0%" data-part="person-avatar root-person has-photo">선준</span>박선준</span></td><td><span class="kv-neutral" data-part="badge">대기 중</span></td><td data-part="optional-col mono">기획</td></tr></tbody></table></div>
