<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/table-actions.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="table" data-kv-variant="actions" data-klic-component="table" class="kn-table"><div tabindex="0" role="region" aria-label="데이터 표" data-part="table-scroll"><table ><thead><tr><th scope="col">프로젝트</th><th scope="col">담당</th><th scope="col">작업</th></tr></thead><tbody><tr><td>KLIC 라이브러리</td><td>김하늘</td><td><details  data-part="details"><summary>작업</summary><div><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">세부 정보</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">검토 요청</button></div></div></details></td></tr><tr><td>웹 리뉴얼</td><td>이도윤</td><td><details  data-part="details"><summary>작업</summary><div><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">세부 정보</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">보관</button></div></div></details></td></tr></tbody></table></div></div>
