<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="splitter" data-kv-variant="preview" data-klic-component="splitter" class="kn-splitter"><header data-part="heading"><strong>반응형 미리 보기</strong></header><label data-part="field"><span>미리 보기 너비 (%)</span><input type="range" value="80" min="45" max="100" data-kv-resize data-part="slider"></label><div data-kv-resize-target style="width:80%" data-part="resize"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>KLIC</strong></header><p data-part="muted">내용은 영역 너비에 맞춰 줄바꿈됩니다.</p><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" data-part="btn">선택</button></section></div></div>
