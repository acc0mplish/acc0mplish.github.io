<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-destructive.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="popconfirm" data-kv-variant="reset" data-klic-component="popconfirm" class="kn-popconfirm"><header data-part="heading"><strong>적용된 조건</strong></header><div data-part="tags"><span data-part="badge">디자인</span><span data-part="badge">이번 달</span></div><div data-part="popconfirm"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-open" aria-expanded="false" aria-controls="kv-export-popconfirm-popconfirm-reset-confirm" data-part="btn">조건 초기화</button><section data-klic-surface="overlay" id="kv-export-popconfirm-popconfirm-reset-confirm" data-kv-confirm-pop popover="manual" hidden aria-label="조건을 초기화할까요?" data-part="confirm-pop" data-state="closed"><header data-part="heading"><strong>조건을 초기화할까요?</strong><p data-part="muted">선택된 분류와 기간을 기본값으로 바꿉니다.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-close"  data-part="btn">취소</button><button type="button" data-klic-surface="control" data-kv-action="popconfirm-accept"  data-part="btn">초기화 확인</button></div></section><output aria-live="polite" data-part="output"></output></div></div>
