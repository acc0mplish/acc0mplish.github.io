<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/popover-form.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="popconfirm" data-kv-variant="leave" data-klic-component="popconfirm" class="kn-popconfirm"><header data-part="heading"><strong>웹 리뉴얼</strong><p data-part="muted">현재 프로젝트에 참여 중입니다.</p></header><div data-part="popconfirm"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-open" aria-expanded="false" aria-controls="kv-export-popconfirm-popconfirm-leave-confirm" data-part="btn">프로젝트 나가기</button><section data-klic-surface="overlay" id="kv-export-popconfirm-popconfirm-leave-confirm" data-kv-confirm-pop popover="manual" hidden aria-label="프로젝트에서 나갈까요?" data-part="confirm-pop" data-state="closed"><header data-part="heading"><strong>프로젝트에서 나갈까요?</strong><p data-part="muted">새 작업과 댓글 알림을 받지 않게 됩니다.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-close"  data-part="btn">취소</button><button type="button" data-klic-surface="control" data-kv-action="popconfirm-accept"  data-part="btn">나가기 확인</button></div></section><output aria-live="polite" data-part="output"></output></div></div>
