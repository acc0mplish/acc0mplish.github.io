<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-small.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="popconfirm" data-kv-variant="delete-row" data-klic-component="popconfirm" class="kn-popconfirm"><div class="ku-row" data-part="row"><span>회의 메모.txt</span><span><span data-part="badge">초안</span></span></div><div data-part="popconfirm"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-open" aria-expanded="false" aria-controls="kv-export-popconfirm-popconfirm-delete-row-confirm" data-part="btn">메모 삭제</button><section data-klic-surface="overlay" id="kv-export-popconfirm-popconfirm-delete-row-confirm" data-kv-confirm-pop popover="manual" hidden aria-label="메모를 삭제할까요?" data-part="confirm-pop" data-state="closed"><header data-part="heading"><strong>메모를 삭제할까요?</strong><p data-part="muted">이 미리 보기에서만 삭제 동작을 확인합니다.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-close"  data-part="btn">취소</button><button type="button" data-klic-surface="control" data-kv-action="popconfirm-accept"  data-part="btn">삭제 확인</button></div></section><output aria-live="polite" data-part="output"></output></div></div>
