<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-media.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="popconfirm" data-kv-variant="overwrite" data-klic-component="popconfirm" class="kn-popconfirm"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>가이드.pdf</strong></header><div class="ku-row" data-part="row"><span>기존 버전</span><span>10.20</span></div><div class="ku-row" data-part="row"><span>새 버전</span><span>10.26</span></div></section><div data-part="popconfirm"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-open" aria-expanded="false" aria-controls="kv-export-popconfirm-popconfirm-overwrite-confirm" data-part="btn">버전 교체</button><section data-klic-surface="overlay" id="kv-export-popconfirm-popconfirm-overwrite-confirm" data-kv-confirm-pop popover="manual" hidden aria-label="새 버전으로 바꿀까요?" data-part="confirm-pop" data-state="closed"><header data-part="heading"><strong>새 버전으로 바꿀까요?</strong><p data-part="muted">기존 버전은 변경 기록에 남습니다.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="popconfirm-close"  data-part="btn">취소</button><button type="button" data-klic-surface="control" data-kv-action="popconfirm-accept"  data-part="btn">새 버전 적용</button></div></section><output aria-live="polite" data-part="output"></output></div></div>
