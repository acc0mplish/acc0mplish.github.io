<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-image.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="image" data-kv-variant="portrait" data-klic-component="image" class="kn-image"><div data-part="portrait-layout"><div role="img" aria-label="KLIC DESIGN" data-part="art ratio-portrait"><span>KLIC</span><strong>KLIC DESIGN</strong><span data-part="art-orbit"></span></div><section><header data-part="heading"><strong>디자인 노트</strong><p data-part="muted">형태와 여백의 균형</p></header><p data-part="muted">세로 이미지를 사용한 에디토리얼 구성입니다.</p></section></div></div>
