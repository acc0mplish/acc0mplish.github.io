<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/separator-vertical.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="separator" data-kv-variant="vertical" data-klic-component="separator" class="kn-separator"><header data-part="heading"><strong>문서 편집</strong></header><div data-part="toolbar"><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" data-part="btn">굵게</button><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" data-part="btn">기울임</button><span role="separator" aria-orientation="vertical" data-part="divider-v"></span><button type="button" data-klic-surface="control" data-kv-action="copy-text" data-kv-value="https://example.com/doc" data-part="btn">공유 링크 복사</button></div></div>
