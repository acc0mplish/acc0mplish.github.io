<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/separator-demo.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="separator" data-kv-variant="labeled" data-klic-component="separator" class="kn-separator"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">회사 계정으로 계속</button><div data-part="separator-label"><hr><span>또는 이메일로</span><hr></div><label data-part="field"><span>이메일</span><input type="email" value="" placeholder="name@company.com" data-part="input"></label></div>
