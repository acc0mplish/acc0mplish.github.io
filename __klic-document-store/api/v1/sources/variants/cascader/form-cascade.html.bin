<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="cascader" data-kv-variant="form-cascade" data-klic-component="cascader" class="kn-cascader"><form data-kv-form><header data-part="heading"><strong>문의 접수</strong></header><div data-kv-cascade data-part="cascade cascade-stack"><label data-part="field"><span>상위 분류</span><select data-kv-cascade-level="0" data-part="select"><option>제품</option><option>운영</option></select></label><label data-part="field"><span>하위 분류</span><select data-kv-cascade-level="1" data-part="select"><option>디자인</option><option>개발</option></select></label><label data-part="field"><span>세부 분류</span><select data-kv-cascade-level="2" data-part="select"><option>인터페이스</option><option>브랜드</option></select></label><output data-kv-cascade-output aria-live="polite" data-part="output">제품 / 디자인 / 인터페이스</output></div><label data-part="field"><span>문의 내용</span><textarea rows="2" required data-part="textarea"></textarea></label><button type="submit" class="kv-primary" data-part="btn">분류와 내용 확인</button><output aria-live="polite" data-part="output"></output></form></div>
