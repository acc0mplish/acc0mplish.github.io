<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="cascader" data-kv-variant="columns" data-klic-component="cascader" class="kn-cascader"><header data-part="heading"><strong>문서 분류</strong></header><div data-kv-cascade data-part="cascade cascade-columns"><label data-part="field"><span>상위 분류</span><select data-kv-cascade-level="0" data-part="select"><option>제품</option><option>운영</option></select></label><label data-part="field"><span>하위 분류</span><select data-kv-cascade-level="1" data-part="select"><option>디자인</option><option>개발</option></select></label><label data-part="field"><span>세부 분류</span><select data-kv-cascade-level="2" data-part="select"><option>인터페이스</option><option>브랜드</option></select></label><output data-kv-cascade-output aria-live="polite" data-part="output">제품 / 디자인 / 인터페이스</output></div></div>
