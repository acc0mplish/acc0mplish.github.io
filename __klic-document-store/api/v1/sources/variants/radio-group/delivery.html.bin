<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/radio-group-description.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="radio-group" data-kv-variant="delivery" data-klic-component="radio-group" class="kn-radio-group"><header data-part="heading"><strong>전달 방식</strong></header><fieldset data-part="choices choice-cards"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-radio-group-radio-group-delivery" value="이메일" checked data-part="radio"><span><strong>이메일</strong><small>받는 사람에게 직접 전달</small></span></label><label><input type="radio" name="kv-export-radio-group-radio-group-delivery" value="공유 링크"  data-part="radio"><span><strong>공유 링크</strong><small>링크를 복사해 전달</small></span></label></fieldset><output data-kv-selection aria-live="polite" data-part="output">이메일 선택됨</output></div>
