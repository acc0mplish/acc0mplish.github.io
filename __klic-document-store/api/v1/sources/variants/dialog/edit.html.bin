<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/dialog-demo.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="dialog" data-kv-variant="edit" data-klic-component="dialog" class="kn-dialog"><header data-part="heading"><strong>프로젝트 정보</strong><p data-part="muted">필요할 때 편집 화면을 열어보세요.</p></header><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-dialog-dialog-edit-dialog" data-part="btn">프로젝트 편집</button><dialog id="kv-export-dialog-dialog-edit-dialog" aria-label="프로젝트 편집" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>프로젝트 편집</strong></header><form data-kv-form><label data-part="field"><span>프로젝트 이름</span><input type="text" value="KLIC 라이브러리" required data-part="input"></label><label data-part="field"><span>담당 팀</span><input type="text" value="프로덕트 디자인"  data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">변경 저장</button><output aria-live="polite" data-part="output"></output></form><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
