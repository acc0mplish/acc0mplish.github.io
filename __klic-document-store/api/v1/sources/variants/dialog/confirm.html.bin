<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-media.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="dialog" data-kv-variant="confirm" data-klic-component="dialog" class="kn-dialog"><header data-part="heading"><strong>초안 보관</strong><p data-part="muted">보관한 초안은 기록에서 다시 확인할 수 있습니다.</p></header><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-dialog-dialog-confirm-dialog" data-part="btn">보관하기</button><dialog id="kv-export-dialog-dialog-confirm-dialog" aria-label="초안을 보관할까요?" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>초안을 보관할까요?</strong></header><p data-part="muted">이 작업은 현재 미리 보기에서만 실행됩니다. 원본 데이터는 변경하지 않습니다.</p><div data-klic-surface="card" data-part="panel">디자인 시스템 · 수정 3건</div><button type="button" data-klic-surface="control" data-kv-action="dialog-confirm"  data-part="btn">보관 확인</button><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
