<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/carousel-api.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="carousel" data-kv-variant="testimonials" data-klic-component="carousel" class="kn-carousel"><div data-kv-carousel><figure data-kv-slide  data-part="quote"><blockquote>작업의 기준이 명확해졌어요.</blockquote><figcaption><span aria-label="김" data-part="avatar">김</span> 김하늘</figcaption></figure><figure data-kv-slide hidden data-part="quote"><blockquote>팀 협업이 더 편리해졌어요.</blockquote><figcaption><span aria-label="이" data-part="avatar">이</span> 이도윤</figcaption></figure><figure data-kv-slide hidden data-part="quote"><blockquote>문서를 찾는 시간이 줄었어요.</blockquote><figcaption><span aria-label="박" data-part="avatar">박</span> 박서연</figcaption></figure><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="slide-prev"  data-part="btn">이전 후기</button><button type="button" data-klic-surface="control" data-kv-action="slide-next"  data-part="btn">다음 후기</button><output aria-live="polite" data-part="output">1 / 3</output></div></div></div>
