<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/carousel-api.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="carousel" data-kv-variant="step-preview" data-klic-component="carousel" class="kn-carousel"><div data-kv-carousel><section data-kv-slide ><span data-part="badge">STEP 01</span><header data-part="heading"><strong>자료 연결</strong></header><div role="img" aria-label="자료 연결" data-part="art"><span>KLIC</span><strong>자료 연결</strong><span data-part="art-orbit"></span></div><p data-part="muted">팀의 작업 흐름을 하나씩 준비합니다.</p></section><section data-kv-slide hidden><span data-part="badge">STEP 02</span><header data-part="heading"><strong>구조 만들기</strong></header><div role="img" aria-label="구조 만들기" data-part="art"><span>KLIC</span><strong>구조 만들기</strong><span data-part="art-orbit"></span></div><p data-part="muted">팀의 작업 흐름을 하나씩 준비합니다.</p></section><section data-kv-slide hidden><span data-part="badge">STEP 03</span><header data-part="heading"><strong>팀에 공유</strong></header><div role="img" aria-label="팀에 공유" data-part="art"><span>KLIC</span><strong>팀에 공유</strong><span data-part="art-orbit"></span></div><p data-part="muted">팀의 작업 흐름을 하나씩 준비합니다.</p></section><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="slide-prev"  data-part="btn">이전 단계</button><button type="button" data-klic-surface="control" data-kv-action="slide-next"  data-part="btn">다음 단계</button><output aria-live="polite" data-part="output">1 / 3</output></div></div></div>
