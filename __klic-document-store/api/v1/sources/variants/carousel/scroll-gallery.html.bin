<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/carousel-multiple.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="carousel" data-kv-variant="scroll-gallery" data-klic-component="carousel" class="kn-carousel"><div tabindex="0" role="region" aria-label="프로젝트 갤러리" data-part="scroll-gallery"><article><div role="img" aria-label="디자인 시스템" data-part="art"><span>KLIC</span><strong>디자인 시스템</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>디자인 시스템</strong></header></article><article><div role="img" aria-label="웹 리뉴얼" data-part="art"><span>KLIC</span><strong>웹 리뉴얼</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>웹 리뉴얼</strong></header></article><article><div role="img" aria-label="모바일 앱" data-part="art"><span>KLIC</span><strong>모바일 앱</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>모바일 앱</strong></header></article></div><p data-part="muted">가로로 스크롤하거나 Shift + 휠로 탐색하세요.</p></div>
