<div data-klic-component="carousel" class="kn-carousel"><div data-carousel="0" data-part="carousel"><figure data-slide ><img src="./block-runtime/catalog/course-02.webp" alt="데이터 분석 대시보드" width="640" height="400" loading="lazy" ><figcaption>인터페이스 설계</figcaption></figure><figure data-slide hidden><img src="./block-runtime/catalog/course-03.webp" alt="모바일 인터페이스 디자인" width="640" height="400" loading="lazy" ><figcaption>제품 디자인</figcaption></figure><figure data-slide hidden><img src="./block-runtime/catalog/course-05.webp" alt="프로토타이핑 작업" width="640" height="400" loading="lazy" ><figcaption>팀 협업</figcaption></figure><div data-part="carousel-tools"><button type="button" data-cmp-action="carousel-prev" aria-label="이전 이미지" data-part="btn" class="kv-neutral kv-sm">‹</button><span data-carousel-count aria-live="polite">1 / 3</span><button type="button" data-cmp-action="carousel-next" aria-label="다음 이미지" data-part="btn" class="kv-neutral kv-sm">›</button></div></div></div>
