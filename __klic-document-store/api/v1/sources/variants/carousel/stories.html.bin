<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/carousel-demo.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="carousel" data-kv-variant="stories" data-klic-component="carousel" class="kn-carousel"><div data-kv-carousel><article data-kv-slide ><div role="img" aria-label="시작하기" data-part="art"><span>KLIC</span><strong>시작하기</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>시작하기</strong><p data-part="muted">디자인 가이드 1</p></header></article><article data-kv-slide hidden><div role="img" aria-label="팀과 함께" data-part="art"><span>KLIC</span><strong>팀과 함께</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>팀과 함께</strong><p data-part="muted">디자인 가이드 2</p></header></article><article data-kv-slide hidden><div role="img" aria-label="경험을 확장하기" data-part="art"><span>KLIC</span><strong>경험을 확장하기</strong><span data-part="art-orbit"></span></div><header data-part="heading"><strong>경험을 확장하기</strong><p data-part="muted">디자인 가이드 3</p></header></article><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="slide-prev"  data-part="btn">이전</button><output aria-live="polite" data-part="output">1 / 3</output><button type="button" data-klic-surface="control" data-kv-action="slide-next"  data-part="btn">다음</button></div></div></div>
