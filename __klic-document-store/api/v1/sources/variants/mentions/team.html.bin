<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/combobox-groups.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="mentions" data-kv-variant="team" data-klic-component="mentions" class="kn-mentions"><label data-part="field"><span>팀 공지</span><textarea rows="3" data-kv-mention-input data-part="textarea"></textarea></label><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="디자인팀" data-part="btn">@디자인팀</button><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="개발팀" data-part="btn">@개발팀</button><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="운영팀" data-part="btn">@운영팀</button></div></div>
