<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/autocomplete/demos/grouped/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="mentions" data-kv-variant="person" data-klic-component="mentions" class="kn-mentions"><label data-part="field"><span>팀 메시지</span><textarea rows="3" data-kv-mention-input placeholder="팀원을 언급해 보세요." data-part="textarea"></textarea></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="김하늘" data-part="btn">@김하늘</button><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="이도윤" data-part="btn">@이도윤</button><button type="button" data-klic-surface="control" data-kv-action="mention" data-kv-value="박서연" data-part="btn">@박서연</button></div></div>
