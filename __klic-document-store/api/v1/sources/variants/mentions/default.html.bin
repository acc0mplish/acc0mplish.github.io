<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="mentions" class="kn-mentions"><label for="export-mentions-default-mention" data-part="label">담당자에게 남길 메모</label><textarea id="export-mentions-default-mention" rows="3" data-mention-text placeholder="검토를 요청할 내용을 작성하세요." data-part="textarea"></textarea><div data-part="button-row" class="ku-button-row"><button type="button" data-cmp-action="mention" data-name="김하늘" data-part="btn" class="kv-neutral kv-sm">@김하늘</button><button type="button" data-cmp-action="mention" data-name="이지원" data-part="btn" class="kv-neutral kv-sm">@이지원</button></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
