<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-small-media.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="alert-dialog" data-kv-variant="remove-member" data-klic-component="alert-dialog" class="kn-alert-dialog"><div class="ku-row" data-part="row"><span><span aria-label="이" data-part="avatar">이</span> 이도윤</span><span><span data-part="badge">에디터</span></span></div><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-alert-dialog-alert-dialog-remove-member-dialog" data-part="btn">멤버 제거</button><dialog role="alertdialog" id="kv-export-alert-dialog-alert-dialog-remove-member-dialog" aria-label="멤버를 제거할까요?" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>멤버를 제거할까요?</strong></header><p data-part="muted">이도윤님의 프로젝트 접근 권한이 사라집니다. 기존 작성 내용은 유지됩니다.</p><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="dialog-confirm"  data-part="btn">멤버 제거 확인</button></div><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
