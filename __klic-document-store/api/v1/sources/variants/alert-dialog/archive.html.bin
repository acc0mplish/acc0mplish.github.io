<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-media.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="alert-dialog" data-kv-variant="archive" data-klic-component="alert-dialog" class="kn-alert-dialog"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>웹 리뉴얼</strong></header><label data-part="progress-label">작업 완료<span>100%</span><progress max="100" value="100">100%</progress></label></section><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-alert-dialog-alert-dialog-archive-dialog" data-part="btn">보관</button><dialog role="alertdialog" id="kv-export-alert-dialog-alert-dialog-archive-dialog" aria-label="프로젝트를 보관할까요?" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>프로젝트를 보관할까요?</strong></header><p data-part="muted">팀의 활성 목록에서 숨겨집니다. 보관함에서 나중에 다시 복원할 수 있습니다.</p><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="dialog-confirm"  data-part="btn">프로젝트 보관</button></div><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
