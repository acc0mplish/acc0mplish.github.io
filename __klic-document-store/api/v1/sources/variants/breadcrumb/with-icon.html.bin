<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/breadcrumb-separator.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="breadcrumb" data-kv-variant="with-icon" data-klic-component="breadcrumb" class="kn-breadcrumb"><nav aria-label="파일 경로" data-part="breadcrumb"><button type="button" data-klic-surface="control" data-kv-action="crumb"  data-part="btn"><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 파일</button><i data-part="icon" data-lucide="chevron-right" aria-hidden="true"></i><span aria-current="page">릴리스 노트</span></nav><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>릴리스 노트</strong></header><div class="ku-row" data-part="row"><span>버전</span><span>v2.4</span></div><div class="ku-row" data-part="row"><span>업데이트</span><span>2026.10.26</span></div></section></div>
