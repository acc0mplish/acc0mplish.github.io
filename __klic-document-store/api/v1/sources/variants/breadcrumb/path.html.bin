<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/breadcrumb-link.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="breadcrumb" data-kv-variant="path" data-klic-component="breadcrumb" class="kn-breadcrumb"><nav aria-label="문서 경로" data-part="breadcrumb"><button type="button" data-klic-surface="control" data-kv-action="crumb"  data-part="btn">워크스페이스</button><i data-part="icon" data-lucide="chevron-right" aria-hidden="true"></i><button type="button" data-klic-surface="control" data-kv-action="crumb"  data-part="btn">디자인</button><i data-part="icon" data-lucide="chevron-right" aria-hidden="true"></i><span aria-current="page">브랜드 가이드</span></nav><header data-part="heading"><strong>브랜드 가이드</strong><p data-part="muted">팀이 함께 사용하는 시각 언어</p></header></div>
