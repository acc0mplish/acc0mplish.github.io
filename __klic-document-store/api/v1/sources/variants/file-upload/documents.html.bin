<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/file-upload-list.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="file-upload" data-kv-variant="documents" data-klic-component="file-upload" class="kn-file-upload"><header data-part="heading"><strong>프로젝트 자료</strong><p data-part="muted">선택한 파일은 서버로 업로드하지 않습니다.</p></header><label data-part="dropzone"><i data-part="icon" data-lucide="file-up" aria-hidden="true"></i><strong>문서 선택</strong><input type="file" multiple data-kv-files accept=".pdf,.docx,.txt" data-part="input"><span>PDF · DOCX · TXT</span></label><ul data-kv-file-list aria-live="polite" data-part="list"><li>선택한 파일이 없습니다.</li></ul></div>
