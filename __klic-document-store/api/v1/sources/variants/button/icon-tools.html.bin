<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-icon.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="button" data-kv-variant="icon-tools" data-klic-component="button" class="kn-btn"><header data-part="heading"><strong>문서 도구</strong><p data-part="muted">자주 사용하는 작업을 작은 아이콘으로 배치합니다.</p></header><div data-part="icon-tools"><div><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" aria-label="관심 문서" title="관심 문서" data-part="btn"><i data-part="icon" data-lucide="bookmark" aria-hidden="true"></i></button><small>관심 문서</small></div><div><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" aria-label="상단 고정" title="상단 고정" data-part="btn"><i data-part="icon" data-lucide="pin" aria-hidden="true"></i></button><small>상단 고정</small></div><div><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" aria-label="알림 받기" title="알림 받기" data-part="btn"><i data-part="icon" data-lucide="bell" aria-hidden="true"></i></button><small>알림 받기</small></div></div><details  data-part="details"><summary>아이콘 안내</summary><div><p data-part="muted">관심 문서에 저장하거나 상단에 고정하고 알림을 받을 수 있습니다. 각 선택은 독립적으로 유지됩니다.</p></div></details></div>
