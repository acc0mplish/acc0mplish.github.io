<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="button" class="kn-btn"><div class="ku-button-row" data-part="button-row"><button data-klic-publishing-target="button-primary" data-action="button-feedback" data-part="btn">시작하기 <i data-part="icon" data-lucide="arrow-right"></i></button><button data-action="button-feedback" class="kv-neutral" data-part="btn">더 알아보기</button></div><div class="ku-button-row" data-part="button-row"><button data-action="button-feedback" class="kv-outline kv-sm" data-part="btn"><i data-part="icon" data-lucide="plus"></i> 새 프로젝트</button><button data-action="async-demo" class="kv-sm" data-part="btn"><i data-part="icon" data-lucide="check"></i> 저장하기</button><button disabled class="kv-ghost kv-sm" data-part="btn">비활성</button></div></div>
