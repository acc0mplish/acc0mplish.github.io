<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-split.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="button" data-kv-variant="split-action" data-klic-component="button" class="kn-btn"><header data-part="heading"><strong>보고서 배포</strong><p data-part="muted">가장 자주 쓰는 실행을 앞에 배치합니다.</p></header><div class="ku-actions ku-joined" data-part="actions joined"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn"><i data-part="icon" data-lucide="send" aria-hidden="true"></i> 지금 발송</button><details  data-part="details"><summary>추가 옵션</summary><div><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">예약 발송</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">초안 저장</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">미리 보기</button></div></div></details></div></div>
