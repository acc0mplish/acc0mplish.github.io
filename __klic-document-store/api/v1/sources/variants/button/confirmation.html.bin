<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/alert-dialog-destructive.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="button" data-kv-variant="confirmation" data-klic-component="button" class="kn-btn"><header data-part="heading"><strong>사용하지 않는 초안</strong><p data-part="muted">삭제를 누르면 확인 단계가 표시됩니다.</p></header><div data-kv-confirm><button type="button" data-klic-surface="control" data-kv-action="confirm"  data-part="btn"><i data-part="icon" data-lucide="trash-2" aria-hidden="true"></i> 초안 삭제</button><div hidden data-kv-confirm-panel><p data-part="muted">이 미리 보기의 초안을 삭제할까요?</p><button type="button" data-klic-surface="control" data-kv-action="confirmed"  data-part="btn">삭제 확인</button><button type="button" data-klic-surface="control" data-kv-action="cancel-confirm"  data-part="btn">취소</button></div><output aria-live="polite" data-part="output"></output></div></div>
