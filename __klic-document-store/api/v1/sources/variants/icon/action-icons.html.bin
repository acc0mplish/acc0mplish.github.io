<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-icon.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="icon" data-kv-variant="action-icons" data-klic-component="icon" class="kn-icon"><header data-part="heading"><strong>문서 도구</strong></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-label="검색" aria-pressed="false" title="검색" data-part="btn"><i data-part="icon" data-lucide="search" aria-hidden="true"></i><span data-part="sr-only">검색</span></button><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-label="보관" aria-pressed="false" title="보관" data-part="btn"><i data-part="icon" data-lucide="bookmark" aria-hidden="true"></i><span data-part="sr-only">보관</span></button><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-label="알림" aria-pressed="false" title="알림" data-part="btn"><i data-part="icon" data-lucide="bell" aria-hidden="true"></i><span data-part="sr-only">알림</span></button></div><p data-part="muted">아이콘 버튼은 이름과 누름 상태를 갖습니다.</p></div>
