<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-with-addons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="icon" data-kv-variant="input-context" data-klic-component="icon" class="kn-icon"><label data-part="field"><span>프로젝트 검색</span><span data-klic-surface="field" data-part="input-group"><i data-part="icon" data-lucide="search" aria-hidden="true"></i><input type="search" aria-label="프로젝트 검색" placeholder="프로젝트 이름" data-part="input"></span></label><label data-part="field"><span>이메일</span><span data-klic-surface="field" data-part="input-group"><i data-part="icon" data-lucide="mail" aria-hidden="true"></i><input type="email" aria-label="이메일" placeholder="name@example.com" data-part="input"></span></label></div>
