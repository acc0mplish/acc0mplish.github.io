<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/badge-icon.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="icon" data-kv-variant="status-icons" data-klic-component="icon" class="kn-icon"><div class="ku-row" data-part="row"><span><i data-part="icon" data-lucide="circle-check" aria-hidden="true"></i> 검토 완료</span><span><span data-part="badge">8건</span></span></div><div class="ku-row" data-part="row"><span><i data-part="icon" data-lucide="clock-3" aria-hidden="true"></i> 진행 중</span><span><span data-part="badge">3건</span></span></div><div class="ku-row" data-part="row"><span><i data-part="icon" data-lucide="triangle-alert" aria-hidden="true"></i> 확인 필요</span><span><span data-part="badge">1건</span></span></div></div>
