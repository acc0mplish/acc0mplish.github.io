<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/registry/new-york-v4/charts/chart-pie-donut-active.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="donut-chart" data-kv-variant="mini-multiples" data-klic-component="donut-chart" class="kn-donut-chart"><header data-part="heading"><strong>팀별 목표 달성</strong></header><div class="ku-grid-2" data-part="grid-2"><div class="ku-center" data-part="center"><div style="--kv-value:82" role="img" aria-label="디자인 82%" data-part="donut donut-small"><strong>82%</strong></div><strong>디자인</strong></div><div class="ku-center" data-part="center"><div style="--kv-value:64" role="img" aria-label="개발 64%" data-part="donut donut-small"><strong>64%</strong></div><strong>개발</strong></div></div></div>
