<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/spinner-badge.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="spinner" data-kv-variant="steps" data-klic-component="spinner" class="ku-spin kn-spinner"><header data-part="heading"><strong>파일 처리 중</strong></header><div class="ku-row" data-part="row"><span><i data-part="icon" data-lucide="circle-check" aria-hidden="true"></i> 파일 확인</span><span><span data-part="badge">완료</span></span></div><div class="ku-row" data-part="row"><span><span aria-hidden="true" class="ku-spin" data-part="spinner"></span> 내용 분석</span><span><span data-part="badge">진행 중</span></span></div><div class="ku-row" data-part="row"><span>결과 준비</span><span><span data-part="badge">대기</span></span></div></div>
