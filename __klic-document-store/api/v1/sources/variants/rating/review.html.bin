<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="rating" data-kv-variant="review" data-klic-component="rating" class="kn-rating"><form data-kv-form><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-rating-rating-review" value="1점" checked data-part="radio"><span><strong>1점</strong></span></label><label><input type="radio" name="kv-export-rating-rating-review" value="2점"  data-part="radio"><span><strong>2점</strong></span></label><label><input type="radio" name="kv-export-rating-rating-review" value="3점"  data-part="radio"><span><strong>3점</strong></span></label><label><input type="radio" name="kv-export-rating-rating-review" value="4점"  data-part="radio"><span><strong>4점</strong></span></label><label><input type="radio" name="kv-export-rating-rating-review" value="5점"  data-part="radio"><span><strong>5점</strong></span></label></fieldset><label data-part="field"><span>한 줄 리뷰</span><textarea rows="2" required placeholder="어떤 점이 좋았나요?" data-part="textarea"></textarea></label><button type="submit" class="kv-primary" data-part="btn">리뷰 등록</button><output aria-live="polite" data-part="output"></output></form></div>
