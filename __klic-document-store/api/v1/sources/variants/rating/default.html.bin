<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="rating" class="kn-rating"><fieldset data-part="rating"><legend>사용 경험 평가</legend><label><input type="radio" name="export-rating-default-choice" value="1"  data-choice data-part="radio"><span >★<span data-part="visually-hidden" class="ku-visually-hidden">1점</span></span></label><label><input type="radio" name="export-rating-default-choice" value="2" checked data-choice data-part="radio"><span >★<span data-part="visually-hidden" class="ku-visually-hidden">2점</span></span></label><label><input type="radio" name="export-rating-default-choice" value="3"  data-choice data-part="radio"><span >★<span data-part="visually-hidden" class="ku-visually-hidden">3점</span></span></label><label><input type="radio" name="export-rating-default-choice" value="4"  data-choice data-part="radio"><span >★<span data-part="visually-hidden" class="ku-visually-hidden">4점</span></span></label><label><input type="radio" name="export-rating-default-choice" value="5"  data-choice data-part="radio"><span >★<span data-part="visually-hidden" class="ku-visually-hidden">5점</span></span></label></fieldset><p data-choice-result data-part="hint">선택: 2</p></div>
