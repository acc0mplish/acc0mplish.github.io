<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/command-groups.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="command" data-kv-variant="project-switch" data-klic-component="command" class="kn-command"><header data-part="heading"><strong>프로젝트로 이동</strong></header><input type="search" data-kv-filter placeholder="프로젝트 검색" aria-label="프로젝트 검색" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 웹 리뉴얼</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 디자인 시스템</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 분석 대시보드</button></div><output aria-live="polite" data-part="output"></output></div>
