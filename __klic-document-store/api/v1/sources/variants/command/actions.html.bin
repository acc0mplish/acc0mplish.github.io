<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/command-shortcuts.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="command" data-kv-variant="actions" data-klic-component="command" class="kn-command"><header data-part="heading"><strong>빠른 실행</strong></header><input type="search" data-kv-filter placeholder="명령 검색" aria-label="명령 검색" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">새 문서 만들기<kbd>1</kbd></button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">멤버 초대<kbd>2</kbd></button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">워크스페이스 설정<kbd>3</kbd></button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">도움말 열기<kbd>4</kbd></button></div><output aria-live="polite" data-part="output"></output></div>
