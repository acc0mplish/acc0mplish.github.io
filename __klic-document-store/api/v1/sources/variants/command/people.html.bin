<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/command-demo.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="command" data-kv-variant="people" data-klic-component="command" class="kn-command"><header data-part="heading"><strong>팀원 찾기</strong></header><input type="search" data-kv-filter aria-label="팀원 검색" placeholder="이름 또는 직무" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><span aria-label="김" data-part="avatar">김</span> 김하늘 · 디자인</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><span aria-label="이" data-part="avatar">이</span> 이도윤 · 개발</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><span aria-label="박" data-part="avatar">박</span> 박서연 · 리서치</button></div><output aria-live="polite" data-part="output"></output></div>
