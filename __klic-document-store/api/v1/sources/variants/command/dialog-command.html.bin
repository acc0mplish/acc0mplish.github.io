<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/command-dialog.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="command" data-kv-variant="dialog-command" data-klic-component="command" class="kn-command"><header data-part="heading"><strong>어디로 이동할까요?</strong></header><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-command-command-dialog-command-dialog" data-part="btn">검색 열기</button><dialog id="kv-export-command-command-dialog-command-dialog" aria-label="문서 검색" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>문서 검색</strong></header><input type="search" data-kv-filter aria-label="문서 검색" placeholder="문서 제목" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">브랜드 가이드</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">토큰 사양</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn">접근성 기준</button></div><output aria-live="polite" data-part="output"></output><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
