<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/dropdown-menu-checkboxes-icons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="dropdown-menu" data-kv-variant="checks" data-klic-component="dropdown-menu" class="kn-dropdown-menu"><header data-part="heading"><strong>프로젝트 목록</strong></header><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-dropdown-menu-dropdown-menu-checks-popover" aria-haspopup="menu" data-part="btn">표시할 정보</button><div data-klic-surface="overlay" id="kv-export-dropdown-menu-dropdown-menu-checks-popover" role="menu" data-kv-context-menu aria-label="표시할 정보" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">담당자</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">마감일</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">진행률</button></div></div><output aria-live="polite" data-part="output"></output></div>
