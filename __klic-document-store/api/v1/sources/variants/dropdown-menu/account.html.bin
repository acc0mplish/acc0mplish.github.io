<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/dropdown-menu-avatar.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="dropdown-menu" data-kv-variant="account" data-klic-component="dropdown-menu" class="kn-dropdown-menu"><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-dropdown-menu-dropdown-menu-account-popover" aria-haspopup="menu" data-part="btn"><span aria-label="김" data-part="avatar">김</span> 김하늘</button><div data-klic-surface="overlay" id="kv-export-dropdown-menu-dropdown-menu-account-popover" role="menu" data-kv-context-menu aria-label="김 김하늘" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><header data-part="heading"><strong>김하늘</strong><p data-part="muted">haneul@example.com</p></header><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">프로필 편집 준비</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">알림 설정</button><button type="button" role="menuitem" data-kv-action="copy-text" data-kv-value="klic-user-haneul" data-part="btn">계정 식별자 복사</button></div></div><output aria-live="polite" data-part="output"></output></div>
