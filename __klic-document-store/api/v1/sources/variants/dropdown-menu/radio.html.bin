<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/dropdown-menu-radio-icons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="dropdown-menu" data-kv-variant="radio" data-klic-component="dropdown-menu" class="kn-dropdown-menu"><header data-part="heading"><strong>최근 문서</strong></header><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-dropdown-menu-dropdown-menu-radio-popover" aria-haspopup="menu" data-part="btn">정렬 기준</button><div data-klic-surface="overlay" id="kv-export-dropdown-menu-dropdown-menu-radio-popover" role="menu" data-kv-context-menu aria-label="정렬 기준" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><button type="button" role="menuitemradio" aria-checked="true" data-kv-action="context-radio" data-part="btn">최근 수정순</button><button type="button" role="menuitemradio" aria-checked="false" data-kv-action="context-radio" data-part="btn">이름순</button><button type="button" role="menuitemradio" aria-checked="false" data-kv-action="context-radio" data-part="btn">생성일순</button></div></div><output aria-live="polite" data-part="output"></output></div>
