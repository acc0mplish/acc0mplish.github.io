<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="dropdown-menu" class="kn-dropdown-menu"><button type="button" popovertarget="export-dropdown-menu-default-popup" data-part="btn" class="kv-neutral kv-sm">프로젝트 옵션 <i data-part="icon" data-lucide="chevron-down" aria-hidden="true"></i></button><div popover="auto" id="export-dropdown-menu-default-popup" data-part="popover" data-state="closed"><button type="button" data-cmp-action="menu-choice" data-name="이름 변경" data-part="btn" class="kv-neutral kv-sm">이름 변경</button><button type="button" data-cmp-action="menu-choice" data-name="복제하기" data-part="btn" class="kv-neutral kv-sm">복제하기</button><button type="button" data-cmp-action="menu-choice" data-name="링크 확인" data-part="btn" class="kv-neutral kv-sm">링크 확인</button></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
