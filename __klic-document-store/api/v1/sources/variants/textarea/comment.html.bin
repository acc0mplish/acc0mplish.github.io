<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-textarea.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="textarea" data-kv-variant="comment" data-klic-component="textarea" class="kn-textarea"><div class="ku-row" data-part="row"><span><span aria-label="나" data-part="avatar">나</span> <strong>김하늘</strong></span><span><span data-part="badge">팀 멤버</span></span></div><form data-kv-form><label data-part="field"><span>댓글</span><textarea required rows="3" placeholder="의견을 남겨보세요." data-part="textarea"></textarea></label><button type="submit" class="kv-primary" data-part="btn">댓글 등록</button><output aria-live="polite" data-part="output"></output></form></div>
