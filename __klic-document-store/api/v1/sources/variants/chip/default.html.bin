<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="chip" class="kn-chip"><p data-part="label">선택한 필터</p><div data-part="chip-list"><span data-part="chip">진행 중<button type="button" data-cmp-action="remove-chip" aria-label="진행 중 제거" data-part="btn">×</button></span><span data-part="chip">담당: 김하늘<button type="button" data-cmp-action="remove-chip" aria-label="담당: 김하늘 제거" data-part="btn">×</button></span><span data-part="chip">이번 주<button type="button" data-cmp-action="remove-chip" aria-label="이번 주 제거" data-part="btn">×</button></span></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
