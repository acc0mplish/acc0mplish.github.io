<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="popover" data-kv-variant="preferences" data-klic-component="popover" class="kn-popover" data-state="closed"><header data-part="heading"><strong>읽기 환경</strong></header><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-popover-popover-preferences-popover"  data-part="btn">화면 설정</button><div data-klic-surface="overlay" id="kv-export-popover-popover-preferences-popover" role="region" aria-label="화면 설정" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-popover-popover-preferences" value="문서 개요 표시" checked data-part="checkbox"><span><strong>문서 개요 표시</strong></span></label><label><input type="checkbox" name="kv-export-popover-popover-preferences" value="댓글 표시"  data-part="checkbox"><span><strong>댓글 표시</strong></span></label></fieldset><label data-part="field"><span>글자 크기</span><input type="range" value="100" min="80" max="130" data-kv-range data-part="slider"><output>100</output></label><button type="button" data-klic-surface="control" data-kv-action="popover-close"  data-part="btn">닫기</button></div></div><output aria-live="polite" data-part="output"></output></div>
