<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="popover" class="kn-popover" data-state="closed"><div data-part="popover-anchor"><button data-action="popover" aria-controls="export-popover-default-popover" aria-expanded="false" class="kv-neutral" data-part="btn"><i data-part="icon" data-lucide="sliders-horizontal"></i> 프로젝트 옵션 <i data-part="icon" data-lucide="chevron-down"></i></button><div popover="auto" id="export-popover-default-popover" data-part="popover-menu" data-state="closed"><button data-action="popover-choice" data-choice="프로젝트 이름 변경" data-part="btn"><i data-part="icon" data-lucide="pencil"></i> 이름 변경</button><button data-action="popover-choice" data-choice="링크 복사" data-part="btn"><i data-part="icon" data-lucide="copy"></i> 링크 복사</button><button data-action="popover-choice" data-choice="보관하기" data-part="btn"><i data-part="icon" data-lucide="archive"></i> 보관하기</button></div></div><span>클릭해서 옵션을 열어보세요.</span></div>
