<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/popover-form.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="popover" data-kv-variant="dimensions" data-klic-component="popover" class="kn-popover" data-state="closed"><header data-part="heading"><strong>캔버스 크기</strong></header><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-popover-popover-dimensions-popover"  data-part="btn">크기 설정</button><div data-klic-surface="overlay" id="kv-export-popover-popover-dimensions-popover" role="region" aria-label="크기 설정" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><header data-part="heading"><strong>크기</strong></header><div class="ku-grid-2" data-part="grid-2"><label data-part="field"><span>너비</span><input type="number" value="1280" min="1" data-part="input"></label><label data-part="field"><span>높이</span><input type="number" value="720" min="1" data-part="input"></label></div><button type="button" data-klic-surface="control" data-kv-action="popover-close"  data-part="btn">닫기</button></div></div><output aria-live="polite" data-part="output"></output></div>
