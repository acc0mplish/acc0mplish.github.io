<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-inline.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="field" data-kv-variant="horizontal" data-klic-component="field" class="kn-field"><form data-kv-form><div data-part="horizontal-field"><header data-part="heading"><strong>표시 이름</strong><p data-part="muted">팀에서 보이는 이름입니다.</p></header><label data-part="field"><span>표시 이름</span><input type="text" value="김하늘" required data-part="input"></label></div><button type="submit" class="kv-primary" data-part="btn">저장</button><output aria-live="polite" data-part="output"></output></form></div>
