<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="form" class="kn-form"><form data-component-form><div data-part="field"><label for="export-form-default-name" data-part="label">프로젝트 이름</label><input id="export-form-default-name" name="project" required maxlength="60" placeholder="프로젝트 이름" data-part="input"></div><div data-part="field"><label for="export-form-default-email" data-part="label">담당자 이메일</label><input id="export-form-default-email" name="email" type="email" required placeholder="team@example.com" data-part="input"></div><button type="submit" data-part="btn" class="kv-sm">입력 확인</button><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></form></div>
