<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/field-textarea.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="form" data-kv-variant="contact" data-klic-component="form" class="kn-form"><form data-kv-form><label data-part="field"><span>회신 이메일</span><input type="email" value="" required placeholder="name@company.com" data-part="input"></label><label data-part="field"><span>문의 유형</span><select data-part="select"><option>서비스 도입</option><option>기술 지원</option><option>파트너십</option></select></label><label data-part="field"><span>문의 내용</span><textarea rows="3" required data-part="textarea"></textarea></label><button type="submit" class="kv-primary" data-part="btn">문의 준비</button><output aria-live="polite" data-part="output"></output></form></div>
