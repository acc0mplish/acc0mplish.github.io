<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="color-picker" data-kv-variant="overlay" data-klic-component="color-picker" class="kn-color-picker"><div data-part="color-cover"><div role="img" aria-label="새로운 시선" data-part="art"><span>KLIC</span><strong>새로운 시선</strong><span data-part="art-orbit"></span></div><span data-kv-color-preview data-part="color-cover-layer"></span></div><label data-part="field"><span>레이어 색상</span><input type="color" value="#245fc2" data-kv-color-target="overlay" data-part="input"></label><label data-part="field"><span>불투명도 (%)</span><input type="range" value="35" min="0" max="80" data-kv-color-alpha data-part="slider"></label><output data-kv-color-output aria-live="polite" data-part="output">레이어 색상 #245fc2 · 35%</output></div>
