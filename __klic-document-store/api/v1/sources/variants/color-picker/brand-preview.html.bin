<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="color-picker" data-kv-variant="brand-preview" data-klic-component="color-picker" class="kn-color-picker"><header data-part="heading"><strong>브랜드 포인트</strong></header><div data-kv-color-preview data-part="color-preview">KLIC<br><strong>새로운 연결</strong></div><label data-part="field"><span>포인트 색상</span><input type="color" value="#245fc2" data-kv-color-target="preview" data-part="input"></label><output data-kv-color-output aria-live="polite" data-part="output">#245fc2</output></div>
