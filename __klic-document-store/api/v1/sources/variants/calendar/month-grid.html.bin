<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/calendar-multiple.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="calendar" data-kv-variant="month-grid" data-klic-component="calendar" class="kn-calendar"><header data-part="heading"><strong>2026년 10월</strong><p data-part="muted">월 · 화 · 수 · 목 · 금 · 토 · 일</p></header><div data-part="calendar"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">1</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">2</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">3</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">4</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">5</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">6</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">7</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">8<small>●</small></button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">9</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">10</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">11</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">12</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">13</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">14</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">15</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">16<small>●</small></button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">17</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">18</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">19</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">20</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">21</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">22</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">23</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">24</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">25</button><button type="button" data-kv-action="calendar-day" aria-pressed="true" data-part="btn" data-state="selected">26<small>●</small></button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">27</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">28</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">29</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">30</button><button type="button" data-kv-action="calendar-day" aria-pressed="false"  data-part="btn">31</button></div><output aria-live="polite" data-part="output">10월 26일 선택</output></div>
