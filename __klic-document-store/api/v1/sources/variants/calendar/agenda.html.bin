<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-header.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="calendar" data-kv-variant="agenda" data-klic-component="calendar" class="kn-calendar"><header data-part="heading"><strong>10월 26일 · 월요일</strong></header><ul data-part="list"><li><span data-part="badge">09:30</span> 디자인 리뷰 · 회의실 A</li><li><span data-part="badge">14:00</span> 개발 동기화 · 온라인</li><li><span data-part="badge">16:30</span> 리서치 공유 · 회의실 B</li></ul><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-calendar-calendar-agenda-dialog" data-part="btn">일정 추가</button><dialog id="kv-export-calendar-calendar-agenda-dialog" aria-label="새 일정" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>새 일정</strong></header><form data-kv-form><label data-part="field"><span>제목</span><input type="text" value="" required data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">일정 추가</button><output aria-live="polite" data-part="output"></output></form><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></div>
