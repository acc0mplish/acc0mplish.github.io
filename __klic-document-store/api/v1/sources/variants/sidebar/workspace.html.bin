<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/sidebar-header.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="sidebar" data-kv-variant="workspace" data-klic-component="sidebar" class="kn-sidebar"><aside data-part="sidebar"><header data-part="heading"><strong>KLIC 팀</strong><p data-part="muted">프로덕트 워크스페이스</p></header><nav aria-label="예제 탐색" data-part="nav"><button type="button" data-kv-action="nav" aria-current="page" data-part="btn">개요</button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn">내 작업</button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn">팀 문서</button></nav><output aria-live="polite" data-part="output">개요</output><details open data-part="details"><summary>프로젝트</summary><div><ul data-part="list"><li>디자인 시스템</li><li>웹 리뉴얼</li></ul></div></details><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span></span><span>김하늘 · 관리자</span></div></aside></div>
