<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="progress" data-kv-variant="upload-control" data-klic-component="progress" class="kn-progress"><header data-part="heading"><strong>파일 처리 시뮬레이션</strong></header><div data-kv-progress><label data-part="progress-label">처리 중<span>25%</span><progress max="100" value="25">25%</progress></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="progress-next"  data-part="btn">진행 +25%</button><button type="button" data-klic-surface="control" data-kv-action="progress-reset"  data-part="btn">처음부터</button></div><output aria-live="polite" data-part="output">25% 완료</output></div></div>
