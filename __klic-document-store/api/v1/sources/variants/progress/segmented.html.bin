<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="progress" data-kv-variant="segmented" data-klic-component="progress" class="kn-progress"><header data-part="heading"><strong>릴리스 준비</strong></header><label data-part="progress-label">기획<span>100%</span><progress max="100" value="100">100%</progress></label><label data-part="progress-label">디자인<span>80%</span><progress max="100" value="80">80%</progress></label><label data-part="progress-label">개발<span>45%</span><progress max="100" value="45">45%</progress></label></div>
