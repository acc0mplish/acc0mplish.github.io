<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/avatar-group-count.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="avatar" data-kv-variant="stacked" data-klic-component="avatar" class="kn-avatar"><header data-part="heading"><strong>프로젝트 담당자</strong></header><div data-part="avatar-stack"><span aria-label="김" data-part="avatar">김</span><span aria-label="이" data-part="avatar">이</span><span aria-label="박" data-part="avatar">박</span><span aria-label="최" data-part="avatar">최</span><span data-part="avatar">+3</span></div><p data-part="muted">김하늘 외 6명이 작업 중입니다.</p></div>
