<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/field-input.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="avatar" data-kv-variant="editable" data-klic-component="avatar" class="kn-avatar"><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span></span><span><p data-part="muted">프로필의 이름 첫 글자를 표시합니다.</p></span></div><form data-kv-form><label data-part="field"><span>표시 이름</span><input type="text" value="김하늘" required data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">프로필 적용</button><output aria-live="polite" data-part="output"></output></form></div>
