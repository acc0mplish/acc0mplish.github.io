<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/avatar-dropdown.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="avatar" data-kv-variant="menu" data-klic-component="avatar" class="kn-avatar"><details open data-part="details"><summary><span aria-label="김" data-part="avatar">김</span> 내 계정</summary><div><header data-part="heading"><strong>김하늘</strong><p data-part="muted">haneul@example.com</p></header><details  data-part="details"><summary>계정 작업</summary><div><div data-part="menu"><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">프로필 편집</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">알림 설정</button><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">워크스페이스 전환</button></div></div></details></div></details></div>
