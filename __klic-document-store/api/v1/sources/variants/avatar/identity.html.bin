<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/avatar-badge-icon.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="avatar" data-kv-variant="identity" data-klic-component="avatar" class="kn-avatar"><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span></span><span><header data-part="heading"><strong>김하늘</strong><p data-part="muted">프로덕트 디자이너</p></header></span></div><span data-part="badge">● 업무 중</span><p data-part="muted">제품 디자인 · 서울</p></div>
