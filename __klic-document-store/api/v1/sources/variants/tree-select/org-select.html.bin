<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tree-select" data-kv-variant="org-select" data-klic-component="tree-select" class="kn-tree-select"><header data-part="heading"><strong>검토 담당자</strong></header><details open data-part="details"><summary>제품 조직</summary><div><details open data-part="details"><summary>디자인 팀</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-select-tree-select-org-select" value="김하늘 · 디자인" checked data-part="radio"><span><strong>김하늘 · 디자인</strong></span></label><label><input type="radio" name="kv-export-tree-select-tree-select-org-select" value="박서연 · 리서치"  data-part="radio"><span><strong>박서연 · 리서치</strong></span></label></fieldset></div></details><details  data-part="details"><summary>개발 팀</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-select-tree-select-org-select" value="이도윤 · 프론트엔드" data-part="radio"><span><strong>이도윤 · 프론트엔드</strong></span></label><label><input type="radio" name="kv-export-tree-select-tree-select-org-select" value="최지우 · 백엔드"  data-part="radio"><span><strong>최지우 · 백엔드</strong></span></label></fieldset></div></details></div></details><output data-kv-selection aria-live="polite" data-part="output">김하늘 선택됨</output></div>
