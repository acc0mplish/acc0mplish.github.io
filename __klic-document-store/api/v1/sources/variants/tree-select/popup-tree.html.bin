<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tree-select" data-kv-variant="popup-tree" data-klic-component="tree-select" class="kn-tree-select"><header data-part="heading"><strong>문서 이동</strong></header><div data-part="popover-wrap"><button type="button" data-klic-surface="control" data-kv-action="popover-open" aria-expanded="false" aria-controls="kv-export-tree-select-tree-select-popup-tree-popover"  data-part="btn">대상 폴더 선택</button><div data-klic-surface="overlay" id="kv-export-tree-select-tree-select-popup-tree-popover" role="region" aria-label="대상 폴더 선택" data-kv-floating popover="manual" hidden data-part="floating-panel" data-state="closed"><details open data-part="details"><summary><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 제품 문서</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-select-tree-select-popup-tree" value="기획 문서" checked data-part="radio"><span><strong>기획 문서</strong></span></label><label><input type="radio" name="kv-export-tree-select-tree-select-popup-tree" value="디자인 문서"  data-part="radio"><span><strong>디자인 문서</strong></span></label><label><input type="radio" name="kv-export-tree-select-tree-select-popup-tree" value="개발 문서"  data-part="radio"><span><strong>개발 문서</strong></span></label></fieldset></div></details><details  data-part="details"><summary><i data-part="icon" data-lucide="folder" aria-hidden="true"></i> 운영 문서</summary><div><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-tree-select-tree-select-popup-tree" value="운영 매뉴얼" data-part="radio"><span><strong>운영 매뉴얼</strong></span></label><label><input type="radio" name="kv-export-tree-select-tree-select-popup-tree" value="고객 가이드"  data-part="radio"><span><strong>고객 가이드</strong></span></label></fieldset></div></details><output data-kv-selection aria-live="polite" data-part="output">기획 문서 선택됨</output><button type="button" data-klic-surface="control" data-kv-action="popover-close"  data-part="btn">닫기</button></div></div><output aria-live="polite" data-part="output"></output></div>
