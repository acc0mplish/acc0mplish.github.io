<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/calendar-range.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="date-picker" data-kv-variant="bounds" data-klic-component="date-picker" class="kn-date-picker"><form data-kv-form data-kv-date-range><div class="ku-grid-2" data-part="grid-2"><label data-part="field"><span>시작</span><input type="date" value="2026-10-26" required data-kv-start data-part="input"></label><label data-part="field"><span>종료</span><input type="date" value="2026-10-30" required data-kv-end data-part="input"></label></div><button type="submit" class="kv-primary" data-part="btn">구간 확인</button><output aria-live="polite" data-part="output"></output></form></div>
