<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/combobox-groups.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="multi-select" data-kv-variant="searchable" data-klic-component="multi-select" class="kn-multi-select"><header data-part="heading"><strong>담당자 선택</strong></header><input type="search" data-kv-filter aria-label="담당자 검색" placeholder="담당자 검색" data-part="input"><div data-part="multi-list"><label data-kv-filter-item><input type="checkbox" value="김하늘 · 디자인" data-part="checkbox"><span aria-label="김" data-part="avatar">김</span><span>김하늘 · 디자인</span></label><label data-kv-filter-item><input type="checkbox" value="이도윤 · 개발" data-part="checkbox"><span aria-label="이" data-part="avatar">이</span><span>이도윤 · 개발</span></label><label data-kv-filter-item><input type="checkbox" value="박서연 · 리서치" data-part="checkbox"><span aria-label="박" data-part="avatar">박</span><span>박서연 · 리서치</span></label><label data-kv-filter-item><input type="checkbox" value="최지우 · 운영" data-part="checkbox"><span aria-label="최" data-part="avatar">최</span><span>최지우 · 운영</span></label></div><output data-kv-selection aria-live="polite" data-part="output">선택한 담당자가 없습니다.</output></div>
