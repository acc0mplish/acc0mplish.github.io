<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="multi-select" class="kn-multi-select"><details data-part="dropdown"><summary>참여 팀 선택 <span data-selected-count>0</span></summary><div data-part="option-list"><label><input type="checkbox" data-multi value="디자인" data-part="checkbox"> 디자인</label><label><input type="checkbox" data-multi value="개발" data-part="checkbox"> 개발</label><label><input type="checkbox" data-multi value="기획" data-part="checkbox"> 기획</label><label><input type="checkbox" data-multi value="운영" data-part="checkbox"> 운영</label></div></details><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
