<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="multi-select" data-kv-variant="grouped-picker" data-klic-component="multi-select" class="kn-multi-select"><header data-part="heading"><strong>알림 수신 채널</strong></header><details open data-part="details"><summary>실시간 알림</summary><div><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-multi-select-multi-select-grouped-picker" value="브라우저" checked data-part="checkbox"><span><strong>브라우저</strong></span></label><label><input type="checkbox" name="kv-export-multi-select-multi-select-grouped-picker" value="앱 푸시"  data-part="checkbox"><span><strong>앱 푸시</strong></span></label></fieldset></div></details><details  data-part="details"><summary>요약 알림</summary><div><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-multi-select-multi-select-grouped-picker-digest" value="이메일 요약" checked data-part="checkbox"><span><strong>이메일 요약</strong></span></label><label><input type="checkbox" name="kv-export-multi-select-multi-select-grouped-picker-digest" value="주간 리포트"  data-part="checkbox"><span><strong>주간 리포트</strong></span></label></fieldset></div></details><output data-kv-selection aria-live="polite" data-part="output"></output></div>
