<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-inline.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="password-input" data-kv-variant="signin" data-klic-component="password-input" class="kn-password-input"><form data-kv-form><label data-part="field"><span>이메일</span><input type="email" value="" required autocomplete="username" data-part="input"></label><label data-part="field"><span>비밀번호</span><input type="password" value="" required autocomplete="current-password" data-part="input"></label><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-password-input-password-input-signin" value="로그인 상태 유지" checked data-part="checkbox"><span><strong>로그인 상태 유지</strong></span></label></fieldset><button type="submit" class="kv-primary" data-part="btn">입력 확인</button><output aria-live="polite" data-part="output"></output></form></div>
