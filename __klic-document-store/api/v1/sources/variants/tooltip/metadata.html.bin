<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tooltip" data-kv-variant="metadata" data-klic-component="tooltip" class="kn-tooltip"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>브랜드 가이드.pdf</strong></header><p data-part="muted">팀에서 사용하는 최신 브랜드 규칙</p></section><span data-part="tooltip-wrap"><button type="button" data-klic-surface="control" aria-describedby="kv-export-tooltip-tooltip-metadata-tip" data-kv-tip-trigger data-part="btn"><i data-part="icon" data-lucide="file-text" aria-hidden="true"></i> 파일 정보</button><span popover="manual" role="tooltip" id="kv-export-tooltip-tooltip-metadata-tip" data-part="tooltip" data-state="closed">PDF 문서 · 2.4 MB · 2026년 10월 26일 수정</span></span></div>
