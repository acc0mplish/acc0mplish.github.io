<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/tooltip-keyboard.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="tooltip" data-kv-variant="shortcut" data-klic-component="tooltip" class="kn-tooltip"><header data-part="heading"><strong>빠른 검색</strong><p data-part="muted">버튼에 포인터를 올리거나 Tab으로 초점을 이동하세요.</p></header><span data-part="tooltip-wrap"><button type="button" data-klic-surface="control" aria-describedby="kv-export-tooltip-tooltip-shortcut-tip" data-kv-tip-trigger data-part="btn"><i data-part="icon" data-lucide="search" aria-hidden="true"></i> 검색 도움말</button><span popover="manual" role="tooltip" id="kv-export-tooltip-tooltip-shortcut-tip" data-part="tooltip" data-state="closed">빠른 검색을 여는 단축키는 ⌘ + K입니다.</span></span></div>
