<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="pagination" data-kv-variant="compact" data-klic-component="pagination" class="kn-pagination"><div data-kv-pagination data-kv-page-current="1"><header data-part="heading"><strong>검토 요청</strong></header><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>요청 목록</strong></header><div data-kv-page-content>요청 1 · 컴포넌트 리뷰</div></section><nav aria-label="검토 페이지" class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="page-prev"  data-part="btn">이전</button><output aria-live="polite" data-part="output">1 / 3 페이지</output><button type="button" data-klic-surface="control" data-kv-action="page-next"  data-part="btn">다음</button></nav></div></div>
