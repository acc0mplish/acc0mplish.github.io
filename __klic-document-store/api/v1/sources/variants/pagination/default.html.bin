<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="pagination" class="kn-pagination"><ul data-page-items data-part="page-items"><li>디자인 시스템</li><li>브랜드 리뉴얼</li></ul><nav aria-label="프로젝트 페이지" data-page="1" data-part="button-row" class="ku-button-row"><button type="button" data-cmp-action="page-prev" disabled aria-label="이전 페이지" data-part="btn" class="kv-neutral kv-sm">‹</button><button type="button" data-cmp-action="page" data-page-number="1" aria-current="page" data-part="btn" class="kv-neutral kv-sm">1</button><button type="button" data-cmp-action="page" data-page-number="2"  data-part="btn" class="kv-neutral kv-sm">2</button><button type="button" data-cmp-action="page" data-page-number="3"  data-part="btn" class="kv-neutral kv-sm">3</button><button type="button" data-cmp-action="page-next" aria-label="다음 페이지" data-part="btn" class="kv-neutral kv-sm">›</button></nav><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
