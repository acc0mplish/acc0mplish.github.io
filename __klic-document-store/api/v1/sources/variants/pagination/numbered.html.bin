<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="pagination" data-kv-variant="numbered" data-klic-component="pagination" class="kn-pagination"><div data-kv-pagination><header data-part="heading"><strong>문서 목록</strong></header><ul data-kv-page-content data-part="list"><li>문서 1 · 브랜드 가이드</li><li>문서 2 · 디자인 토큰</li></ul><nav aria-label="문서 페이지" class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="1" aria-current="page" data-part="btn">1</button><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="2" aria-current="false" data-part="btn">2</button><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="3" aria-current="false" data-part="btn">3</button></nav><output aria-live="polite" data-part="output">1 / 3 페이지</output></div></div>
