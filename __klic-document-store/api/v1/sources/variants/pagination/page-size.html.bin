<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="pagination" data-kv-variant="page-size" data-klic-component="pagination" class="kn-pagination"><div data-kv-pagination><label data-part="field"><span>페이지당 항목</span><select data-kv-page-size data-part="select"><option>2개</option><option>5개</option><option>10개</option></select></label><ul data-kv-page-content data-part="list"><li>항목 1</li><li>항목 2</li></ul><nav aria-label="항목 페이지" class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="1" aria-current="page" data-part="btn">1</button><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="2" aria-current="false" data-part="btn">2</button><button type="button" data-klic-surface="control" data-kv-action="page" data-kv-page="3" aria-current="false" data-part="btn">3</button></nav><output aria-live="polite" data-part="output">1 / 3 페이지</output></div></div>
