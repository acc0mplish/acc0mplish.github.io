<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="pagination" data-kv-variant="load-more" data-klic-component="pagination" class="kn-pagination"><header data-part="heading"><strong>최근 활동</strong></header><ul data-kv-more-list data-part="list"><li>김하늘 · 문서 업데이트</li><li>이도윤 · 리뷰 요청</li></ul><button type="button" data-klic-surface="control" data-kv-action="load-more"  data-part="btn">활동 더 보기</button></div>
