<section data-terminal-demo="powershell-terminal" data-terminal-instance="export-powershell-terminal-default" aria-label="Windows PowerShell 터미널 샘플 미리보기" data-klic-component="powershell-terminal" class="kn-powershell-terminal"><div data-part="terminal-windows">
