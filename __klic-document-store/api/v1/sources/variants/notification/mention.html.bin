<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-avatar.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="notification" data-kv-variant="mention" data-klic-component="notification" class="kn-notification"><article data-part="notification"><div class="ku-row" data-part="row"><span><span aria-label="박" data-part="avatar">박</span> <strong>박서연</strong></span><span><span data-part="badge">새 알림</span></span></div><p data-part="muted">컴포넌트 리뷰에서 나를 언급했습니다.</p><blockquote data-klic-surface="card" data-part="panel">@김하늘 새로운 입력 필드를 검토해 주세요.</blockquote><button type="button" data-klic-surface="control" data-kv-action="notification-read"  data-part="btn">읽음 표시</button><output aria-live="polite" data-part="output"></output></article></div>
