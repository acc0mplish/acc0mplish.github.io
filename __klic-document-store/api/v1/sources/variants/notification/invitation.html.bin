<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="notification" data-kv-variant="invitation" data-klic-component="notification" class="kn-notification"><article data-part="notification"><div class="ku-row" data-part="row"><span><span aria-label="김" data-part="avatar">김</span> 김하늘</span><span><p data-part="muted">방금 전</p></span></div><header data-part="heading"><strong>제품 디자인 팀 초대</strong><p data-part="muted">김하늘님이 함께 작업하도록 초대했습니다.</p></header><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="invitation" data-kv-answer="초대를 수락했습니다." data-part="btn">수락</button><button type="button" data-klic-surface="control" data-kv-action="invitation" data-kv-answer="초대를 거절했습니다." data-part="btn">거절</button></div><output aria-live="polite" data-part="output"></output></article></div>
