<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="slider" class="kn-slider"><label for="export-slider-default-range" data-part="label">작업 진행률</label><input id="export-slider-default-range" type="range" min="0" max="100" step="5" value="65" data-range-value data-part="slider"><output data-range-output data-part="number">65%</output></div>
