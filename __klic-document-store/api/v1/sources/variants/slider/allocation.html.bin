<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/slider-multiple.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="slider" data-kv-variant="allocation" data-klic-component="slider" class="kn-slider"><header data-part="heading"><strong>저장 공간 배분</strong><p data-part="muted">10 GB 단위로 프로젝트 공간을 배분하세요.</p></header><label data-part="field"><span>저장 공간 (GB)</span><input type="range" min="10" max="100" step="10" value="40" data-kv-range data-part="slider"><output>40</output></label></div>
