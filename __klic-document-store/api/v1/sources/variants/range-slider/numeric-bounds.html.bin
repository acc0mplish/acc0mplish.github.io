<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-grid.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="range-slider" data-kv-variant="numeric-bounds" data-klic-component="range-slider" class="kn-range-slider"><div data-kv-range-pair><header data-part="heading"><strong>파일 크기 필터</strong><p data-part="muted">KB 단위의 구간을 지정하세요.</p></header><div class="ku-grid-2" data-part="grid-2"><label data-part="field"><span>최소 KB</span><input type="number" value="100" min="0" max="5000" data-kv-bound="min" data-part="input"></label><label data-part="field"><span>최대 KB</span><input type="number" value="2000" min="0" max="5000" data-kv-bound="max" data-part="input"></label></div><output aria-live="polite" data-part="output"></output></div></div>
