<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/slider/demos/marks/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="range-slider" data-kv-variant="duration" data-klic-component="range-slider" class="kn-range-slider"><div data-kv-range-pair><header data-part="heading"><strong>집중 시간대</strong><p data-part="muted">09:00–18:00 · 하루의 작업 구간을 지정합니다.</p></header><div data-part="interval-track"><span>00</span><span data-kv-interval data-part="interval-selection"></span><span>24</span></div><div class="ku-row" data-part="row"><strong>시작 시각</strong><strong>종료 시각</strong></div><label data-part="field"><span>시작 시각</span><input type="range" min="0" max="24" value="9" data-kv-bound="min" data-part="slider"><output>9</output></label><label data-part="field"><span>종료 시각</span><input type="range" min="0" max="24" value="18" data-kv-bound="max" data-part="slider"><output>18</output></label></div></div>
