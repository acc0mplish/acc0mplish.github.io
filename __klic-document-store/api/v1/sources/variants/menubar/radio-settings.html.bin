<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/menubar-radio.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="menubar" data-kv-variant="radio-settings" data-klic-component="menubar" class="kn-menubar"><div role="menubar" aria-label="프로젝트 메뉴" data-part="menubar"><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-radio-settings-sort-menu" data-part="btn">정렬</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-radio-settings-sort-menu" role="menu" aria-label="정렬" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitemradio" aria-checked="true" data-kv-action="context-radio" data-part="btn">이름순</button><button type="button" role="menuitemradio" aria-checked="false" data-kv-action="context-radio" data-part="btn">수정일순</button><button type="button" role="menuitemradio" aria-checked="false" data-kv-action="context-radio" data-part="btn">생성일순</button></div></div><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-radio-settings-group-menu" data-part="btn">그룹</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-radio-settings-group-menu" role="menu" aria-label="그룹" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">팀별 묶기</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">상태별 묶기</button></div></div></div><ul data-part="list"><li>Atlas · 디자인 팀</li><li>Beacon · 개발 팀</li><li>Canvas · 운영 팀</li></ul><output aria-live="polite" data-part="output"></output></div>
