<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/menubar-icons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="menubar" data-kv-variant="icon-commands" data-klic-component="menubar" class="kn-menubar"><div role="menubar" aria-label="자료 메뉴" data-part="menubar"><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-icon-commands-data-menu" data-part="btn">자료</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-icon-commands-data-menu" role="menu" aria-label="자료" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn"><i data-part="icon" data-lucide="upload" aria-hidden="true"></i> 가져오기</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn"><i data-part="icon" data-lucide="download" aria-hidden="true"></i> 내보내기</button><button type="button" role="menuitem" data-kv-action="copy-text" data-kv-value="klic_project_2026" data-part="btn"><i data-part="icon" data-lucide="copy" aria-hidden="true"></i> 식별자 복사</button></div></div><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-icon-commands-share-menu" data-part="btn">공유</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-icon-commands-share-menu" role="menu" aria-label="공유" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="copy-text" data-kv-value="https://example.com/project" data-part="btn"><i data-part="icon" data-lucide="link" aria-hidden="true"></i> 링크 복사</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn"><i data-part="icon" data-lucide="users" aria-hidden="true"></i> 멤버 초대 준비</button></div></div></div><p data-part="muted">좌우 방향키로 메뉴 사이를 이동하고 Escape로 닫습니다.</p><output aria-live="polite" data-part="output"></output></div>
