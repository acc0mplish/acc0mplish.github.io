<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/menubar-submenu.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="menubar" data-kv-variant="document" data-klic-component="menubar" class="kn-menubar"><div role="menubar" aria-label="문서 메뉴" data-part="menubar"><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-document-file-menu" data-part="btn">파일</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-document-file-menu" role="menu" aria-label="파일" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">새 문서</button><button type="button" role="menuitem" data-kv-action="copy-text" data-kv-value="https://example.com/doc" data-part="btn">문서 링크 복사</button></div></div><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-document-edit-menu" data-part="btn">편집</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-document-edit-menu" role="menu" aria-label="편집" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">변경 검토</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">선택 해제</button></div></div><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-document-help-menu" data-part="btn">도움말</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-document-help-menu" role="menu" aria-label="도움말" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">사용 가이드</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">단축키 안내</button></div></div></div><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>브랜드 가이드</strong></header><p data-part="muted">메뉴를 열어 문서 작업을 선택하세요.</p></section><output aria-live="polite" data-part="output"></output></div>
