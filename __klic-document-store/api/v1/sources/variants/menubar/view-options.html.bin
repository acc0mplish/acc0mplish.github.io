<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/menubar-checkbox.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="menubar" data-kv-variant="view-options" data-klic-component="menubar" class="kn-menubar"><div role="menubar" aria-label="화면 메뉴" data-part="menubar"><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-view-options-view-menu" data-part="btn">보기</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-view-options-view-menu" role="menu" aria-label="보기" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">도구 모음</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">상태 바</button><button type="button" role="menuitemcheckbox" aria-checked="false" data-kv-action="context-check" data-part="btn">문서 개요</button></div></div><div data-part="bar-item"><button type="button" role="menuitem" data-kv-action="menubar-open" aria-haspopup="menu" aria-expanded="false" aria-controls="kv-export-menubar-menubar-view-options-window-menu" data-part="btn">창</button><div data-klic-surface="overlay" id="kv-export-menubar-menubar-view-options-window-menu" role="menu" aria-label="창" data-kv-context-menu popover="manual" hidden data-part="bar-popup" data-state="closed"><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">전체 화면 안내</button><button type="button" role="menuitem" data-kv-action="choose"  data-part="btn">새 창 준비</button></div></div></div><header data-part="heading"><strong>편집 화면</strong><p data-part="muted">보기 메뉴에서 필요한 도구를 선택하세요.</p></header><output aria-live="polite" data-part="output"></output></div>
