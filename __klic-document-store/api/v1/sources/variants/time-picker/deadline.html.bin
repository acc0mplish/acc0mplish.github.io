<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="time-picker" data-kv-variant="deadline" data-klic-component="time-picker" class="kn-time-picker"><form data-kv-form><label data-part="field"><span>마감</span><input type="time" value="17:30" required data-part="input"></label><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-time-picker-time-picker-deadline" value="마감 전 알림 받기" checked data-part="checkbox"><span><strong>마감 전 알림 받기</strong></span></label></fieldset><p data-part="muted">작업 담당자에게 알려줄 시점을 정하세요.</p><button type="submit" class="kv-primary" data-part="btn">마감 저장</button><output aria-live="polite" data-part="output"></output></form></div>
