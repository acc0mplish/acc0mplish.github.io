<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="time-picker" data-kv-variant="availability" data-klic-component="time-picker" class="kn-time-picker"><form data-kv-form><header data-part="heading"><strong>상담 예약</strong></header><label data-part="field"><span>가능한 일정</span><input type="time" value="14:00" required data-part="input"></label><fieldset data-part="choices"><legend>한 가지 선택</legend><label><input type="radio" name="kv-export-time-picker-time-picker-availability" value="온라인 미팅" checked data-part="radio"><span><strong>온라인 미팅</strong></span></label><label><input type="radio" name="kv-export-time-picker-time-picker-availability" value="전화 상담"  data-part="radio"><span><strong>전화 상담</strong></span></label></fieldset><button type="submit" class="kv-primary" data-part="btn">가능 일정 준비</button><output aria-live="polite" data-part="output"></output></form></div>
