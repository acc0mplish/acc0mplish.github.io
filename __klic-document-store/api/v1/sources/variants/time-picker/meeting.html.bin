<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="time-picker" data-kv-variant="meeting" data-klic-component="time-picker" class="kn-time-picker"><form data-kv-form><header data-part="heading"><strong>팀 미팅</strong></header><label data-part="field"><span>시작 시각</span><input type="time" value="10:00" required data-part="input"></label><label data-part="field"><span>담당자</span><select data-part="select"><option>김하늘</option><option>이도윤</option><option>박서연</option></select></label><button type="submit" class="kv-primary" data-part="btn">일정 적용</button><output aria-live="polite" data-part="output"></output></form></div>
