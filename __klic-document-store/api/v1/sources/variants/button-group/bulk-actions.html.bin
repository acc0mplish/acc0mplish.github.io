<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-table.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="button-group" data-kv-variant="bulk-actions" data-klic-component="button-group" class="kn-button-group"><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-button-group-button-group-bulk-actions" value="디자인 가이드" checked data-part="checkbox"><span><strong>디자인 가이드</strong></span></label><label><input type="checkbox" name="kv-export-button-group-button-group-bulk-actions" value="운영 매뉴얼"  data-part="checkbox"><span><strong>운영 매뉴얼</strong></span></label></fieldset><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="selection-action"  data-part="btn">선택 항목 보관</button><button type="button" data-klic-surface="control" data-kv-action="uncheck"  data-part="btn">선택 해제</button></div><output aria-live="polite" data-part="output"></output></div>
