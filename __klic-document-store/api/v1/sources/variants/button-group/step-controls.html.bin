<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="button-group" data-kv-variant="step-controls" data-klic-component="button-group" class="kn-button-group"><div data-kv-stepper><header data-part="heading"><strong>워크스페이스 설정</strong></header><ol data-part="step-list"><li data-kv-step>기본 정보</li><li data-kv-step hidden>멤버 초대</li><li data-kv-step hidden>설정 검토</li></ol><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="step-prev"  data-part="btn">이전</button><button type="button" data-klic-surface="control" data-kv-action="step-next"  data-part="btn">다음</button></div><output aria-live="polite" data-part="output">1 / 3</output></div></div>
