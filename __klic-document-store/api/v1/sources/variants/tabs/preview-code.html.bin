<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/tabs-line.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="tabs" data-kv-variant="preview-code" data-klic-component="tabs" class="kn-tabs"><div data-part="tabs"><div role="tablist" aria-label="보기" ><button type="button" role="tab" id="kv-export-tabs-tabs-preview-code-tab-0" aria-controls="kv-export-tabs-tabs-preview-code-panel-0" aria-selected="true" tabindex="0" data-kv-action="tab" data-part="btn">미리 보기</button><button type="button" role="tab" id="kv-export-tabs-tabs-preview-code-tab-1" aria-controls="kv-export-tabs-tabs-preview-code-panel-1" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">HTML</button></div><section role="tabpanel" id="kv-export-tabs-tabs-preview-code-panel-0" aria-labelledby="kv-export-tabs-tabs-preview-code-tab-0" ><header data-part="heading"><strong>새 작업</strong></header><button type="button" data-klic-surface="control" data-kv-action="notice"  data-part="btn">저장</button></section><section role="tabpanel" id="kv-export-tabs-tabs-preview-code-panel-1" aria-labelledby="kv-export-tabs-tabs-preview-code-tab-1" hidden><pre data-part="code"><code>&lt;button type="button"&gt;저장&lt;/button&gt;</code></pre></section></div></div>
