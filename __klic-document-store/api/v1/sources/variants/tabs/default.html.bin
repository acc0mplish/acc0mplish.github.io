<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="tabs" class="kn-tabs"><div role="tablist" aria-label="프로젝트 보기" data-part="tabs"><button role="tab" id="export-tabs-default-tab-0" aria-controls="export-tabs-default-panel" aria-selected="true" tabindex="0" data-action="demo-tab" data-index="0" data-part="tab btn">개요</button><button role="tab" id="export-tabs-default-tab-1" aria-controls="export-tabs-default-panel" aria-selected="false" tabindex="-1" data-action="demo-tab" data-index="1" data-part="tab btn">활동</button><button role="tab" id="export-tabs-default-tab-2" aria-controls="export-tabs-default-panel" aria-selected="false" tabindex="-1" data-action="demo-tab" data-index="2" data-part="tab btn">설정</button></div><div id="export-tabs-default-panel" role="tabpanel" aria-labelledby="export-tabs-default-tab-0" tabindex="0" data-part="tab-demo-panel"><strong>프로젝트 한눈에 보기</strong><p>지금 진행 중인 작업을 확인하세요.</p><div data-part="tab-line"></div><div style="width:65%" data-part="tab-line"></div></div></div>
