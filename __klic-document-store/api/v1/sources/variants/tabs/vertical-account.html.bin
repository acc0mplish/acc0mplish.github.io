<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="tabs" data-kv-variant="vertical-account" data-klic-component="tabs" class="kn-tabs"><div data-part="tabs tabs-vertical"><div role="tablist" aria-label="보기" aria-orientation="vertical"><button type="button" role="tab" id="kv-export-tabs-tabs-vertical-account-tab-0" aria-controls="kv-export-tabs-tabs-vertical-account-panel-0" aria-selected="true" tabindex="0" data-kv-action="tab" data-part="btn">계정</button><button type="button" role="tab" id="kv-export-tabs-tabs-vertical-account-tab-1" aria-controls="kv-export-tabs-tabs-vertical-account-panel-1" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">보안</button><button type="button" role="tab" id="kv-export-tabs-tabs-vertical-account-tab-2" aria-controls="kv-export-tabs-tabs-vertical-account-panel-2" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">알림</button></div><section role="tabpanel" id="kv-export-tabs-tabs-vertical-account-panel-0" aria-labelledby="kv-export-tabs-tabs-vertical-account-tab-0" ><form data-kv-form><label data-part="field"><span>표시 이름</span><input type="text" value="김하늘"  data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">저장</button><output aria-live="polite" data-part="output"></output></form></section><section role="tabpanel" id="kv-export-tabs-tabs-vertical-account-panel-1" aria-labelledby="kv-export-tabs-tabs-vertical-account-tab-1" hidden><form data-kv-form><label data-part="field"><span>새 비밀번호</span><input type="password" value="" minlength="8" data-part="input"></label><button type="submit" class="kv-primary" data-part="btn">저장</button><output aria-live="polite" data-part="output"></output></form></section><section role="tabpanel" id="kv-export-tabs-tabs-vertical-account-panel-2" aria-labelledby="kv-export-tabs-tabs-vertical-account-tab-2" hidden><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-tabs-tabs-vertical-account" value="이메일 알림" checked data-part="checkbox"><span><strong>이메일 알림</strong></span></label><label><input type="checkbox" name="kv-export-tabs-tabs-vertical-account" value="댓글 알림"  data-part="checkbox"><span><strong>댓글 알림</strong></span></label></fieldset></section></div></div>
