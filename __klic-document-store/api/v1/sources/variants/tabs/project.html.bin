<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/tabs-icons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="tabs" data-kv-variant="project" data-klic-component="tabs" class="kn-tabs"><div data-part="tabs"><div role="tablist" aria-label="보기" ><button type="button" role="tab" id="kv-export-tabs-tabs-project-tab-0" aria-controls="kv-export-tabs-tabs-project-panel-0" aria-selected="true" tabindex="0" data-kv-action="tab" data-part="btn">개요</button><button type="button" role="tab" id="kv-export-tabs-tabs-project-tab-1" aria-controls="kv-export-tabs-tabs-project-panel-1" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">작업</button><button type="button" role="tab" id="kv-export-tabs-tabs-project-tab-2" aria-controls="kv-export-tabs-tabs-project-panel-2" aria-selected="false" tabindex="-1" data-kv-action="tab" data-part="btn">활동</button></div><section role="tabpanel" id="kv-export-tabs-tabs-project-panel-0" aria-labelledby="kv-export-tabs-tabs-project-tab-0" ><header data-part="heading"><strong>KLIC 라이브러리</strong></header><label data-part="progress-label">프로젝트 완료<span>72%</span><progress max="100" value="72">72%</progress></label></section><section role="tabpanel" id="kv-export-tabs-tabs-project-panel-1" aria-labelledby="kv-export-tabs-tabs-project-tab-1" hidden><ul data-part="list"><li>컴포넌트 검토</li><li>문서 작성</li><li>배포 준비</li></ul></section><section role="tabpanel" id="kv-export-tabs-tabs-project-panel-2" aria-labelledby="kv-export-tabs-tabs-project-tab-2" hidden><ul data-part="list"><li>오늘 · 가이드 수정</li><li>어제 · 리뷰 완료</li></ul></section></div></div>
