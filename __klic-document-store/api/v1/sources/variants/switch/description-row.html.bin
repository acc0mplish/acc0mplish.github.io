<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/switch-description.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="switch" data-kv-variant="description-row" data-klic-component="switch" class="kn-switch"><label data-part="switch-row"><span><strong>이메일 알림</strong><small>중요한 변경을 이메일로 받습니다.</small></span><input type="checkbox" role="switch" aria-label="이메일 알림" checked data-part="checkbox"></label><p data-part="muted">설정은 이 예제 안에서만 유지됩니다.</p></div>
