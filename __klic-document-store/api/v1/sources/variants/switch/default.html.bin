<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="switch" class="kn-switch"><label data-part="switch-row"><span>이메일 알림<small>새 소식을 놓치지 마세요.</small></span><input role="switch" type="checkbox" checked aria-label="이메일 알림" data-part="switch checkbox"></label><label data-part="switch-row"><span>데스크톱 알림</span><input role="switch" type="checkbox" aria-label="데스크톱 알림" data-part="switch checkbox"></label><label data-part="switch-row"><span data-part="muted">보안 알림</span><input role="switch" type="checkbox" checked disabled aria-label="보안 알림" data-part="switch checkbox"></label></div>
