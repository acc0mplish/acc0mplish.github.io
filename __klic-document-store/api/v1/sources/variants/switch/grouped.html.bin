<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="switch" data-kv-variant="grouped" data-klic-component="switch" class="kn-switch"><header data-part="heading"><strong>알림</strong></header><label data-part="switch-row"><strong>댓글 알림</strong><input type="checkbox" role="switch" aria-label="댓글 알림" data-part="checkbox"></label><label data-part="switch-row"><strong>검토 요청</strong><input type="checkbox" role="switch" aria-label="검토 요청" data-part="checkbox"></label><header data-part="heading"><strong>개인정보</strong></header><label data-part="switch-row"><strong>활동 상태 공개</strong><input type="checkbox" role="switch" aria-label="활동 상태 공개" checked data-part="checkbox"></label></div>
