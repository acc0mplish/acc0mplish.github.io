<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-with-addons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="input-group" data-kv-variant="domain" data-klic-component="input-group" class="kn-input-group"><form data-kv-form><label data-part="field"><span>공유 도메인</span><span data-klic-surface="field" data-part="input-group"><span>https://</span><input aria-label="공유 도메인" placeholder="team.klic.app" required data-part="input"></span></label><button type="submit" class="kv-primary" data-part="btn">저장</button><output aria-live="polite" data-part="output"></output></form></div>
