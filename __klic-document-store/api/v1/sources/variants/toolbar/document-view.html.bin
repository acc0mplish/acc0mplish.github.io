<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-select.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toolbar" data-kv-variant="document-view" data-klic-component="toolbar" class="kn-toolbar"><div role="toolbar" aria-label="문서 보기" data-part="toolbar"><button type="button" data-klic-surface="control" data-kv-action="zoom-out" aria-label="축소" data-part="btn">−</button><output data-kv-zoom-value>100%</output><button type="button" data-klic-surface="control" data-kv-action="zoom-in" aria-label="확대" data-part="btn">+</button><span role="separator" aria-orientation="vertical" data-part="divider-v"></span><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-pressed="false" data-part="btn">개요 표시</button></div><div data-klic-surface="card" data-kv-zoom-target data-part="panel"><header data-part="heading"><strong>가이드 미리 보기</strong></header><p data-part="muted">확대율을 조절해 보세요.</p></div></div>
