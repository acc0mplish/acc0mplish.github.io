<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-dropdown.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toolbar" data-kv-variant="search-filter" data-klic-component="toolbar" class="kn-toolbar"><div role="toolbar" aria-label="목록 작업" data-part="toolbar"><input type="search" data-kv-filter aria-label="문서 검색" placeholder="문서 검색" data-part="input"><button type="button" data-klic-surface="control" data-kv-action="clear-search"  data-part="btn">지우기</button><button type="button" data-klic-surface="control" data-kv-action="selection-action"  data-part="btn">보관</button></div><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label data-kv-filter-item><input type="checkbox" name="kv-export-toolbar-toolbar-search-filter" value="브랜드 가이드" checked data-part="checkbox"><span><strong>브랜드 가이드</strong></span></label><label data-kv-filter-item><input type="checkbox" name="kv-export-toolbar-toolbar-search-filter" value="컴포넌트 사양"  data-part="checkbox"><span><strong>컴포넌트 사양</strong></span></label></fieldset><output aria-live="polite" data-part="output"></output></div>
