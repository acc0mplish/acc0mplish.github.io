<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-input-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toolbar" data-kv-variant="text-editor" data-klic-component="toolbar" class="kn-toolbar"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>텍스트 미리 보기</strong></header><p data-kv-format-target>명확한 인터페이스를 함께 만듭니다.</p></section><div role="toolbar" aria-label="본문 서식" data-part="toolbar"><button type="button" data-klic-surface="control" data-kv-action="format" aria-label="굵게" data-kv-format="bold" aria-pressed="false" data-part="btn"><i data-part="icon" data-lucide="bold" aria-hidden="true"></i></button><button type="button" data-klic-surface="control" data-kv-action="format" aria-label="기울임" data-kv-format="italic" aria-pressed="false" data-part="btn"><i data-part="icon" data-lucide="italic" aria-hidden="true"></i></button><button type="button" data-klic-surface="control" data-kv-action="format" aria-label="밑줄" data-kv-format="underline" aria-pressed="false" data-part="btn"><i data-part="icon" data-lucide="underline" aria-hidden="true"></i></button><span role="separator" aria-orientation="vertical" data-part="divider-v"></span><button type="button" data-klic-surface="control" data-kv-action="copy-text" aria-label="본문 복사" data-kv-value="명확한 인터페이스를 함께 만듭니다." data-part="btn"><i data-part="icon" data-lucide="copy" aria-hidden="true"></i></button></div></div>
