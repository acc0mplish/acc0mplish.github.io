<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/input-group-with-buttons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toolbar" data-kv-variant="media-controls" data-klic-component="toolbar" class="kn-toolbar"><div role="img" aria-label="팀 소개 영상" data-part="art"><span>KLIC</span><strong>팀 소개 영상</strong><span data-part="art-orbit"></span></div><div role="toolbar" aria-label="미디어 제어" data-part="toolbar"><button type="button" data-klic-surface="control" data-kv-action="play" aria-label="재생" aria-pressed="false" data-part="btn"><i data-part="icon" data-lucide="play" aria-hidden="true"></i></button><button type="button" data-klic-surface="control" data-kv-action="mute" aria-label="음소거" data-part="btn"><i data-part="icon" data-lucide="volume-x" aria-hidden="true"></i></button><input type="range" min="0" max="100" value="65" aria-label="음량" data-kv-range data-part="slider"><output>65</output><button type="button" data-klic-surface="control" data-kv-action="toggle" aria-label="반복 재생" aria-pressed="false" data-part="btn"><i data-part="icon" data-lucide="repeat" aria-hidden="true"></i></button></div><output aria-live="polite" data-part="output">미디어 동작 시뮬레이션</output></div>
