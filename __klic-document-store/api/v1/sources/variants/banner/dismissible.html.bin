<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/item-header.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="banner" data-kv-variant="dismissible" data-klic-component="banner" class="kn-banner"><section data-kv-banner data-part="banner"><div class="ku-row" data-part="row"><span data-part="badge">팀 설정</span><button type="button" data-klic-surface="control" data-kv-action="banner-dismiss" aria-label="안내 닫기" data-part="btn">×</button></div><header data-part="heading"><strong>팀의 기본 환경을 완성하세요</strong><p data-part="muted">언어와 알림 설정을 확인하면 협업을 시작하기 쉽습니다.</p></header><button type="button" data-klic-surface="control" data-kv-action="open" data-kv-target="kv-export-banner-banner-dismissible-dialog" data-part="btn">환경 설정</button><dialog id="kv-export-banner-banner-dismissible-dialog" aria-label="기본 환경" data-klic-surface="overlay" data-part="dialog"><header data-part="heading"><strong>기본 환경</strong></header><form data-kv-form><label data-part="field"><span>언어</span><select data-part="select"><option>한국어</option><option>English</option></select></label><button type="submit" class="kv-primary" data-part="btn">설정 저장</button><output aria-live="polite" data-part="output"></output></form><footer class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="close"  data-part="btn">닫기</button></footer></dialog></section></div>
