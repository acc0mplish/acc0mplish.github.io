<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/field-choice-card.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toggle-group" data-kv-variant="display-options" data-klic-component="toggle-group" class="kn-toggle-group"><header data-part="heading"><strong>카드에 표시할 정보</strong></header><div role="group" aria-label="카드 정보" data-part="toggle-grid"><button type="button" data-kv-action="toggle" aria-pressed="false" data-part="toggle-tile btn"><i data-part="icon" data-lucide="user" aria-hidden="true"></i><strong>담당자</strong></button><button type="button" data-kv-action="toggle" aria-pressed="false" data-part="toggle-tile btn"><i data-part="icon" data-lucide="calendar" aria-hidden="true"></i><strong>마감일</strong></button><button type="button" data-kv-action="toggle" aria-pressed="false" data-part="toggle-tile btn"><i data-part="icon" data-lucide="message-circle" aria-hidden="true"></i><strong>댓글</strong></button><button type="button" data-kv-action="toggle" aria-pressed="false" data-part="toggle-tile btn"><i data-part="icon" data-lucide="paperclip" aria-hidden="true"></i><strong>첨부</strong></button></div></div>
