<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/button-group-input-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="toggle-group" data-kv-variant="text-controls" data-klic-component="toggle-group" class="kn-toggle-group"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>문서 초안</strong></header><p data-kv-format-target>팀이 함께 사용하는 인터페이스를 만듭니다.</p></section><div role="group" aria-label="문장 서식" class="ku-actions ku-joined" data-part="actions joined"><button type="button" data-klic-surface="control" data-kv-action="format" data-kv-format="bold" aria-pressed="false" data-part="btn">굵게</button><button type="button" data-klic-surface="control" data-kv-action="format" data-kv-format="italic" aria-pressed="false" data-part="btn">기울임</button><button type="button" data-klic-surface="control" data-kv-action="format" data-kv-format="underline" aria-pressed="false" data-part="btn">밑줄</button></div></div>
