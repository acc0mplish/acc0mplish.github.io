<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/tabs-icons.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="bottom-navigation" data-kv-variant="labeled" data-klic-component="bottom-navigation" class="kn-bottom-navigation"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>오늘의 작업</strong></header><div class="ku-row" data-part="row"><span>진행 중</span><span><span data-part="badge">4</span></span></div><div class="ku-row" data-part="row"><span>검토 요청</span><span><span data-part="badge">2</span></span></div></section><nav aria-label="앱 주요 탐색" data-part="bottom-nav"><button type="button" data-kv-action="nav" aria-current="page" data-part="btn"><i data-part="icon" data-lucide="house" aria-hidden="true"></i><span>홈</span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="folder" aria-hidden="true"></i><span>프로젝트</span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="bell" aria-hidden="true"></i><span>알림</span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="user" aria-hidden="true"></i><span>내 정보</span></button></nav><output aria-live="polite" data-part="output">홈</output></div>
