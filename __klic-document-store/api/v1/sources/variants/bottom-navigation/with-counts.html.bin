<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/sidebar-menu-badge.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="bottom-navigation" data-kv-variant="with-counts" data-klic-component="bottom-navigation" class="kn-bottom-navigation"><header data-part="heading"><strong>팀 메시지</strong><p data-part="muted">새로운 대화를 확인하세요.</p></header><ul data-part="list"><li>김하늘 · 디자인 리뷰 안내</li><li>이도윤 · 코드 검토 요청</li></ul><nav aria-label="앱 주요 탐색" data-part="bottom-nav"><button type="button" data-kv-action="nav" aria-current="page" data-part="btn"><i data-part="icon" data-lucide="inbox" aria-hidden="true"></i><span>받은함 <b data-part="nav-count">12</b></span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="message-circle" aria-hidden="true"></i><span>멘션 <b data-part="nav-count">3</b></span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="star" aria-hidden="true"></i><span>중요</span></button><button type="button" data-kv-action="nav" aria-current="false" data-part="btn"><i data-part="icon" data-lucide="archive" aria-hidden="true"></i><span>보관</span></button></nav><output aria-live="polite" data-part="output">받은함</output></div>
