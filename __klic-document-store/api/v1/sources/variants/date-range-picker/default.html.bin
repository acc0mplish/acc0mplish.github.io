<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="date-range-picker" class="kn-date-range-picker"><div data-part="columns" class="ku-columns"><div data-part="field"><label for="export-date-range-picker-default-from" data-part="label">시작일</label><input id="export-date-range-picker-default-from" type="date" value="2026-10-24" data-date-start data-part="input"></div><div data-part="field"><label for="export-date-range-picker-default-to" data-part="label">종료일</label><input id="export-date-range-picker-default-to" type="date" value="2026-10-30" min="2026-10-24" data-date-end data-part="input"></div></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
