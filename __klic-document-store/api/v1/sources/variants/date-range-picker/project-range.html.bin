<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/calendar-range.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="date-range-picker" data-kv-variant="project-range" data-klic-component="date-range-picker" class="kn-date-range-picker"><form data-kv-form data-kv-date-range><header data-part="heading"><strong>프로젝트 일정</strong></header><div data-part="range-endpoints"><span>시작</span><i aria-hidden="true" data-part="icon"></i><span>마감</span></div><div class="ku-grid-2" data-part="grid-2"><label data-part="field"><span>시작일</span><input type="date" value="2026-11-01" required data-kv-start data-part="input"></label><label data-part="field"><span>종료일</span><input type="date" value="2026-11-30" required data-kv-end data-part="input"></label></div><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-date-range-picker-date-range-picker-project-range" value="마감 전 알림 받기" checked data-part="checkbox"><span><strong>마감 전 알림 받기</strong></span></label></fieldset><button type="submit" class="kv-primary" data-part="btn">일정 저장</button><output aria-live="polite" data-part="output"></output></form></div>
