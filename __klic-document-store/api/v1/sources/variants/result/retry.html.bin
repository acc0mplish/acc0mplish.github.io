<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/empty-input-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="result" data-kv-variant="retry" data-klic-component="result" class="kn-result"><section class="kv-danger" data-part="empty"><i data-part="icon" data-lucide="circle-x" aria-hidden="true"></i><header data-part="heading"><strong>연결을 완료하지 못했습니다</strong><p data-part="muted">네트워크 상태를 확인한 뒤 다시 시도해 주세요.</p></header><button type="button" data-klic-surface="control" data-kv-action="retry"  data-part="btn">로컬 재시도</button><output aria-live="polite" data-part="output"></output></section></div>
