<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/mui/base-ui/blob/c1294abd3c7ab19fa0fb980373af732315b8a5be/docs/src/app/(docs)/react/components/select/demos/multiple/tailwind/index.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="select" data-kv-variant="form-select" data-klic-component="select" class="kn-select"><form data-kv-form><label data-part="field"><span>문의 주제</span><select required data-part="select"><option value="">주제를 선택하세요</option><option>도입 상담</option><option>기술 문의</option><option>결제 문의</option></select></label><button type="submit" class="kv-primary" data-part="btn">문의 준비</button><output aria-live="polite" data-part="output"></output></form></div>
