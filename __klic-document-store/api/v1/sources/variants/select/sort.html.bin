<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/select-scrollable.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="select" data-kv-variant="sort" data-klic-component="select" class="kn-select"><label data-part="field"><span>프로젝트 정렬</span><select data-kv-sort data-part="select"><option>이름 오름차순</option><option>이름 내림차순</option></select></label><ul data-kv-sort-list data-part="list"><li>Atlas 리뉴얼</li><li>Beacon 문서화</li><li>Canvas 라이브러리</li></ul></div>
