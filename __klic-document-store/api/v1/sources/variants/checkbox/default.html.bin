<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="checkbox" class="kn-checkbox"><label data-part="check-row"><input type="checkbox" checked data-part="checkbox"><span>모든 프로젝트 보기<small>팀의 모든 작업에 참여합니다.</small></span></label><label data-part="check-row"><input type="checkbox" data-part="checkbox"><span>이메일 알림 받기</span></label><label data-part="check-row"><input type="checkbox" checked disabled data-part="checkbox"><span data-part="muted">필수 알림</span></label></div>
