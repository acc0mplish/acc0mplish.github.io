<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-table.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="checkbox" data-kv-variant="permissions" data-klic-component="checkbox" class="kn-checkbox"><header data-part="heading"><strong>권한 행렬</strong></header><fieldset data-part="choices"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-checkbox-checkbox-permissions" value="문서 읽기" checked data-part="checkbox"><span><strong>문서 읽기</strong></span></label><label><input type="checkbox" name="kv-export-checkbox-checkbox-permissions" value="문서 편집"  data-part="checkbox"><span><strong>문서 편집</strong></span></label><label><input type="checkbox" name="kv-export-checkbox-checkbox-permissions" value="멤버 초대"  data-part="checkbox"><span><strong>멤버 초대</strong></span></label></fieldset><output data-kv-selection aria-live="polite" data-part="output">문서 읽기 선택됨</output></div>
