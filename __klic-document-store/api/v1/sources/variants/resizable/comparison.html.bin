<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="resizable" data-kv-variant="comparison" data-klic-component="resizable" class="kn-resizable"><header data-part="heading"><strong>원안과 개선안</strong></header><label data-part="field"><span>원안 표시 비율 (%)</span><input type="range" value="50" min="30" max="70" data-kv-split data-part="slider"></label><div style="--kv-split:50%" data-part="split"><section><span data-part="badge">원안</span><header data-part="heading"><strong>기존 흐름</strong></header><p data-part="muted">입력 후 확인 화면으로 이동</p></section><section><span data-part="badge">개선안</span><header data-part="heading"><strong>새 흐름</strong></header><p data-part="muted">입력 위치에서 즉시 결과 확인</p></section></div></div>
