<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/resizable-vertical.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="resizable" data-kv-variant="vertical" data-klic-component="resizable" class="kn-resizable"><label data-part="field"><span>문서 높이 (px)</span><input type="range" value="120" min="80" max="220" data-kv-height data-part="slider"></label><div data-klic-surface="card" data-kv-height-target style="height:120px" data-part="panel height-panel"><header data-part="heading"><strong>문서 영역</strong></header><p data-part="muted">핸들을 끌거나 위 슬라이더를 사용하세요.</p></div><div data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>검토 메모</strong></header><p data-part="muted">아래 패널은 흐름을 유지합니다.</p></div></div>
