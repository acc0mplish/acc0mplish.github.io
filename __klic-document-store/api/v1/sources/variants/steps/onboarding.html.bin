<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="steps" data-kv-variant="onboarding" data-klic-component="steps" class="kn-steps"><header data-part="heading"><strong>팀 시작하기</strong><p data-part="muted">세 가지 작업으로 협업을 준비하세요.</p></header><fieldset data-part="choices choice-cards"><legend>필요한 항목 선택</legend><label><input type="checkbox" name="kv-export-steps-steps-onboarding" value="프로필 작성" checked data-part="checkbox"><span><strong>프로필 작성</strong><small>내 이름과 역할을 등록하세요</small></span></label><label><input type="checkbox" name="kv-export-steps-steps-onboarding" value="팀원 초대"  data-part="checkbox"><span><strong>팀원 초대</strong><small>함께할 사람을 연결하세요</small></span></label><label><input type="checkbox" name="kv-export-steps-steps-onboarding" value="첫 프로젝트"  data-part="checkbox"><span><strong>첫 프로젝트</strong><small>자료를 모을 공간을 만드세요</small></span></label></fieldset><output data-kv-selection aria-live="polite" data-part="output"></output></div>
