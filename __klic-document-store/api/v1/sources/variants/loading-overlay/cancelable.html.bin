<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/spinner-empty.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="loading-overlay" data-kv-variant="cancelable" data-klic-component="loading-overlay" class="kn-loading-overlay"><div data-part="overlay-wrap"><section data-klic-surface="card" data-part="panel"><header data-part="heading"><strong>내보내기</strong></header><ul data-part="list"><li>프로젝트 정보</li><li>문서 목록</li><li>담당자 기록</li></ul></section><div data-kv-loading data-part="local-overlay"><span aria-hidden="true" class="ku-spin" data-part="spinner"></span><strong>내보내기 준비 중</strong><button type="button" data-klic-surface="control" data-kv-action="overlay-dismiss"  data-part="btn">중단</button></div></div></div>
