<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="search-input" class="kn-search-input"><div data-part="field"><label for="export-search-input-default-search" data-part="label">프로젝트 검색</label><input id="export-search-input-default-search" type="search" data-local-filter placeholder="이름으로 검색" data-part="input"></div><ul data-part="search-results"><li data-search-item>디자인 시스템</li><li data-search-item>브랜드 리뉴얼</li><li data-search-item>모바일 앱</li></ul><p data-search-count data-part="hint">3개 결과</p><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
