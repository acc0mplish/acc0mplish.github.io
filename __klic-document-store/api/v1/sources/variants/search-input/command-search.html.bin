<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/command-dialog.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="search-input" data-kv-variant="command-search" data-klic-component="search-input" class="kn-search-input"><header data-part="heading"><strong>빠른 실행</strong><p data-part="muted">명령을 검색하고 선택하세요.</p></header><input type="search" data-kv-filter aria-label="명령 검색" placeholder="명령어 입력" data-part="input"><div data-part="menu"><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="arrow-up-right" aria-hidden="true"></i> 새 프로젝트 만들기</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="arrow-up-right" aria-hidden="true"></i> 설정 열기</button><button type="button" data-kv-filter-item data-kv-action="choose" data-part="btn"><i data-part="icon" data-lucide="arrow-up-right" aria-hidden="true"></i> 초대 링크 만들기</button></div><output aria-live="polite" data-part="output"></output></div>
