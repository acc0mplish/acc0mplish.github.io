<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-table.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="data-grid" data-kv-variant="bulk-grid" data-klic-component="data-grid" class="kn-data-grid"><header data-part="heading"><strong>검토 요청 목록</strong></header><div tabindex="0" role="region" aria-label="데이터 표" data-part="table-scroll"><table ><thead><tr><th scope="col">선택</th><th scope="col">요청</th><th scope="col">우선순위</th></tr></thead><tbody><tr><td><input type="checkbox" aria-label="버튼 접근성 선택" data-part="checkbox"></td><td>버튼 접근성</td><td><span data-part="badge">보통</span></td></tr><tr><td><input type="checkbox" aria-label="입력 검증 선택" data-part="checkbox"></td><td>입력 검증</td><td><span data-part="badge">보통</span></td></tr><tr><td><input type="checkbox" aria-label="모바일 탐색 선택" data-part="checkbox"></td><td>모바일 탐색</td><td><span data-part="badge">보통</span></td></tr></tbody></table></div><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="selection-action"  data-part="btn">선택 요청 승인</button><button type="button" data-klic-surface="control" data-kv-action="uncheck"  data-part="btn">전체 선택 해제</button></div><output aria-live="polite" data-part="output"></output></div>
