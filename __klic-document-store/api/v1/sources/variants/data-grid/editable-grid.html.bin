<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="data-grid" data-kv-variant="editable-grid" data-klic-component="data-grid" class="kn-data-grid"><form data-kv-form><div tabindex="0" role="region" aria-label="데이터 표" data-part="table-scroll"><table ><thead><tr><th scope="col">항목</th><th scope="col">담당</th><th scope="col">진행률</th></tr></thead><tbody><tr><td>가이드 문서</td><td><label data-part="field"><span>문서 담당</span><select data-part="select"><option>김하늘</option><option>이도윤</option></select></label></td><td><label data-part="field"><span>문서 진행률</span><input type="number" value="70" min="0" max="100" data-part="input"></label></td></tr><tr><td>접근성 검토</td><td><label data-part="field"><span>검토 담당</span><select data-part="select"><option>박서연</option><option>김하늘</option></select></label></td><td><label data-part="field"><span>검토 진행률</span><input type="number" value="90" min="0" max="100" data-part="input"></label></td></tr></tbody></table></div><button type="submit" class="kv-primary" data-part="btn">변경 저장</button><output aria-live="polite" data-part="output"></output></form></div>
