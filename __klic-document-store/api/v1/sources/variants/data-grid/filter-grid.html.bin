<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="data-grid" data-kv-variant="filter-grid" data-klic-component="data-grid" class="kn-data-grid"><input type="search" data-kv-filter aria-label="프로젝트 검색" placeholder="프로젝트명 검색" data-part="input"><div tabindex="0" role="region" aria-label="데이터 표" data-part="table-scroll"><table ><thead><tr><th scope="col">프로젝트</th><th scope="col">상태</th><th scope="col">담당</th></tr></thead><tbody><tr data-kv-filter-item><td>KLIC 라이브러리</td><td><span data-part="badge">진행 중</span></td><td>김하늘</td></tr><tr data-kv-filter-item><td>웹 리뉴얼</td><td><span data-part="badge">검토 중</span></td><td>이도윤</td></tr><tr data-kv-filter-item><td>운영 대시보드</td><td><span data-part="badge">완료</span></td><td>박서연</td></tr></tbody></table></div></div>
