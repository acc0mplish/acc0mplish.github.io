<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-density="default" data-klic-component="data-grid" class="kn-data-grid"><div data-part="mini-grid-toolbar"><span>팀 프로젝트 <span data-part="muted">3</span></span><div aria-label="표 밀도" data-part="density-toggle"><button aria-pressed="true" data-action="density" data-density="default" data-part="btn">Default</button><button aria-pressed="false" data-action="density" data-density="dense" data-part="btn">Dense</button></div></div><div style="overflow:auto"><table data-part="table-preview"><caption class="ku-visually-hidden" data-part="visually-hidden">밀도를 변경할 수 있는 3행 예시 표</caption><thead><tr><th scope="col"><input type="checkbox" data-action="select-rows" aria-label="모든 행 선택" data-part="row-check checkbox"></th><th scope="col">이름</th><th scope="col">상태</th></tr></thead><tbody><tr><td><input type="checkbox" aria-label="김하늘 선택" data-part="row-check checkbox"></td><td><span data-part="person"><span role="img" aria-label="김하늘 · 생성한 가상 인물 프로필" title="김하늘" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:60% 40%" data-part="person-avatar root-person has-photo">하늘</span>김하늘</span></td><td><span data-part="badge">진행 중</span></td></tr><tr><td><input type="checkbox" aria-label="이지원 선택" data-part="row-check checkbox"></td><td><span data-part="person"><span role="img" aria-label="이지원 · 생성한 가상 인물 프로필" title="이지원" style="background-image:url('./block-runtime/portraits/team-atlas-d.png');background-size:600% 600%;background-position:100% 40%" data-part="person-avatar root-person has-photo">지원</span>이지원</span></td><td><span class="kv-warning" data-part="badge">검토 중</span></td></tr><tr><td><input type="checkbox" aria-label="박선준 선택" data-part="row-check checkbox"></td><td><span data-part="person"><span role="img" aria-label="박선준 · 생성한 가상 인물 프로필" title="박선준" style="background-image:url('./block-runtime/portraits/team-atlas-b.png');background-size:600% 600%;background-position:40% 0%" data-part="person-avatar root-person has-photo">선준</span>박선준</span></td><td><span class="kv-neutral" data-part="badge">대기 중</span></td></tr></tbody></table></div></div>
