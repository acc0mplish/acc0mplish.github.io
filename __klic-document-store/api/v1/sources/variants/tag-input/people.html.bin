<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/combobox-input-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="tag-input" data-kv-variant="people" data-klic-component="tag-input" class="kn-tag-input"><header data-part="heading"><strong>수신자</strong><p data-part="muted">이메일은 이 예제에서만 저장됩니다.</p></header><form data-kv-tag-form class="ku-inline" data-part="inline"><input type="email" aria-label="수신자 이메일" required placeholder="name@example.com" data-part="input"><button data-klic-surface="control" data-part="btn">추가</button></form><div data-kv-tags data-part="tags"></div></div>
