<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-table.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="transfer" data-kv-variant="columns" data-klic-component="transfer" class="kn-transfer"><header data-part="heading"><strong>표시할 열을 구성하세요</strong><p data-part="muted">Ctrl 또는 ⌘를 누르면 여러 항목을 선택할 수 있습니다.</p></header><div data-kv-transfer><header data-part="heading"><strong>열 구성</strong></header><div data-part="transfer-grid"><label data-part="field"><span>사용 가능</span><select multiple data-kv-transfer-from aria-label="사용 가능한 항목" data-part="select"><option>마감일</option><option>댓글 수</option><option>첨부 파일</option></select></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="transfer-add"  data-part="btn">추가 →</button><button type="button" data-klic-surface="control" data-kv-action="transfer-remove"  data-part="btn">← 제거</button></div><label data-part="field"><span>선택됨</span><select multiple data-kv-transfer-to aria-label="선택된 항목" data-part="select"><option>프로젝트</option><option>상태</option></select></label></div><output aria-live="polite" data-part="output">항목을 선택한 뒤 이동 버튼을 누르세요.</output></div></div>
