<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="transfer" data-kv-variant="permissions" data-klic-component="transfer" class="kn-transfer"><div class="ku-row" data-part="row"><span><strong>에디터 역할</strong></span><span><span data-part="badge">팀 권한</span></span></div><div data-kv-transfer><header data-part="heading"><strong>권한 배정</strong></header><div data-part="transfer-grid"><label data-part="field"><span>사용 가능</span><select multiple data-kv-transfer-from aria-label="사용 가능한 항목" data-part="select"><option>문서 편집</option><option>파일 업로드</option><option>댓글 작성</option></select></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="transfer-add"  data-part="btn">추가 →</button><button type="button" data-klic-surface="control" data-kv-action="transfer-remove"  data-part="btn">← 제거</button></div><label data-part="field"><span>선택됨</span><select multiple data-kv-transfer-to aria-label="선택된 항목" data-part="select"><option>문서 읽기</option></select></label></div><output aria-live="polite" data-part="output">항목을 선택한 뒤 이동 버튼을 누르세요.</output></div><p data-part="muted">권한을 제거하려면 오른쪽에서 선택하고 제거를 누르세요.</p></div>
