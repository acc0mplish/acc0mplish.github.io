<!-- KLIC native HTML example. Styles/interactions: component bundle. Pattern reference: https://github.com/shadcn-ui/ui/blob/481d523374745e77d0cf9c53a4115ab5dd7c8481/apps/v4/examples/base/checkbox-group.tsx -->
<div data-kv-root data-klic-material="surface" data-kv-component="transfer" data-kv-variant="members" data-klic-component="transfer" class="kn-transfer"><div data-kv-transfer><header data-part="heading"><strong>프로젝트 멤버</strong></header><div data-part="transfer-grid"><label data-part="field"><span>사용 가능</span><select multiple data-kv-transfer-from aria-label="사용 가능한 항목" data-part="select"><option>김하늘</option><option>이도윤</option><option>박서연</option></select></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="transfer-add"  data-part="btn">추가 →</button><button type="button" data-klic-surface="control" data-kv-action="transfer-remove"  data-part="btn">← 제거</button></div><label data-part="field"><span>선택됨</span><select multiple data-kv-transfer-to aria-label="선택된 항목" data-part="select"><option>최지우</option></select></label></div><output aria-live="polite" data-part="output">항목을 선택한 뒤 이동 버튼을 누르세요.</output></div></div>
