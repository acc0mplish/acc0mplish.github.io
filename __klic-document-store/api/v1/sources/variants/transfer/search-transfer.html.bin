<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-kv-root data-klic-material="surface" data-kv-component="transfer" data-kv-variant="search-transfer" data-klic-component="transfer" class="kn-transfer"><label data-part="field"><span>사용 가능 항목 검색</span><input type="search" data-kv-transfer-search placeholder="자료 이름" data-part="input"></label><div data-kv-transfer><header data-part="heading"><strong>연결할 자료</strong></header><div data-part="transfer-grid"><label data-part="field"><span>사용 가능</span><select multiple data-kv-transfer-from aria-label="사용 가능한 항목" data-part="select"><option>브랜드 가이드</option><option>디자인 토큰</option><option>접근성 문서</option><option>개발 매뉴얼</option></select></label><div class="ku-actions" data-part="actions"><button type="button" data-klic-surface="control" data-kv-action="transfer-add"  data-part="btn">추가 →</button><button type="button" data-klic-surface="control" data-kv-action="transfer-remove"  data-part="btn">← 제거</button></div><label data-part="field"><span>선택됨</span><select multiple data-kv-transfer-to aria-label="선택된 항목" data-part="select"></select></label></div><output aria-live="polite" data-part="output">항목을 선택한 뒤 이동 버튼을 누르세요.</output></div></div>
