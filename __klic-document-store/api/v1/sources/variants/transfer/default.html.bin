<!-- KLIC native HTML example. Styles/interactions: component bundle. KLIC example; preserve bundled per-file license notices. -->
<div data-klic-component="transfer" class="kn-transfer"><div data-part="transfer"><fieldset data-transfer-list="left"><legend>전체 팀</legend><label><input type="checkbox" value="디자인" data-part="checkbox"> 디자인</label><label><input type="checkbox" value="개발" data-part="checkbox"> 개발</label><label><input type="checkbox" value="운영" data-part="checkbox"> 운영</label></fieldset><div><button type="button" data-cmp-action="transfer" data-direction="right" aria-label="선택 팀 추가" data-part="btn" class="kv-neutral kv-sm">→</button><button type="button" data-cmp-action="transfer" data-direction="left" aria-label="선택 팀 제외" data-part="btn" class="kv-neutral kv-sm">←</button></div><fieldset data-transfer-list="right"><legend>참여 팀</legend><label><input type="checkbox" value="기획" data-part="checkbox"> 기획</label></fieldset></div><p data-cmp-status role="status" aria-live="polite" data-part="status"></p></div>
