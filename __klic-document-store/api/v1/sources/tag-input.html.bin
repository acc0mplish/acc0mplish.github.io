<!-- KLIC 사이트의 HTML 데모: Tag Input -->
<!-- 전체 데모는 브라우저의 native API와 app.js를 사용합니다. -->
<div data-klic-component="tag-input" class="kn-tag-input">
<label for="klic-example-tag" data-part="label">프로젝트 태그</label>
<div data-tags data-part="chip-list">
<span data-part="chip">디자인<button type="button" data-cmp-action="remove-chip" aria-label="디자인 제거" data-part="btn">×</button>
</span>
<span data-part="chip">KLIC<button type="button" data-cmp-action="remove-chip" aria-label="KLIC 제거" data-part="btn">×</button>
</span>
</div>
<input id="klic-example-tag" data-tag-input maxlength="24" placeholder="입력 후 Enter" data-part="input">
<p data-part="hint">Enter로 추가 · ×로 제거</p>
<p data-cmp-status role="status" aria-live="polite" data-part="status">
</p>
</div>

<style>
/* 기준 프로필 A의 높이: 2rem (root 16px일 때 32px) */
:root {
  --klic-component-button-size-default-height: 2rem;
  --klic-component-input-size-default-height: 2rem;
  --klic-semantic-color-accent: #245fc2;
}
:is(.kn-btn,[data-part~="btn"]) {
  min-height: var(--klic-component-button-size-default-height);
  padding: .35rem .7rem;
  border-radius: .3125rem;
  border: 1px solid transparent;
  background: var(--klic-semantic-color-accent);
  color: white;
  font: inherit;
}
</style>

<!-- 완전한 스타일: ./styles.css + ./brand.css
     확장 컴포넌트: ./component-expansion.mjs + ./component-expansion.css
     확장 동작: ./component-interactions.mjs의 initComponentInteractions()
     아이콘: ./lucide.min.js (ISC)
     상호작용: ./app.js
     이 코드는 별도 npm 패키지가 아닌 이 사이트의 예제입니다. -->
