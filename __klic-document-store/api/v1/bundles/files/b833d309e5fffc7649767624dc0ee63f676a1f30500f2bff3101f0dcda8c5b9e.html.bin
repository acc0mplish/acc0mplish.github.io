<!-- KLIC 사이트의 HTML 데모: Toolbar -->
<!-- 전체 데모는 브라우저의 native API와 app.js를 사용합니다. -->
<div data-klic-component="toolbar" class="kn-toolbar">
<div role="group" aria-label="문서 작업 도구" data-part="stack" class="ku-stack">
<div role="group" aria-label="문서 명령" data-part="button-row" class="ku-button-row">
<button type="button" data-cmp-action="menu-choice" data-name="새 문서" data-part="btn" class="kv-neutral kv-sm">
<i data-part="icon" data-lucide="file-plus" aria-hidden="true">
</i> 새 문서</button>
<button type="button" data-cmp-action="menu-choice" data-name="문서 내보내기" data-part="btn" class="kv-neutral kv-sm">
<i data-part="icon" data-lucide="download" aria-hidden="true">
</i> 내보내기</button>
</div>
<hr style="width:100%">
<div role="group" aria-label="보기 옵션" data-part="button-row" class="ku-button-row">
<button type="button" data-cmp-action="toggle" aria-pressed="true" data-part="btn" class="kv-neutral kv-sm">
<i data-part="icon" data-lucide="message-square" aria-hidden="true">
</i> 주석 표시</button>
</div>
</div>
<p data-part="hint">문서 명령과 보기 옵션을 구분한 작업 도구 모음</p>
<p data-cmp-status role="status" aria-live="polite" data-part="status">
</p>
</div>

<style>
/* 기준 프로필 A의 높이: 2rem (root 16px일 때 32px) */
:root {
  --klic-component-button-size-default-height: 2rem;
  --klic-component-input-size-default-height: 2rem;
  --klic-semantic-color-accent: #245fc2;
}
:is(.kn-btn,[data-part~="btn"]) {
  min-height: var(--klic-component-button-size-default-height);
  padding: .35rem .7rem;
  border-radius: .3125rem;
  border: 1px solid transparent;
  background: var(--klic-semantic-color-accent);
  color: white;
  font: inherit;
}
</style>

<!-- 완전한 스타일: ./styles.css + ./brand.css
     확장 컴포넌트: ./component-expansion.mjs + ./component-expansion.css
     확장 동작: ./component-interactions.mjs의 initComponentInteractions()
     아이콘: ./lucide.min.js (ISC)
     상호작용: ./app.js
     이 코드는 별도 npm 패키지가 아닌 이 사이트의 예제입니다. -->
