<!-- KLIC 사이트의 HTML 데모: Form -->
<!-- 전체 데모는 브라우저의 native API와 app.js를 사용합니다. -->
<div data-klic-component="form" class="kn-form">
<form data-component-form>
<div data-part="field">
<label for="klic-example-name" data-part="label">프로젝트 이름</label>
<input id="klic-example-name" name="project" required maxlength="60" placeholder="프로젝트 이름" data-part="input">
</div>
<div data-part="field">
<label for="klic-example-email" data-part="label">담당자 이메일</label>
<input id="klic-example-email" name="email" type="email" required placeholder="team@example.com" data-part="input">
</div>
<button type="submit" data-part="btn" class="kv-sm">입력 확인</button>
<p data-cmp-status role="status" aria-live="polite" data-part="status">
</p>
</form>
</div>

<style>
/* 기준 프로필 A의 높이: 2rem (root 16px일 때 32px) */
:root {
  --klic-component-button-size-default-height: 2rem;
  --klic-component-input-size-default-height: 2rem;
  --klic-semantic-color-accent: #245fc2;
}
:is(.kn-btn,[data-part~="btn"]) {
  min-height: var(--klic-component-button-size-default-height);
  padding: .35rem .7rem;
  border-radius: .3125rem;
  border: 1px solid transparent;
  background: var(--klic-semantic-color-accent);
  color: white;
  font: inherit;
}
</style>

<!-- 완전한 스타일: ./styles.css + ./brand.css
     확장 컴포넌트: ./component-expansion.mjs + ./component-expansion.css
     확장 동작: ./component-interactions.mjs의 initComponentInteractions()
     아이콘: ./lucide.min.js (ISC)
     상호작용: ./app.js
     이 코드는 별도 npm 패키지가 아닌 이 사이트의 예제입니다. -->
