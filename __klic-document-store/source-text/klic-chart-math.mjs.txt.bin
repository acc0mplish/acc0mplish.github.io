export const finite=value=>typeof value==='number'&&Number.isFinite(value);
export const clamp=(value,min,max)=>Math.min(max,Math.max(min,value));
export function extent(values){const clean=values.filter(finite);return clean.length?[Math.min(...clean),Math.max(...clean)]:[0,1];}
export function paddedDomain(values,{includeZero=false}={}){let [min,max]=extent(values);if(includeZero){min=Math.min(0,min);max=Math.max(0,max);}if(min===max){const pad=Math.abs(min||1)*.1;min-=pad;max+=pad;}else{const pad=(max-min)*.06;min-=pad;max+=pad;}return [min,max];}
export function quantile(values,p){const sorted=values.filter(finite).sort((a,b)=>a-b);if(!sorted.length)return null;const position=(sorted.length-1)*clamp(p,0,1),lower=Math.floor(position),fraction=position-lower;return sorted[lower]+(sorted[lower+1]===undefined?0:(sorted[lower+1]-sorted[lower])*fraction);}
export function histogram(values,count=12){const clean=values.filter(finite);if(!clean.length)return [];let [min,max]=extent(clean);if(min===max){min-=.5;max+=.5;}const size=(max-min)/count,bins=Array.from({length:count},(_,index)=>({x0:min+index*size,x1:index===count-1?max:min+(index+1)*size,count:0}));for(const value of clean)bins[Math.min(count-1,Math.floor((value-min)/size))].count++;return bins;}
export function kde(values,points=64){const clean=values.filter(finite);if(!clean.length)return [];const [min,max]=paddedDomain(clean),mean=clean.reduce((sum,value)=>sum+value,0)/clean.length,variance=clean.reduce((sum,value)=>sum+(value-mean)**2,0)/clean.length,bandwidth=Math.max(1e-6,1.06*Math.sqrt(variance||1)*clean.length**-.2),root=1/Math.sqrt(2*Math.PI),out=[];for(let index=0;index<points;index++){const x=min+(max-min)*index/(points-1),density=clean.reduce((sum,value)=>{const u=(x-value)/bandwidth;return sum+Math.exp(-.5*u*u)*root;},0)/(clean.length*bandwidth);out.push({x,y:density});}return out;}
export function ecdf(values){const sorted=values.filter(finite).sort((a,b)=>a-b);return sorted.map((value,index)=>({x:value,y:(index+1)/sorted.length}));}
export function regression(points){const usable=points.filter(point=>finite(point.x)&&finite(point.y));if(usable.length<2)return null;const meanX=usable.reduce((sum,point)=>sum+point.x,0)/usable.length,meanY=usable.reduce((sum,point)=>sum+point.y,0)/usable.length,den=usable.reduce((sum,point)=>sum+(point.x-meanX)**2,0);if(!den)return null;const slope=usable.reduce((sum,point)=>sum+(point.x-meanX)*(point.y-meanY),0)/den;return {slope,intercept:meanY-slope*meanX};}
export const polar=(cx,cy,r,angle)=>({x:cx+r*Math.cos(angle),y:cy+r*Math.sin(angle)});
export function arcPath(cx,cy,r0,r1,start,end){const a=polar(cx,cy,r1,start),b=polar(cx,cy,r1,end),c=polar(cx,cy,r0,end),d=polar(cx,cy,r0,start),large=end-start>Math.PI?1:0;return r0?`M ${a.x} ${a.y} A ${r1} ${r1} 0 ${large} 1 ${b.x} ${b.y} L ${c.x} ${c.y} A ${r0} ${r0} 0 ${large} 0 ${d.x} ${d.y} Z`:`M ${cx} ${cy} L ${a.x} ${a.y} A ${r1} ${r1} 0 ${large} 1 ${b.x} ${b.y} Z`;}
export function treemapRects(items,x,y,width,height){const clean=items.filter(item=>finite(item.value)&&item.value>0);if(!clean.length)return [];const total=clean.reduce((sum,item)=>sum+item.value,0),horizontal=width>=height;let cursor=0;return clean.map(item=>{const fraction=item.value/total,rect=horizontal?{x:x+cursor*width,y,width:fraction*width,height}:{x,y:y+cursor*height,width,height:fraction*height};cursor+=fraction;return {...rect,...item};});}
