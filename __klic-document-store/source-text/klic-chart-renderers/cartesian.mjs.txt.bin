import {extent,histogram,paddedDomain,regression} from '../klic-chart-math.mjs';
import {axes,cartesianPositions,categories,circleShape,fieldRows,format,layoutFor,lineShape,numberValue,pathShape,rectShape,scaleLinear,tableFromRows,textShape} from './base.mjs';

const channel=(row,name)=>row.values[name];
const getNumber=(row,name)=>numberValue(channel(row,name),name==='x'?'temporal':'quantitative');
const valueRows=(rows,channels)=>tableFromRows(rows,channels,record=>channels.map(name=>channel(record,name)??'—'));
function baseCartesian(spec,type,palette,layout,rows){
 const xName=type.id==='market-depth'||type.id==='orderbook'?'price':'x';
 const yName=type.id==='market-depth'||type.id==='orderbook'?'quantity':'y';
 const xKind=spec.fields?.[spec.chart.encodings[xName]]?.kind??type.channels.find(item=>item.name===xName)?.kind??'categorical';
 const horizontal=['bullet','pyramid','ranged-dot'].includes(type.id);let rangeRows=rows.flatMap(row=>type.id==='candlestick'?['open','high','low','close'].map(name=>Number(channel(row,name))):type.id==='dumbbell'?['start','end'].map(name=>Number(channel(row,name))):type.id==='range-area'||type.id==='forecast-fan'?['low','high','y'].map(name=>Number(channel(row,name))):type.id==='market-depth'||type.id==='orderbook'?[Number(channel(row,'quantity')),Number(channel(row,'cumulative'))]:type.id==='combo'?[Number(channel(row,'y')),Number(channel(row,'y2'))]:[Number(channel(row,yName))]).filter(Number.isFinite);
 if(type.id==='market-depth'&&!spec.chart.encodings.cumulative){const totals=new Map();for(const row of rows){const side=String(channel(row,'side')).toLowerCase(),name=side.includes('bid')||side.includes('매')?'bid':'ask';totals.set(name,(totals.get(name)||0)+(Number(channel(row,'quantity'))||0));}rangeRows.push(...totals.values());}
 const positionRows=type.id==='drawdown'?(()=>{let peak=-Infinity;return [...rows].sort((a,b)=>{const av=numberValue(channel(a,xName),'temporal'),bv=numberValue(channel(b,xName),'temporal');return av!==null&&bv!==null?av-bv:String(channel(a,xName)).localeCompare(String(channel(b,xName)));}).map(row=>{const value=Number(channel(row,yName));peak=Math.max(peak,value);return {...row,values:{...row.values,y:peak>0?value/peak-1:0,rawY:value}};});})():rows;
 const yValues=type.id==='drawdown'?positionRows.map(row=>row.values.y):rangeRows;
 let yDomain=paddedDomain(yValues,{includeZero:['bar','grouped-bar','stacked-bar','pyramid','bullet','bar-table'].includes(type.id)});
 const percentStack=spec.chart.options?.stack==='percent',stacked=type.id==='stacked-bar'||type.id==='stacked-area'||type.id==='streamgraph'||(type.id==='grouped-bar'&&['stacked','percent'].includes(spec.chart.options?.stack));
 if(stacked){const perX=new Map(),seriesNames=[...new Set(rows.map(row=>channel(row,'series')??'Series 1'))];for(const row of rows){const x=channel(row,xName),series=channel(row,'series')??'Series 1';if(!perX.has(x))perX.set(x,new Map());const group=perX.get(x);group.set(series,(group.get(series)||0)+(Number(channel(row,yName))||0));}const extents=[];for(const values of perX.values()){const total=seriesNames.reduce((sum,name)=>sum+(values.get(name)||0),0);if(type.id==='streamgraph'){let accumulated=-total/2;extents.push(accumulated);for(const name of seriesNames){accumulated+=values.get(name)||0;extents.push(accumulated);}}else{let accumulated=0;extents.push(0);for(const name of seriesNames){accumulated+=values.get(name)||0;extents.push(accumulated);}}}if(percentStack)yDomain=[0,1];else yDomain=paddedDomain(extents,{includeZero:type.id!=='streamgraph'});}
 const plotLayout=type.id==='marginal'?{...layout,top:layout.top+22,right:layout.right-18,bottom:layout.bottom-18,plotWidth:layout.plotWidth-18,plotHeight:layout.plotHeight-40}:layout;
 const p=cartesianPositions(positionRows,plotLayout,{x:xName,y:type.id==='drawdown'?'y':yName,xKind,includeZeroY:['bar','grouped-bar','stacked-bar','pyramid','bullet','bar-table'].includes(type.id)});
 let xFor=p.xFor,yFor=value=>scaleLinear(numberValue(value,'quantitative'),yDomain,[plotLayout.bottom,plotLayout.top]),xTicks=p.xTicks;
 if(type.id==='calibration'){
  const domain=paddedDomain(rows.flatMap(row=>[Number(channel(row,'x')),Number(channel(row,'y'))]).filter(Number.isFinite));
  xFor=value=>scaleLinear(Number(value),domain,[plotLayout.left,plotLayout.right]);yFor=value=>scaleLinear(Number(value),domain,[plotLayout.bottom,plotLayout.top]);yDomain=domain;xTicks=Array.from({length:5},(_,index)=>{const value=domain[0]+(domain[1]-domain[0])*index/4;return {x:xFor(value),label:format(value)};});
 }
 if(horizontal){
  const values=rows.flatMap(row=>type.id==='bullet'?['y','target','low','high'].map(name=>Number(channel(row,name))):type.id==='ranged-dot'?['low','high','point'].map(name=>Number(channel(row,name))):[Number(channel(row,'y'))]).filter(Number.isFinite);
  const domain=paddedDomain(values,{includeZero:true});xFor=value=>scaleLinear(Number(value),domain,[plotLayout.left,plotLayout.right]);xTicks=Array.from({length:5},(_,index)=>{const value=domain[0]+(domain[1]-domain[0])*index/4;return {x:xFor(value),label:format(value)};});yDomain=domain;
 }
 const shapes=[];
 if(horizontal){for(const tick of xTicks){shapes.push(lineShape(tick.x,layout.top,tick.x,layout.bottom,palette.grid,1));shapes.push(textShape(tick.x,layout.bottom+18,tick.label,palette.muted,9));}shapes.push(lineShape(layout.left,layout.bottom,layout.right,layout.bottom,palette.grid));}
 else {const ticks=[0,1,2,3,4].map(i=>yDomain[0]+(yDomain[1]-yDomain[0])*i/4);shapes.push(...axes(plotLayout,palette,xTicks,ticks,{xLabel:spec.fields?.[spec.chart.encodings[xName]]?.label??xName,yLabel:spec.fields?.[spec.chart.encodings[yName]]?.label??yName,formatY:format}));}
 return {p:{...p,xFor,xTicks},yDomain,yFor,xFor,shapes,positionRows,horizontal,plotLayout};
}
function pathFor(points){return points.map((point,index)=>`${index?'L':'M'} ${point.x} ${point.y}`).join(' ');}
function groupRows(rows){const groups=new Map();for(const row of rows){const key=channel(row,'series')??'Series 1';if(!groups.has(key))groups.set(key,[]);groups.get(key).push(row);}return [...groups.entries()];}
function basicMarks(spec,type,palette,layout,rows,base){
 const shapes=[...base.shapes],{p,yDomain,yFor,xFor}=base,{left,right,bottom,plotWidth,plotHeight,top}=layout;
 const xCats=categories(rows,'x'),slot=plotWidth/Math.max(1,xCats.length),yZero=yFor(Math.max(yDomain[0],Math.min(yDomain[1],0)));
 if(['bar','grouped-bar','stacked-bar','bar-table'].includes(type.id)){
  const groupList=groupRows(rows),stack=spec.chart.options?.stack==='stacked'||spec.chart.options?.stack==='percent'||type.id==='stacked-bar',percent=spec.chart.options?.stack==='percent';
  const totals=new Map();for(const row of rows){const key=channel(row,'x');totals.set(key,(totals.get(key)||0)+(Number(channel(row,'y'))||0));}
  const stacks=new Map();
  for(const [seriesIndex,[series,group]] of groupList.entries())for(const row of group){const category=channel(row,'x'),value=Number(channel(row,'y')),index=xCats.indexOf(category);if(!Number.isFinite(value)||index<0)continue;
   const key=String(category),previous=stack?stacks.get(key)||0:0,actual=percent?(totals.get(category)?value/totals.get(category):0):value,from=stack?previous:0,to=from+actual;if(stack)stacks.set(key,to);
   const width=stack?slot*.66:slot*.68/groupList.length,offset=stack?slot*.17:slot*(.16+seriesIndex*.68/groupList.length),x=left+index*slot+offset,y1=yFor(from),y2=yFor(to),fill=palette.series[seriesIndex%palette.series.length];
   if(type.id==='pyramid'&&channel(row,'side')&&String(channel(row,'side')).toLowerCase()==='left'){const center=left+plotWidth*.5,w=Math.abs(x-y2);shapes.push(rectShape(center-w,y2,w,Math.max(1,yZero-y2),fill));}
   else shapes.push(rectShape(x,Math.min(y1,y2),width,Math.max(1,Math.abs(y1-y2)),fill,{radius:3,title:`${category}: ${format(value)}`}));
   if(type.id==='bar-table'){const label=String(category);shapes.push(textShape(left+index*slot+slot*.5,bottom+34,label,palette.text,10));}
  }
 }else if(type.id==='combo'){
  const slot=plotWidth/Math.max(1,rows.length),points=[];rows.forEach((row,index)=>{const x=xFor(channel(row,'x')),y=yFor(channel(row,'y')),lineValue=channel(row,'y2')??channel(row,'y'),lineY=yFor(lineValue);shapes.push(rectShape(x-slot*.22,y,slot*.44,Math.max(1,bottom-y),palette.series[1],{opacity:.72}));points.push({x,y:lineY});});if(points.length)shapes.push(pathShape(pathFor(points),palette.series[0],'none',2.5));for(const point of points)shapes.push(circleShape(point.x,point.y,3.5,palette.series[0]));
 }else if(type.id==='drawdown'){
  const ordered=base.positionRows,points=ordered.map(row=>({x:xFor(channel(row,'x')),y:yFor(row.values.y),row})),zero=yFor(0);if(points.length){shapes.push(pathShape(`M ${points[0].x} ${zero} ${pathFor(points)} L ${points.at(-1).x} ${zero} Z`,palette.series[0],palette.series[0],1,{opacity:.24}));shapes.push(pathShape(pathFor(points),palette.series[0],'none',2));}const tableRows=ordered.map(row=>[channel(row,'x'),row.values.rawY,row.values.y]);return {shapes,rows:ordered.map((row,index)=>({index,values:{...row.values,drawdown:row.values.y},tableValues:tableRows[index]})),columns:['x','value','drawdown'],tableRows};
 }else if(type.id==='stacked-area'||type.id==='streamgraph'){
  const xValues=categories(rows,'x'),xKind=spec.fields?.[spec.chart.encodings.x]?.kind??'categorical';if(xKind==='temporal'||xKind==='quantitative')xValues.sort((a,b)=>numberValue(a,xKind)-numberValue(b,xKind));const groups=groupRows(rows),valuesBySeries=new Map(groups.map(([name])=>[name,new Map()]));for(const row of rows){const series=channel(row,'series')??'Series 1',x=channel(row,'x'),seriesRows=valuesBySeries.get(series);seriesRows.set(x,(seriesRows.get(x)||0)+(Number(channel(row,'y'))||0));}
  for(const [seriesIndex,[series]] of groups.entries()){let accumulated=new Map(xValues.map(x=>[x,type.id==='streamgraph'?-[...valuesBySeries.values()].reduce((sum,group)=>sum+(group.get(x)||0),0)/2:0]));const upper=[],lower=[];for(const x of xValues){const bottomValue=accumulated.get(x),topValue=bottomValue+(valuesBySeries.get(series).get(x)||0),pointX=xFor(x);lower.push({x:pointX,y:yFor(bottomValue)});upper.push({x:pointX,y:yFor(topValue)});accumulated.set(x,topValue);}if(upper.length){const d=`${pathFor(upper)} L ${[...lower].reverse().map(point=>`${point.x} ${point.y}`).join(' L ')} Z`;shapes.push(pathShape(d,'none',palette.series[seriesIndex%palette.series.length],0,{opacity:.4}));shapes.push(pathShape(pathFor(upper),palette.series[seriesIndex%palette.series.length],'none',1.5));}}
 }else if(['line','area','slope','bump','sparkline'].includes(type.id)){
  for(const [seriesIndex,[series,group]] of groupRows(rows).entries()){
   const sorted=[...group].sort((a,b)=>{const av=channel(a,'x'),bv=channel(b,'x');return typeof av==='number'&&typeof bv==='number'?av-bv:String(av).localeCompare(String(bv));});
   const points=sorted.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'y')),row}));if(!points.length)continue;
   if(type.id==='area'||type.id==='stacked-area'||type.id==='streamgraph'){
    const baseline=type.id==='streamgraph'?top+plotHeight*.5:yZero,d=`M ${points[0].x} ${baseline} ${pathFor(points)} L ${points.at(-1).x} ${baseline} Z`;shapes.push(pathShape(d,'none',palette.series[seriesIndex%palette.series.length],0,{opacity:.28}));
   }
   shapes.push(pathShape(pathFor(points),palette.series[seriesIndex%palette.series.length],'none',2));
   for(const point of points)shapes.push(circleShape(point.x,point.y,3,palette.series[seriesIndex%palette.series.length]));
  }
  if(type.id==='bump')for(const [index,value] of xCats.entries())shapes.push(textShape(left+(index+.5)*plotWidth/xCats.length,bottom+32,String(value),palette.muted,9));
 }else if(['scatter','bubble','connected-scatter','marginal','regression','calibration'].includes(type.id)){
  const points=rows.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'y')),row,rawX:Number(channel(row,'x')),rawY:Number(channel(row,'y'))})).filter(point=>Number.isFinite(point.x)&&Number.isFinite(point.y));
  if(type.id==='connected-scatter')for(const [, [,group]] of groupRows(rows).entries()){const line=group.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'y'))}));shapes.push(pathShape(pathFor(line),palette.series[0],'none',1.8));}
  for(const point of points){const size=type.id==='bubble'?Math.max(4,Math.min(16,Number(channel(point.row,'size'))||6)):type.id==='scatter'&&channel(point.row,'size')?Math.max(3,Math.min(14,Number(channel(point.row,'size'))||4)):4;shapes.push(circleShape(point.x,point.y,size,palette.series[0],{opacity:.78}));}
  if(type.id==='calibration')shapes.push(lineShape(left,bottom,right,top,palette.muted,1,'4 4'));
  if(type.id==='regression'){const fit=regression(rows.map(row=>({x:Number(channel(row,'x')),y:Number(channel(row,'y'))})));if(fit){const [min,max]=extent(rows.map(row=>Number(channel(row,'x'))));shapes.push(pathShape(pathFor([{x:xFor(min),y:yFor(fit.slope*min+fit.intercept)},{x:xFor(max),y:yFor(fit.slope*max+fit.intercept)}]),palette.series[2],'none',2));}}
  if(type.id==='marginal'){const plot=base.plotLayout,xBins=histogram(points.map(point=>point.rawX),10),yBins=histogram(points.map(point=>point.rawY),10),maxX=Math.max(...xBins.map(bin=>bin.count),1),maxY=Math.max(...yBins.map(bin=>bin.count),1),barWidth=plot.plotWidth/Math.max(1,xBins.length);for(const bin of xBins){const height=bin.count/maxX*16,x=xFor((bin.x0+bin.x1)/2);shapes.push(rectShape(x-barWidth/2,layout.top+2,Math.max(1,barWidth-1),Math.max(1,height),palette.series[1],{opacity:.55}));}for(const bin of yBins){const y0=yFor(bin.x0),y1=yFor(bin.x1),width=bin.count/maxY*15;shapes.push(rectShape(plot.right+2,Math.min(y0,y1),Math.max(1,width),Math.max(1,Math.abs(y1-y0)-1),palette.series[1],{opacity:.55}));}}
 }else if(type.id==='lollipop'){
  for(const [index,row] of rows.entries()){const x=xFor(channel(row,'x')),y=yFor(channel(row,'y'));shapes.push(lineShape(x,yZero,x,y,palette.series[index%palette.series.length],2));shapes.push(circleShape(x,y,5,palette.series[index%palette.series.length]));}
 }else if(type.id==='dumbbell'){
  for(const [index,row] of rows.entries()){const x=left+(index+.5)*plotWidth/rows.length,y1=yFor(channel(row,'start')),y2=yFor(channel(row,'end'));shapes.push(lineShape(x,y1,x,y2,palette.muted,3));shapes.push(circleShape(x,y1,5,palette.series[0]));shapes.push(circleShape(x,y2,5,palette.series[2]));}
  rows.forEach((row,index)=>shapes.push(textShape(left+(index+.5)*plotWidth/rows.length,bottom+34,channel(row,'x'),palette.muted,9)));
 }else if(type.id==='range-area'||type.id==='forecast-fan'){
  const sorted=[...rows].sort((a,b)=>String(channel(a,'x')).localeCompare(String(channel(b,'x'))));const upper=sorted.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'high'))})),lower=sorted.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'low'))})).reverse();
  if(upper.length)shapes.push(pathShape(`${pathFor(upper)} ${pathFor(lower)} Z`,palette.series[1],palette.series[1],1,{opacity:.24}));const center=sorted.map(row=>({x:xFor(channel(row,'x')),y:yFor(channel(row,'y'))}));if(center.length)shapes.push(pathShape(pathFor(center),palette.series[0],'none',2));
 }else if(type.id==='candlestick'){
  const slot=plotWidth/Math.max(1,rows.length),width=Math.max(3,slot*.52);for(const [index,row] of rows.entries()){const x=left+(index+.5)*slot,low=yFor(channel(row,'low')),high=yFor(channel(row,'high')),open=yFor(channel(row,'open')),close=yFor(channel(row,'close')),up=Number(channel(row,'close'))>=Number(channel(row,'open')),color=up?palette.series[0]:palette.series[2];shapes.push(lineShape(x,high,x,low,color,1.5));shapes.push(rectShape(x-width/2,Math.min(open,close),width,Math.max(2,Math.abs(open-close)),color));}
 }else if(type.id==='bullet'){
  const baseline=xFor(0),slot=plotHeight/Math.max(1,rows.length);for(const [index,row] of rows.entries()){const y=top+(index+.5)*slot,measure=xFor(channel(row,'y')),target=xFor(channel(row,'target'));shapes.push(rectShape(left,y-8,plotWidth,16,palette.grid));if(channel(row,'low')!==undefined&&channel(row,'high')!==undefined){const a=xFor(channel(row,'low')),b=xFor(channel(row,'high'));shapes.push(rectShape(Math.min(a,b),y-8,Math.abs(b-a),16,palette.series[1],{opacity:.24}));}shapes.push(rectShape(Math.min(baseline,measure),y-4,Math.max(1,Math.abs(measure-baseline)),8,palette.series[0]));shapes.push(lineShape(target,y-12,target,y+12,palette.text,2));shapes.push(textShape(left-6,y+3,channel(row,'x'),palette.muted,9,'end'));}
 }else if(type.id==='pyramid'){
  const categoriesList=categories(rows,'x'),max=Math.max(...rows.map(row=>Math.abs(Number(channel(row,'y'))||0)),1),center=left+plotWidth/2,slot=plotHeight/Math.max(1,categoriesList.length);shapes.push(lineShape(center,top,center,bottom,palette.grid,1));for(const row of rows){const index=categoriesList.indexOf(channel(row,'x')),value=Number(channel(row,'y'))||0,side=String(channel(row,'side')).toLowerCase(),width=Math.abs(value)/max*plotWidth*.45,y=top+(index+.5)*slot,x=side==='left'?center-width:center;shapes.push(rectShape(x,y-slot*.28,width,slot*.56,palette.series[side==='left'?0:2],{title:`${channel(row,'x')}: ${format(value)}`}));shapes.push(textShape(side==='left'?x-6:x+width+6,y+3,channel(row,'x'),palette.muted,9,side==='left'?'end':'start'));}
 }else if(type.id==='ranged-dot'){
  const slot=plotHeight/Math.max(1,rows.length);for(const [index,row] of rows.entries()){const y=top+(index+.5)*slot,x0=xFor(channel(row,'low')),x1=xFor(channel(row,'high')),point=channel(row,'point')??(Number(channel(row,'low'))+Number(channel(row,'high')))/2;shapes.push(lineShape(x0,y,x1,y,palette.series[1],4));shapes.push(circleShape(xFor(point),y,5,palette.series[0]));shapes.push(textShape(left-6,y+3,channel(row,'x'),palette.muted,9,'end'));}
 }else if(type.id==='parallel-coordinates'){
  const dimensions=Object.keys(spec.chart.encodings).filter(name=>name.startsWith('dimension')).sort((a,b)=>Number(a.slice(9))-Number(b.slice(9)));const xForDimension=index=>left+(dimensions.length<2?0:index*plotWidth/(dimensions.length-1));
  for(const [index,row] of rows.entries()){const points=dimensions.map((dimension,dimensionIndex)=>{const values=rows.map(item=>Number(channel(item,dimension))).filter(Number.isFinite),domain=paddedDomain(values);const y=top+plotHeight-(Number(channel(row,dimension))-domain[0])/(domain[1]-domain[0]||1)*plotHeight;return {x:xForDimension(dimensionIndex),y};});shapes.push(pathShape(pathFor(points),palette.series[index%palette.series.length],'none',1.5,{opacity:.68}));}
  dimensions.forEach((dimension,index)=>{const x=xForDimension(index);shapes.push(lineShape(x,top,x,bottom,palette.grid));shapes.push(textShape(x,bottom+18,spec.fields?.[spec.chart.encodings[dimension]]?.label??dimension,palette.muted,9));});
 }else if(type.id==='market-depth'){
  const sides=new Map();for(const row of rows){const side=String(channel(row,'side')).toLowerCase(),name=side.includes('bid')||side.includes('매')?'bid':'ask';if(!sides.has(name))sides.set(name,[]);sides.get(name).push(row);}for(const [name,group] of sides){const bid=name==='bid',ordered=[...group].sort((a,b)=>bid?Number(channel(b,'price'))-Number(channel(a,'price')):Number(channel(a,'price'))-Number(channel(b,'price')));let accumulated=0;const points=ordered.map(row=>{accumulated+=Number(channel(row,'quantity'))||0;return {x:xFor(channel(row,'price')),y:yFor(channel(row,'cumulative')??accumulated)};});const color=bid?palette.series[0]:palette.series[2];if(points.length>1)shapes.push(pathShape(pathFor(points),color,'none',2.5));for(const point of points)shapes.push(circleShape(point.x,point.y,3.5,color));shapes.push(textShape(bid?left+8:right-8,top+14,bid?'Bid':'Ask',color,10,bid?'start':'end',600));}
 }else if(type.id==='orderbook'){
  for(const row of rows){const side=String(channel(row,'side')).toLowerCase(),x=xFor(channel(row,'price')),value=Number(channel(row,'cumulative')??channel(row,'quantity'))||0,y=yFor(value),color=side.includes('bid')||side.includes('매')?palette.series[0]:palette.series[2],width=plotWidth/rows.length*.6;shapes.push(circleShape(x,y,3.5,color));shapes.push(rectShape(x-width/2,y,width,Math.max(1,bottom-y),color,{opacity:.32}));}
  const sides=categories(rows,'side');shapes.push(...sides.map((side,index)=>textShape(left+48+index*100,top+16,String(side),palette.series[index%palette.series.length],10,'start',600)));
 }
 const columns=Object.keys(spec.chart.encodings),table=valueRows(rows,columns),plotRows=rows.map((row,index)=>({index,values:row.values,tableValues:table.rows[index]}));
 return {shapes,rows:plotRows,columns:table.columns,tableRows:table.rows};
}
export function compileCartesian(spec,type,palette,layout,rows=fieldRows(spec)){const base=baseCartesian(spec,type,palette,layout,rows),result=basicMarks(spec,type,palette,layout,rows,base);return {shapes:result.shapes,rows:result.rows,table:{columns:result.columns??Object.keys(spec.chart.encodings),rows:result.tableRows},diagnostics:[]};}
