import {paddedDomain} from '../klic-chart-math.mjs';
import {circleShape,fieldRows,lineShape,pathShape,rectShape,textShape} from './base.mjs';
export function compileFlowSpatial(spec,type,palette,layout,rows=fieldRows(spec)){
 const shapes=[],tableRows=[];
 if(type.id==='sankey'){
  const links=rows.map(row=>({row,source:row.values.source,target:row.values.target,value:Math.max(0,Number(row.values.value)||0)})),leftNodes=[...new Set(links.map(link=>link.source))],rightNodes=[...new Set(links.map(link=>link.target))],leftTotals=new Map(leftNodes.map(name=>[name,links.filter(link=>link.source===name).reduce((sum,link)=>sum+link.value,0)])),rightTotals=new Map(rightNodes.map(name=>[name,links.filter(link=>link.target===name).reduce((sum,link)=>sum+link.value,0)])),nodeWidth=Math.min(22,layout.plotWidth*.08),gap=4,total=links.reduce((sum,link)=>sum+link.value,0),available=Math.max(1,layout.plotHeight-gap*Math.max(0,Math.max(leftNodes.length,rightNodes.length)-1)),scale=total?available/total:0,position=new Map();
  const place=(names,totals,side)=>{const heights=names.map(name=>(totals.get(name)||0)*scale),occupied=heights.reduce((sum,height)=>sum+height,0)+gap*Math.max(0,names.length-1);let cursor=layout.top+(layout.plotHeight-occupied)/2;for(const [index,name] of names.entries()){const height=heights[index],x=side==='left'?layout.left:layout.right-nodeWidth;position.set(`${side==='left'?'l':'r'}:${name}`,{x,y:cursor+height/2,height,color:palette.series[index%palette.series.length]});cursor+=height+gap;}};place(leftNodes,leftTotals,'left');place(rightNodes,rightTotals,'right');
  const sourceCursor=new Map(leftNodes.map(name=>[name,position.get(`l:${name}`).y-position.get(`l:${name}`).height/2])),targetCursor=new Map(rightNodes.map(name=>[name,position.get(`r:${name}`).y-position.get(`r:${name}`).height/2]));
  for(const link of links){const from=position.get(`l:${link.source}`),to=position.get(`r:${link.target}`);if(!from||!to)continue;const thickness=link.value*scale,y1=(sourceCursor.get(link.source)??from.y)+thickness/2,y2=(targetCursor.get(link.target)??to.y)+thickness/2;sourceCursor.set(link.source,(sourceCursor.get(link.source)??from.y)+thickness);targetCursor.set(link.target,(targetCursor.get(link.target)??to.y)+thickness);shapes.push({kind:'path',d:`M ${from.x+nodeWidth} ${y1} C ${(from.x+to.x)/2} ${y1}, ${(from.x+to.x)/2} ${y2}, ${to.x} ${y2}`,stroke:palette.series[0],fill:'none',width:Math.max(.5,thickness),opacity:.34});tableRows.push([link.source,link.target,link.value]);}
  for(const name of leftNodes){const node=position.get(`l:${name}`);shapes.push(rectShape(node.x,node.y-node.height/2,nodeWidth,node.height,node.color,{radius:3}));shapes.push(textShape(node.x+nodeWidth+5,node.y+3,name,palette.text,9,'start'));}
  for(const name of rightNodes){const node=position.get(`r:${name}`);shapes.push(rectShape(node.x,node.y-node.height/2,nodeWidth,node.height,node.color,{radius:3}));shapes.push(textShape(node.x-5,node.y+3,name,palette.text,9,'end'));}
 }else if(type.id==='network-graph'||type.id==='tree'){
  const fromName=type.id==='tree'?'parent':'source',toName=type.id==='tree'?'child':'target',nodes=[...new Set(rows.flatMap(row=>[row.values[fromName],row.values[toName]]))],cx=(layout.left+layout.right)/2,cy=(layout.top+layout.bottom)/2,r=Math.min(layout.plotWidth,layout.plotHeight)*.36,positions=new Map();
  if(type.id==='tree'){
   const childSet=new Set(rows.map(row=>row.values[toName])),roots=nodes.filter(node=>!childSet.has(node)),level=new Map(roots.map(node=>[node,0]));for(let pass=0;pass<nodes.length;pass++)for(const row of rows){const parentLevel=level.get(row.values[fromName]);if(parentLevel!==undefined&&!level.has(row.values[toName]))level.set(row.values[toName],parentLevel+1);}for(const node of nodes)if(!level.has(node))level.set(node,0);const maxLevel=Math.max(...level.values(),1),byLevel=new Map();for(const node of nodes){const depth=level.get(node);if(!byLevel.has(depth))byLevel.set(depth,[]);byLevel.get(depth).push(node);}for(const [depth,items] of byLevel)items.forEach((name,index)=>positions.set(name,{x:layout.left+24+(maxLevel?depth/maxLevel:0)*(layout.plotWidth-48),y:layout.top+(index+1)*layout.plotHeight/(items.length+1)}));
  }else nodes.forEach((name,index)=>positions.set(name,{x:cx+r*Math.cos(index/nodes.length*Math.PI*2-Math.PI/2),y:cy+r*Math.sin(index/nodes.length*Math.PI*2-Math.PI/2)}));
  rows.forEach(row=>{const from=positions.get(row.values[fromName]),to=positions.get(row.values[toName]);if(from&&to)shapes.push(lineShape(from.x,from.y,to.x,to.y,palette.grid,Math.min(5,Number(row.values.weight)||1)));tableRows.push([row.values[fromName],row.values[toName],row.values.weight??1]);});
  nodes.forEach((name,index)=>{const point=positions.get(name);shapes.push(circleShape(point.x,point.y,9,palette.series[index%palette.series.length]));shapes.push(textShape(point.x,point.y-14,name,palette.text,9));});
 }else{
  const features=spec.geometry?.features??[],valueByRegion=new Map(rows.map(row=>[String(row.values.region),Number(row.values.value)]));
  const points=[];for(const feature of features){const geometry=feature.geometry,polys=geometry.type==='Polygon'?[geometry.coordinates]:geometry.coordinates;for(const polygon of polys)for(const ring of polygon)for(const point of ring)points.push(point);}
  const xs=points.map(point=>point[0]),ys=points.map(point=>point[1]),minX=Math.min(...xs),maxX=Math.max(...xs),minY=Math.min(...ys),maxY=Math.max(...ys),pad=14,innerW=layout.plotWidth-pad*2,innerH=layout.plotHeight-pad*2,scale=Math.min(innerW/(maxX-minX||1),innerH/(maxY-minY||1)),usedW=(maxX-minX)*scale,usedH=(maxY-minY)*scale,offsetX=layout.left+pad+(innerW-usedW)/2,offsetY=layout.top+pad+(innerH-usedH)/2;
  const project=point=>({x:offsetX+(point[0]-minX)*scale,y:offsetY+(maxY-point[1])*scale}),values=[...valueByRegion.values()].filter(Number.isFinite),domain=paddedDomain(values);
  for(const feature of features){const region=String(feature.id),value=valueByRegion.get(region),polys=feature.geometry.type==='Polygon'?[feature.geometry.coordinates]:feature.geometry.coordinates,color=type.id==='map'?palette.series[0]:Number.isFinite(value)?palette.series[Math.max(0,Math.min(palette.series.length-1,Math.round((value-domain[0])/(domain[1]-domain[0]||1)*(palette.series.length-1))))]:palette.grid;for(const polygon of polys){const commands=polygon.map(ring=>ring.map((point,index)=>{const projected=project(point);return `${index?'L':'M'} ${projected.x} ${projected.y}`;}).join(' ')+' Z').join(' ');shapes.push({kind:'path',d:commands,fill:color,stroke:palette.background,width:1,opacity:.78,fillRule:'evenodd'});}tableRows.push(type.id==='choropleth'?[region,value??'—']:[region,'Polygon']);}
  const columns=type.id==='choropleth'?['Region','Value']:['Region','Geometry type'];return {shapes,rows:tableRows.map((tableValues,index)=>({index,values:{},tableValues})),table:{columns,rows:tableRows},diagnostics:[]};
 }
 const columns=type.id==='sankey'?['Source','Target','Value']:type.id==='tree'?['Parent','Child','Link value']:['Source','Target','Weight'];return {shapes,rows:tableRows.map((tableValues,index)=>({index,values:{},tableValues})),table:{columns,rows:tableRows},diagnostics:[]};
}
