section.klic-flowmotion{--fm-panel:var(--klic-component-block-color-panel,#fff);--fm-surface:var(--klic-component-block-color-surface,#fbfcfe);--fm-soft:var(--klic-component-block-color-soft,#f5f7fb);--fm-text:var(--klic-component-block-color-text,#132c46);--fm-muted:var(--klic-component-block-color-muted,#52657b);--fm-border:var(--klic-component-block-color-border,#dfe5ee);--fm-control-border:var(--klic-component-block-color-control-border,#7e8fa7);--fm-accent:var(--klic-component-block-color-accent,#245fc2);--fm-accent-hover:var(--klic-component-block-color-accent-hover,#1c4fa4);--fm-selected:var(--klic-component-block-color-selected,#eaf0fb);--fm-on-accent:var(--klic-component-block-color-on-accent,#fff);--fm-warning:var(--klic-component-block-color-warning,#835600);--fm-danger:var(--klic-component-block-color-danger,#b13c43);container-type:inline-size;box-sizing:border-box;min-width:0;width:100%;color:var(--fm-text);background:var(--fm-panel);border:1px solid var(--fm-border);border-radius:var(--klic-component-block-surface-radius,8px);font-family:var(--klic-component-text-body-font-family,system-ui,sans-serif);font-size:calc(13px * var(--runtime-text-scale,1));overflow:hidden}
.klic-flowmotion .fm-block-header{display:flex;gap:16px;align-items:flex-start;justify-content:space-between;padding:20px;border-bottom:1px solid var(--fm-border)}
.klic-flowmotion .fm-block-eyebrow{font-size:.85em;letter-spacing:.04em;color:var(--fm-muted)}
.klic-flowmotion .fm-block-header h2{font-size:1.4em;font-weight:700;margin:6px 0;line-height:1.4}.klic-flowmotion .fm-block-header p{margin:0;max-width:75ch;line-height:1.6;color:var(--fm-muted)}
.klic-flowmotion .fm-block-sample{flex:none;background:var(--fm-selected);color:var(--fm-accent);border-radius:6px;padding:5px 8px;font-size:.85em}
.klic-flowmotion .fm-block-toolbar{display:flex;align-items:end;flex-wrap:wrap;gap:8px;padding:14px 20px;background:var(--fm-soft)}
.klic-flowmotion :is(.fm-block-toolbar,.fm-block-inspector) label{display:flex;flex-direction:column;gap:5px;font-weight:600;min-width:0}
.klic-flowmotion :is(.fm-block-toolbar,.fm-block-inspector) select{max-width:100%;min-height:34px;background:var(--fm-panel);color:var(--fm-text);border:1px solid var(--fm-control-border);border-radius:6px;padding:6px 28px 6px 9px;font:inherit}
.klic-flowmotion .fm-block-toolbar button{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:34px;border:1px solid var(--fm-control-border);border-radius:6px;background:var(--fm-panel);color:var(--fm-text);padding:6px 10px;font:inherit;cursor:pointer}
.klic-flowmotion .fm-block-toolbar button:hover{background:var(--fm-selected)}.klic-flowmotion .fm-block-toolbar button:disabled{opacity:.45;cursor:default}.klic-flowmotion :is(button,select,input):focus-visible{outline:2px solid var(--fm-accent);outline-offset:2px}
.klic-flowmotion .fm-block-toolbar .fm-block-check{flex-direction:row;align-items:center;min-height:34px}.klic-flowmotion input{accent-color:var(--fm-accent)}
.klic-flowmotion .fm-block-zoom{display:flex;align-items:center;gap:5px;margin-left:auto}.klic-flowmotion .fm-block-zoom output{min-width:45px;text-align:center;font-variant-numeric:tabular-nums}
.klic-flowmotion .fm-block-scenario{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:10px 20px;margin:0;border-bottom:1px solid var(--fm-border);color:var(--fm-muted)}.klic-flowmotion .fm-block-scenario svg,.klic-flowmotion .fm-block-scenario strong{color:var(--fm-accent)}
.klic-flowmotion .fm-block-timeline{display:flex;align-items:center;gap:12px;padding:10px 20px}.klic-flowmotion .fm-block-timeline input{min-width:60px;flex:1}.klic-flowmotion .fm-block-timeline output{white-space:nowrap;font-variant-numeric:tabular-nums}
.klic-flowmotion .fm-block-layout{display:grid;grid-template-columns:minmax(0,1fr) 248px;min-width:0;border-top:1px solid var(--fm-border)}
.klic-flowmotion .fm-block-scene{height:620px;min-width:0;max-width:100%;overflow:auto;position:relative;isolation:isolate;background:var(--fm-surface)}
.klic-flowmotion .fm-block-scene>div{min-width:0;max-width:100%}
.klic-flowmotion .fm-block-inspector{padding:16px;min-width:0;border-left:1px solid var(--fm-border);background:var(--fm-panel)}.klic-flowmotion .fm-block-inspector h3{font-size:1.1em;font-weight:700;margin:18px 0 6px}.klic-flowmotion .fm-block-inspector p{line-height:1.6;color:var(--fm-muted);overflow-wrap:anywhere}.klic-flowmotion .fm-block-inspector dl{margin:14px 0}.klic-flowmotion .fm-block-inspector dl>div{display:flex;gap:10px;justify-content:space-between;border-bottom:1px solid var(--fm-border);padding:8px 0}.klic-flowmotion .fm-block-inspector dd{margin:0;color:var(--fm-accent)}.klic-flowmotion .fm-block-inspector pre{font-size:.85em;white-space:pre-wrap;overflow-wrap:anywhere;padding:10px;background:var(--fm-soft);border-radius:6px}.klic-flowmotion .fm-block-inspector summary{cursor:pointer}
.klic-flowmotion .fm-block-footer{padding:12px 20px;line-height:1.6;border-top:1px solid var(--fm-border);color:var(--fm-muted);font-size:.9em}
.klic-flowmotion .flow-dot-grid{background-color:var(--fm-surface);background-image:radial-gradient(var(--fm-border) 1.35px,transparent 1.35px);background-size:20px 20px}
.klic-flowmotion .font-mono-tabular{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}
@keyframes klicFlowBlockDash{from{stroke-dashoffset:24}to{stroke-dashoffset:0}}
.klic-flowmotion .animate-flow-dash{animation:klicFlowBlockDash .75s linear infinite}
.klic-flowmotion[data-fm-playing=false] :is(.animate-flow-dash,.animate-spin){animation-play-state:paused}
.klic-flowmotion[data-fm-reduced=true] :is(.animate-flow-dash,.animate-spin){animation:none}
@media(prefers-reduced-motion:reduce){.klic-flowmotion .animate-flow-dash{animation:none}}
@container(max-width:1100px){.klic-flowmotion .fm-block-layout{grid-template-columns:minmax(0,1fr)}.klic-flowmotion .fm-block-inspector{border-left:0;border-top:1px solid var(--fm-border)}.klic-flowmotion .fm-block-inspector dl{display:flex;flex-wrap:wrap;gap:16px}.klic-flowmotion .fm-block-inspector dl>div{gap:14px}}
@container(max-width:540px){.klic-flowmotion .fm-block-header{padding:14px;flex-direction:column;gap:8px}.klic-flowmotion .fm-block-toolbar,.klic-flowmotion .fm-block-scenario,.klic-flowmotion .fm-block-timeline{padding:10px 14px}.klic-flowmotion .fm-block-toolbar>label:first-child{width:100%}.klic-flowmotion .fm-block-zoom{margin-left:0}.klic-flowmotion .fm-block-timeline{flex-wrap:wrap}.klic-flowmotion .fm-block-timeline input{min-width:100px}.klic-flowmotion .fm-block-scene{height:560px}}
