lic.component.block.content.max-width","klic.component.block.right-panel.width.default"],"requirements":["FR18","FR19","FR22","FR27","AT09","AT19"],"sources":["dist/component-guides.mjs","dist/resize-lab.mjs","dist/app.js"],"checks":["tests/resize-lab.test.mjs","tests/component-guides.test.mjs"]},{"id":"spacing-grouping","title":"간격과 그룹화","tokenControl":"내부 gap·padding·그룹 사이 간격과 승인 밀도 매핑","structureControl":"label·fieldset·legend·describedby 등의 관계; 창 폭만으로 밀도를 변경하지 않음","check":"밀도 전환 시 글자 역할·오류 안내·필드 관계와 조작 가능성 보존","tokenPaths":["klic.component.field.spacing.internal","klic.component.card.spacing.default","klic.component.block.section.gap"],"requirements":["FR12","FR13","AT06","AT10"],"sources":["dist/preferences.mjs","dist/tokens.mjs","dist/component-guides.mjs"],"checks":["tests/preferences.test.mjs","tests/component-guides.test.mjs"]},{"id":"surface-depth","title":"표면과 깊이","tokenControl":"표면색·반경·경계 및 지원 color/dimension 소재 leaf","structureControl":"blur·shadow 합성 recipe·stacking·보조 패널과 모달 구분·불투명 fallback","check":"포커스와 오류가 장식에 가려지지 않는지, fallback과 강제 색상 조건 확인","tokenPaths":["klic.component.surface.card.background","klic.component.surface.card.fallback","klic.component.card.radius.default"],"requirements":["FR10","FR22","FR30","AT15","AT20"],"sources":["dist/materials.mjs","dist/component-guides.mjs"],"checks":["tests/materials.test.mjs","tests/material-context.test.mjs"]},{"id":"interaction-feedback","title":"상호작용과 피드백","tokenControl":"focus·선택·진행·성공·경고·오류의 시각 역할","structureControl":"키보드·focus 이동·비동기 전이·실행 차단·입력 보존·복구 경로","check":"invalid+focus·selected+hover+focus, 연속 실행과 부분 실패의 실제 결과","tokenPaths":["klic.component.interaction.focus.color","klic.component.button.background.hover","klic.semantic.color.success"],"requirements":["FR23","FR24","FR27","FR31","AT12","AT13","AT14","AT19","AT21"],"sources":["dist/app.js","dist/component-interactions.mjs","dist/component-guides.mjs"],"checks":["tests/component-guides.test.mjs","tests/token-contract.test.mjs"]}],"conflictResolution":[{"id":"preserve-task","title":"정보·조작·접근성을 먼저 보존","rule":"핵심 정보·상태 의미·입력·focus와 조작 경로를 보존한다. 디멘션 번호로 다른 필수 계약을 무효화하지 않는다."},{"id":"reflow","title":"구조와 읽기 순서를 재배치","rule":"줄바꿈·열 전환·행동 묶음·패널 배치를 먼저 조정한다. 의미상 필요한 2차원 영역만 국소 스크롤을 사용한다."},{"id":"adjust-expression","title":"승인 범위에서 간격·표면 조정","rule":"사용자가 선택한 밀도와 글자 배율을 존중하며 승인된 recipe 안에서 여백·장식을 조정한다. 공간 부족만으로 자동 compact나 글자 축소를 적용하지 않는다."},{"id":"record-exception","title":"남는 제약과 검증을 기록","rule":"기본값으로 해결되지 않으면 적용 범위·대안·영향·FR/AT·실제 검증을 기록한다. 토큰 계층을 건너뛰거나 검증 실패를 예외 승인으로 덮지 않는다."}],"presetPolicy":{"kind":"configuration-recipe","description":"Preset은 기존 API의 승인된 설정 조합이며 토큰의 다섯 번째 계층이 아니다.","allowed":"해당 컴포넌트 API가 실제 지원하는 size·variant·density·layout 등 명시적 allowlist","excluded":["label·설명·업무 데이터","value·selection·validation·request 상태","이벤트 핸들러·복구 액션·권한","원시 스타일 값·미등록 CSS 변수·임의 토큰 override"],"precedence":"컴포넌트 기본값 → 선택한 preset → 허용된 명시적 설정. 업무 데이터·상태·권한은 별도 입력으로 처리한다.","validation":"허용 키·enum·조합을 검사하고 모르는 값은 진단한다. 타입 선언과 실제 DOM·동작 검증을 구분한다.","currentExample":"KLIC Core·Studio·Data는 brand-profiles.mjs의 BRAND_PROFILE_KEYS로 범위를 정한 실제 프로필 조합이다. 이 정책이 새로운 FieldGroup 패키지 API를 제공한다는 뜻은 아니다."},"provenance":{"tokenLiteralOwnership":"Primitive만 literal 소유. Brand→Primitive, Semantic→Brand, Component→Semantic 인접 참조 유지.","recipeBoundary":"토큰 정의, DOM/CSS recipe의 구조 조건, 컴파일된 최종 literal 출력을 구분한다.","motionCatalogBoundary":"모션 레시피는 컴포넌트·블록 설치 항목과 별도 읽기 카탈로그로 유지하되, 브라우저 검색·미리보기·상세 UI는 KLIC Interface Library 홈페이지의 #motion 메뉴에서 제공한다. 읽기 API·CLI·MCP·WebMCP도 같은 카탈로그 스냅샷을 사용한다. NPM 패키지는 홈페이지 배포와 별도 산출물로 관리한다. 현재 발행하는 모션은 KLIC 자체 제작 콘텐츠로 한정한다.","verification":"sources/checks는 연결 근거이며 통과 인증이 아니다. 제품별 실제 환경 검증 결과는 기존 FR/AT 기록에서 관리한다."},"adoptionPolicy":{"selection":"외부 문서와 초안은 검토 후보로 취급한다. KLIC의 현재 문제·구현·계약을 확인하고 필요한 규칙만 채택하며, 보류·기각의 이유와 적용 범위를 남긴다.","evidence":"참고 문서의 제품명·예제 API·출처를 KLIC의 구현 사실로 옮기지 않는다. 채택한 규칙은 실제 토큰·DOM·CSS recipe·상태 처리와 검증 근거에 연결한다."},"changePolicy":{"scope":"문제 제기는 관련 사용 경로 전체의 변경 영향을 검토하는 출발점이다. 사용자가 언급한 화면이나 도구만 수정하고 완료로 처리하지 않는다.","surfaces":["구현 원본·토큰·컴포넌트·타입·스키마","DOCS·웹 가이드·개발자 문서·예제","MCP·CLI·WebMCP·API의 설명·입력·응답","AI 프롬프트·llms.txt·소스와 테마 내보내기","회귀 검사·빌드·운영 배포와 실제 응답"],"completion":"정본을 수정한 뒤 관련 가이드·예제·도구·프롬프트·내보내기를 함께 재생성하고 같은 리비전을 검사한다. 영향을 받지 않는 경로는 이유를 기록하며, 실제 확인한 결과와 남은 미검증 조건을 구분해 보고한다."},"links":{"definition":"/api/v1/design-system.json","architecture":"/design/architecture.json","docs":"/#docs/architecture","requirements":"/design/requirements-v1.1.json"},"revision":"80cf180090cfaba13597872589dd066fbbdf788bfe6b0e72ca8d2218774c474f"},"release":"3e14e5c57ae74252","item":{"kind":"block","id":"card-api-integration","name":"스폰서 파트너 & 공식 제휴사 듀얼 카드","description":"더블 베젤 아우터 프레임 내부에 스폰서 결제 파트너와 글로벌 공식 제휴사 카드를 좌우 배치하고 브랜드 아이콘 타일을 제공하는 카드입니다.","category":"app-cards","categoryName":"카드","collection":"applications","tags":["card-api-integration","파트너 & 제휴 듀얼 카드","스폰서 파트너 & 공식 제휴사 듀얼 카드","카드","CardShowcaseBlock","initialMode=partner-split","NEW","Sponsor and official partner cards","A card with sponsored payment partners and official global partners arranged side by side inside a double-bezel frame, accompanied by brand icon tiles.","Cards"],"status":"ready","route":"#blocks/card-api-integration/preview","docsRoute":"#blocks/card-api-integration/axes","source":{"path":"/block-sources/components/blocks/CardShowcaseBlock.tsx","language":"tsx","usage":"reference","module":"CardShowcaseBlock","variant":"같은 CardShowcaseBlock 구현 모듈의 initialMode=partner-split 변형입니다.","manifest":"/block-sources/manifest.json","notice":"Preserve source license headers. The module depends on sibling sources, styles, assets and the React runtime."},"design":{"delivery":{"type":"reference-library","npmPackagePublished":true,"npmPackage":{"name":"klic-design","version":"0.0.2","published":true,"status":"published","registry":"https://registry.npmjs.org/","runtime":"Bun 1.4.2 preferred; Node.js 22+ supported","exports":["tokens","theme","motion","components","blocks","Agent Skill","CSS","TypeScript","CLI"],"skillPath":"skills/klic-design/SKILL.md","buildCommand":"bun run pack:npm","integrity":"sha512-l/DfatLGn2c5o4TTbjfynmpNj9Dgp9oIPMk/kJXKpnJTM2sDbpSxNeE9uTlAXlxVRMi45TXOSdXNxsqyDvYLhA==","installCommand":"bun add klic-design@0.0.2","cliCommand":"bunx --bun --package=klic-design@0.0.2 klic","nodeCliCommand":"npx --yes --package=klic-design@0.0.2 klic"},"scope":"/about","licenses":"/licenses/README.md"},"system":{"schemaVersion":"1.0","revision":"80cf180090cfaba13597872589dd066fbbdf788bfe6b0e72ca8d2218774c474f","definition":"/api/v1/design-system.json","docs":"/#docs/architecture"},"schemaVersion":"1.0","scope":"adoption-guidance","implementation":"react-demo","use":["「스폰서 파트너 & 공식 제휴사 듀얼 카드」의 용도: 더블 베젤 아우터 프레임 내부에 스폰서 결제 파트너와 글로벌 공식 제휴사 카드를 좌우 배치하고 브랜드 아이콘 타일을 제공하는 카드입니다.","스폰서 파트너 & 공식 제휴사 듀얼 카드 · 카드 분류.","제목·설명·관련 메타데이터·반복 콘텐츠·주요 행동을 묶는다. 카드 전체 링크와 내부 버튼의 중첩을 피하고 각 행동의 이름을 유지한다."],"avoid":["카드 전체 행동과 내부 버튼을 중첩하지 않습니다.","샘플 데이터·로컬 상호작용을 실제 저장·인증·운영 기능으로 표시하지 않습니다."],"accessibility":["카드·목록의 링크와 내부 버튼을 각각 이름 있는 독립 행동으로 제공한다. 시각 순서와 Tab 순서를 일치시킨다.","모든 조작의 이름·보이는 초점·실제 target 경계를 확인한다. reduced-motion에서도 기능에 필요한 상태 안내를 유지한다.","반복 카드는 여러 열에서 한 열로 재배치한다. 긴 제목·메타·행동은 줄바꿈하며 고정 높이로 잘라내지 않는다.","CSS viewport·실제 콘텐츠 컨테이너·사용자 확대·명시적 density를 별개의 시험 조건으로 기록한다."],"density":{"compact":"반복 목록에서만 여백을 줄이고 주요 행동 간격은 유지합니다.","normal":"기본 권장 밀도입니다. 읽기 순서와 레이블·컨트롤·피드백 그룹을 유지합니다.","relaxed":"설명 중심·프레젠테이션 화면에 사용합니다. 정보 계층을 유지하며 여백을 늘립니다."},"states":[{"name":"데이터 생명주기","condition":"조합 정책","response":"로딩·빈 목록·검색 0건·선택·확장·행동 실패를 구분한다. 필터 변경과 재시도 후 선택·입력·스크롤 보존 범위를 명시한다."},{"name":"완료·선택","condition":"조합 정책","response":"완료·성공은 블루와 체크·명시적 문구로 전달한다. hover가 selected·invalid·focus 의미를 지우지 않도록 한다."}],"recovery":{"loading":"진행 중임을 알리고 중복 요청을 차단합니다. 기존 데이터가 있으면 갱신 중에도 유지합니다.","empty":"처음부터 데이터가 없는 상태에는 생성·연결 행동을 제공합니다.","filtered":"검색 결과가 없으면 데이터 없음과 구분하고 필터 초기화 행동을 제공합니다.","error":"마지막 정상 데이터를 보존하고 실패 영역에 재시도를 제공합니다."},"tokenMapping":[{"path":"klic.component.block.color.surface","purpose":"페이지 표면","cssV