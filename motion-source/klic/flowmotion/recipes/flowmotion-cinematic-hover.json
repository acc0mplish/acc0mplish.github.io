        }
      ]
    }
  },
  "definition": {
    "html": "<style>.fm-root{--fm-blue:var(--klic-semantic-color-accent,#245fc2);--fm-navy:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-component-card-background-default,var(--klic-semantic-color-panel,#fff));--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);--fm-muted:var(--klic-semantic-color-muted,#52657b);--fm-on-blue:var(--klic-semantic-color-on-accent,#fff);--fm-selected:var(--klic-semantic-color-surface-selected,#e4ecfc);box-sizing:border-box;width:100%;height:100%;color:var(--fm-navy);font-family:inherit}.fm-root *{box-sizing:inherit}.fm-root svg{display:block;width:100%;height:100%;overflow:visible;font-family:inherit}.fm-root .fm-surface{fill:var(--fm-surface)}.fm-root .fm-panel{fill:var(--fm-panel);stroke:var(--fm-border)}.fm-root .fm-blue{fill:var(--fm-blue)}.fm-root .fm-blue-stroke{stroke:var(--fm-blue)}.fm-root .fm-ink{fill:var(--fm-navy)}.fm-root .fm-muted{fill:var(--fm-muted)}.fm-root .fm-selected{fill:var(--fm-selected)}.fm-root .fm-on-blue{fill:var(--fm-on-blue)}.fm-root [transform-box]{transform-box:fill-box;transform-origin:center}.fm-root text{font-size:11px;fill:var(--fm-navy)}</style><div class='fm-root'><svg viewBox='0 0 320 200' role='img' aria-label='Hover lift and ring'><rect class='fm-surface' width='320' height='200' rx='14'/><rect class='hover-ring' x='72' y='56' width='176' height='88' rx='16' fill='none' stroke='var(--fm-blue)' stroke-width='2' opacity='0'/><g class='hover-card'><rect x='82' y='66' width='156' height='68' rx='12' fill='var(--fm-panel)' stroke='var(--fm-border)'/><circle cx='105' cy='100' r='7' fill='var(--fm-blue)'/><text x='122' y='96' class='fm-ink'>node</text><text x='122' y='112' class='fm-muted'>timed hover study</text></g></svg></div>",
    "duration": 240,
    "easing": "linear",
    "segmentEasing": false,
    "reducedProgress": 1,
