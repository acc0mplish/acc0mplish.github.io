    "effect": "hover",
    "sourceTimeline": {
      "durationMs": 240,
      "description": "Source shows the node ring at .85 opacity on pointer hover without a timed transition. This standalone sample uses a labeled 240 ms timed hover-state reveal.",
      "frames": [
        {
          "atMs": 0,
          "phase": "ring hidden; card at rest"
