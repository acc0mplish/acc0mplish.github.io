        "easing": "linear",
        "keyframes": [
          {
            "offset": 0,
            "transform": "translateY(0px)",
            "easing": "ease-out"
          },
          {
            "offset": 1,
            "transform": "translateY(-4px)",
            "easing": "ease-out"
          }
        ]
      }
    ]
