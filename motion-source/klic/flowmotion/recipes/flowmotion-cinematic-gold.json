  },
  "summary": {
    "ko": "원본 완료 필터를 KLIC 블루 글로우로 바꿔 420ms 동안 표시합니다.",
    "en": "Show the source completion filter as a KLIC blue glow over a finite 420 ms reveal."
  },
  "durationMs": 420,
  "easing": "ease-out",
  "origin": {
    "templateIds": [
