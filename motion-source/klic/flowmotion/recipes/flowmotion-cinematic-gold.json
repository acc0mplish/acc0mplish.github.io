    "sourceFile": "src/components/CinematicNodeConnectCanvas.tsx",
    "renderer": "CinematicNodeConnectCanvas",
    "effect": "gold",
    "sourceTimeline": {
      "durationMs": 420,
      "description": "Source applies a static gold completion drop-shadow after camera return. KLIC changes the success hue to blue and adds a 420 ms reveal for the finite recipe.",
      "frames": [
        {
          "atMs": 0,
          "phase": "completion glow hidden"
        },
        {
          "atMs": 420,
          "phase": "blue success glow visible"
        }
      ]
    }
  },
  "definition": {
    "html": "<style>.fm-root{--fm-blue:var(--klic-semantic-color-accent,#245fc2);--fm-navy:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-component-card-background-default,var(--klic-semantic-color-panel,#fff));--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);--fm-muted:var(--klic-semantic-color-muted,#52657b);--fm-on-blue:var(--klic-semantic-color-on-accent,#fff);--fm-selected:var(--klic-semantic-color-surface-selected,#e4ecfc);box-sizing:border-box;width:100%;height:100%;color:var(--fm-navy);font-family:inherit}.fm-root *{box-sizing:inherit}.fm-root svg{display:block;width:100%;height:100%;overflow:visible;font-family:inherit}.fm-root .fm-surface{fill:var(--fm-surface)}.fm-root .fm-panel{fill:var(--fm-panel);stroke:var(--fm-border)}.fm-root .fm-blue{fill:var(--fm-blue)}.fm-root .fm-blue-stroke{stroke:var(--fm-blue)}.fm-root .fm-ink{fill:var(--fm-navy)}.fm-root .fm-muted{fill:var(--fm-muted)}.fm-root .fm-selected{fill:var(--fm-selected)}.fm-root .fm-on-blue{fill:var(--fm-on-blue)}.fm-root [transform-box]{transform-box:fill-box;transform-origin:center}.fm-root text{font-size:11px;fill:var(--fm-navy)}</style><div class='fm-root'><svg viewBox='0 0 320 200' role='img' aria-label='Completion glow'><defs><filter id='blue-completion-glow'><feDropShadow dx='0' dy='0' stdDeviation='12' flood-color='var(--fm-blue)' flood-opacity='.72'/></filter></defs><rect class='fm-surface' width='320' height='200' rx='14'/><rect x='70' y='58' width='180' height='82' rx='14' fill='var(--fm-panel)' stroke='var(--fm-border)' stroke-width='1.5'/><rect class='completion-halo' x='70' y='58' width='180' height='82' rx='14' fill='none' stroke='var(--fm-blue)' stroke-width='2' filter='url(#blue-completion-glow)' opacity='0'/><path d='M 138 98 l14 14 30-34' fill='none' stroke='var(--fm-blue)' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/><text x='160' y='164' text-anchor='middle' class='fm-muted'>complete</text></svg></div>",
    "duration": 420,
    "easing": "linear",
    "segmentEasing": false,
    "reducedProgress": 1,
    "tracks": [
      {
        "selector": ".completion-halo",
        "easing": "linear",
        "keyframes": [
          {
            "offset": 0,
            "opacity": 0,
            "easing": "ease-out"
          },
          {
            "offset": 1,
            "opacity": 0.82,
            "easing": "ease-out"
          }
        ]
      }
    ]
  }
}
