        {
          "atMs": 350,
          "phase": "scale 1 settled"
        },
        {
          "atMs": 400,
          "phase": "preview hold ends"
        }
      ]
    }
  },
  "definition": {
    "html": "<style>.fm-root{--fm-blue:var(--klic-semantic-color-accent,#245fc2);--fm-navy:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-component-card-background-default,var(--klic-semantic-color-panel,#fff));--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);--fm-muted:var(--klic-semantic-color-muted,#52657b);--fm-on-blue:var(--klic-semantic-color-on-accent,#fff);--fm-selected:var(--klic-semantic-color-surface-selected,#e4ecfc);box-sizing:border-box;width:100%;height:100%;color:var(--fm-navy);font-family:inherit}.fm-root *{box-sizing:inherit}.fm-root svg{display:block;width:100%;height:100%;overflow:visible;font-family:inherit}.fm-root .fm-surface{fill:var(--fm-surface)}.fm-root .fm-panel{fill:var(--fm-panel);stroke:var(--fm-border)}.fm-root .fm-blue{fill:var(--fm-blue)}.fm-root .fm-blue-stroke{stroke:var(--fm-blue)}.fm-root .fm-ink{fill:var(--fm-navy)}.fm-root .fm-muted{fill:var(--fm-muted)}.fm-root .fm-selected{fill:var(--fm-selected)}.fm-root .fm-on-blue{fill:var(--fm-on-blue)}.fm-root [transform-box]{transform-box:fill-box;transform-origin:center}.fm-root text{font-size:11px;fill:var(--fm-navy)}</style><div class='fm-root'><svg viewBox='0 0 320 200' role='img' aria-label='Check pop'><rect class='fm-surface' width='320' height='200' rx='14'/><circle cx='160' cy='94' r='34' fill='var(--fm-selected)'/><path class='check-pop' d='M 145 94 l10 10 22-25' fill='none' stroke='var(--fm-blue)' stroke-width='5' stroke-linecap='round' stroke-linejoin='round' transform-box='fill-box' transform-origin='center'/><text x='160' y='155' text-anchor='middle' class='fm-muted'>check</text></svg></div>",
    "duration": 400,
    "easing": "linear",
    "segmentEasing": false,
    "reducedProgress": 1,
