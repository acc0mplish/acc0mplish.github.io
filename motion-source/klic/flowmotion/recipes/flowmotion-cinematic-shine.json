            "offset": 0,
            "transform": "translateX(0px)",
            "easing": "ease-in-out"
          },
          {
            "offset": 0.55,
            "transform": "translateX(0px)",
            "easing": "ease-in-out"
          },
          {
            "offset": 1,
            "transform": "translateX(520px)",
            "easing": "ease-in-out"
          }
        ]
      }
    ]
  }
