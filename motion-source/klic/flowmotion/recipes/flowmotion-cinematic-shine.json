  "definition": {
    "html": "<style>.fm-root{--fm-blue:var(--klic-semantic-color-accent,#245fc2);--fm-navy:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-component-card-background-default,var(--klic-semantic-color-panel,#fff));--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);--fm-muted:var(--klic-semantic-color-muted,#52657b);--fm-on-blue:var(--klic-semantic-color-on-accent,#fff);--fm-selected:var(--klic-semantic-color-surface-selected,#e4ecfc);box-sizing:border-box;width:100%;height:100%;color:var(--fm-navy);font-family:inherit}.fm-root *{box-sizing:inherit}.fm-root svg{display:block;width:100%;height:100%;overflow:visible;font-family:inherit}.fm-root .fm-surface{fill:var(--fm-surface)}.fm-root .fm-panel{fill:var(--fm-panel);stroke:var(--fm-border)}.fm-root .fm-blue{fill:var(--fm-blue)}.fm-root .fm-blue-stroke{stroke:var(--fm-blue)}.fm-root .fm-ink{fill:var(--fm-navy)}.fm-root .fm-muted{fill:var(--fm-muted)}.fm-root .fm-selected{fill:var(--fm-selected)}.fm-root .fm-on-blue{fill:var(--fm-on-blue)}.fm-root [transform-box]{transform-box:fill-box;transform-origin:center}.fm-root text{font-size:11px;fill:var(--fm-navy)}</style><div class='fm-root'><svg viewBox='0 0 320 200' role='img' aria-label='Card light sweep'><defs><clipPath id='shine-clip'><rect x='40' y='46' width='240' height='108' rx='14'/></clipPath><linearGradient id='shine-gradient'><stop offset='0' stop-color='var(--fm-blue)' stop-opacity='0'/><stop offset='.5' stop-color='var(--fm-blue)' stop-opacity='.24'/><stop offset='1' stop-color='var(--fm-blue)' stop-opacity='0'/></linearGradient></defs><rect class='fm-surface' width='320' height='200' rx='14'/><rect x='40' y='46' width='240' height='108' rx='14' fill='var(--fm-panel)' stroke='var(--fm-border)'/><circle cx='70' cy='82' r='10' fill='var(--fm-selected)'/><path d='M 64 82 h12 M 70 76 v12' stroke='var(--fm-blue)' stroke-width='2'/><path d='M 92 78 h120 M 92 92 h88 M 64 122 h182' stroke='var(--fm-border)' stroke-width='4' stroke-linecap='round'/><g clip-path='url(#shine-clip)'><rect class='shine-band' x='-160' y='48' width='140' height='104' fill='url(#shine-gradient)'/></g></svg></div>",
    "duration": 4500,
    "easing": "linear",
    "segmentEasing": false,
    "reducedProgress": 1,
    "tracks": [
      {
        "selector": ".shine-band",
        "easing": "linear",
        "keyframes": [
