{
  "id": "flowmotion-dash-cycle",
  "category": "svg-path",
  "title": {
    "ko": "대시 링 트레이스",
    "en": "Dashed Ring Trace"
  },
  "summary": {
    "ko": "원본 750ms 점선 오프셋을 링 한 바퀴에 적용합니다.",
    "en": "Applies the source 750ms dash-offset cycle to a ring."
  },
  "durationMs": 750,
  "easing": "linear",
  "origin": {
    "templateIds": [
      "inbound-lead-routing",
      "ppt-flywheel-infographic",
      "creative-lightbulb-brainstorm",
      "creative-semicircle-radial-fan"
    ],
    "sourceFile": "src/components/PptInfographicCanvases.tsx",
    "renderer": "PptFlywheelInfographicCanvas",
    "effect": "flowDashMove-ring-trace",
    "sourceTimeline": {
      "durationMs": 750,
      "description": "animate-flow-dash uses flowDashMove from src/index.css for one finite pass. strokeDashoffset: 24 → 0, linear, 750ms; the original CSS repeats indefinitely.",
      "frames": [
        {
          "progress": 0,
          "strokeDashoffset": 24
        },
        {
          "progress": 0.25,
          "strokeDashoffset": 18
        },
        {
          "progress": 0.5,
          "strokeDashoffset": 12
        },
        {
          "progress": 0.75,
          "strokeDashoffset": 6
        },
        {
          "progress": 1,
          "strokeDashoffset": 0
        }
      ]
    }
  },
  "definition": {
    "html": "<style>\n.fm-root{--fm-accent:var(--klic-semantic-color-accent,#245FC2);--fm-ink:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-semantic-color-panel,#fff);--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);box-sizing:border-box;width:100%;height:100%;padding:10px;border:1px solid var(--fm-border);border-radius:var(--klic-component-card-radius-default,12px);background:var(--fm-surface);color:var(--fm-ink);font:500 12px/1.35 var(--klic-component-text-body-font-family,system-ui);overflow:hidden}\n.fm-root svg{display:block;width:100%;height:100%;overflow:hidden}\n.fm-root text{font-family:var(--klic-component-text-body-font-family,system-ui);fill:var(--fm-ink)}\n.fm-root .label{font-size:11px;font-weight:700}.fm-root .small{font-size:9px;fill:var(--klic-semantic-color-muted,#52657b)}\n.fm-root .node-bg{fill:var(--fm-panel);stroke:var(--fm-border);stroke-width:1.5}.fm-root .flow{fill:none;stroke:var(--fm-border);stroke-width:2}\n.fm-root .accent{fill:var(--fm-accent)}.fm-root .accent-line{fill:none;stroke:var(--fm-accent)}.fm-root .ink-line{fill:none;stroke:var(--fm-ink)}\n.fm-root .packet{fill:var(--fm-accent)}.fm-root .danger{fill:var(--klic-semantic-color-danger,#b13c43)}.fm-root .danger-line{fill:none;stroke:var(--klic-semantic-color-danger,#b13c43)}\n.fm-root .bar{transform-box:fill-box;transform-origin:50% 100%}.fm-root .spin{transform-box:view-box;transform-origin:160px 90px}\n</style><div class=\"fm-root\"><svg viewBox=\"0 0 320 180\" role=\"img\" aria-label=\"원형 점선이 흐르는 효과\"><circle cx=\"160\" cy=\"83\" r=\"48\" class=\"accent-line\" stroke-width=\"10\" stroke-dasharray=\"24 16\"/><text class=\"label\" text-anchor=\"middle\" x=\"160\" y=\"155\">연결 경로</text></svg></div>",
    "duration": 750,
    "easing": "linear",
    "segmentEasing": false,
    "reducedProgress": 1,
    "tracks": [
      {
        "selector": ".accent-line",
        "keyframes": [
          {
            "offset": 0,
            "strokeDashoffset": 24
          },
          {
            "offset": 0.25,
            "strokeDashoffset": 18
          },
          {
            "offset": 0.5,
            "strokeDashoffset": 12
          },
          {
            "offset": 0.75,
            "strokeDashoffset": 6
          },
          {
            "offset": 1,
            "strokeDashoffset": 0
          }
        ],
        "easing": "linear"
      }
    ]
  }
