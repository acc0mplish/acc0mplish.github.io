  "definition": {
    "html": "<style>.fm-root{--fm-blue:var(--klic-semantic-color-accent,#245fc2);--fm-navy:var(--klic-semantic-color-text,#132c46);--fm-panel:var(--klic-component-card-background-default,var(--klic-semantic-color-panel,#fff));--fm-surface:var(--klic-semantic-color-surface,#fbfcfe);--fm-border:var(--klic-semantic-color-border,#dfe5ee);--fm-muted:var(--klic-semantic-color-muted,#52657b);--fm-on-blue:var(--klic-semantic-color-on-accent,#fff);--fm-selected:var(--klic-semantic-color-surface-selected,#e4ecfc);box-sizing:border-box;width:100%;height:100%;color:var(--fm-navy);font-family:inherit}.fm-root *{box-sizing:inherit}.fm-root svg{display:block;width:100%;height:100%;overflow:visible;font-family:inherit}.fm-root .fm-surface{fill:var(--fm-surface)}.fm-root .fm-panel{fill:var(--fm-panel);stroke:var(--fm-border)}.fm-root .fm-blue{fill:var(--fm-blue)}.fm-root .fm-blue-stroke{stroke:var(--fm-blue)}.fm-root .fm-ink{fill:var(--fm-navy)}.fm-root .fm-muted{fill:var(--fm-muted)}.fm-root .fm-selected{fill:var(--fm-selected)}.fm-root .fm-on-blue{fill:var(--fm-on-blue)}.fm-root [transform-box]{transform-box:fill-box;transform-origin:center}.fm-root text{font-size:11px;fill:var(--fm-navy)}.fm-root .fm-type-card{min-height:0;height:100%;display:flex;align-items:center;justify-content:center;gap:16px;padding:20px;background:var(--fm-surface);border:1px solid var(--fm-border);border-radius:12px}.fm-root .fm-type-label{color:var(--fm-muted);font-size:12px}.fm-root .fm-type-value{display:flex;color:var(--fm-blue);font-size:24px;font-weight:650;letter-spacing:.02em}.fm-root .fm-type-value>span{display:inline-block;opacity:0;transform:translateY(4px)}</style><div class='fm-root'><div class='fm-type-card' role='img' aria-label='Ready'><span class='fm-type-label'>status</span><span class='fm-type-value'><span aria-hidden='true' class='glyph-0'>R</span><span aria-hidden='true' class='glyph-1'>e</span><span aria-hidden='true' class='glyph-2'>a</span><span aria-hidden='true' class='glyph-3'>d